<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <h1 style="text-align: center;">Join Boise Gems <%= group %> <%= season %></h1>
        <br>
        <div style="padding: 24px;">

            <% if (contractPdfPath) { %>
                <p>Please read the official contract PDF below before continuing:</p>
                <div style="margin: 16px 0;">
                    <iframe
                    src="<%= contractPdfPath %>"
                    style="width:100%; max-width:900px; height:600px; border:1px solid #ccc; border-radius:6px;"
                    ></iframe>
                </div>
            <% } %>
            <br>
            <div style="text-align: center;">
                   <% if(!bypass) { %>
                  <p>
                    For commitment purposes, we require a $<%= depositLabel %> down payment before signing the contract.
                  </p>
                <% } %>
                <br>
                <a href="/sign-contract/<%= contractExtension.id %>"><button>Make Payment and Sign</button></a>
            </div>
            
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>