<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <div style="padding: 12px;">
            <form action="/add-event" method="POST" enctype="multipart/form-data">
                <label for="title">Title</label>
                <input type="text" name="title" required />
                <br><br>

                <label for="description">Description</label>
                <input type="text" name="description" required />
                <br><br>

                <label for="datetime">Date & Time</label>
                <input type="datetime-local" name="datetime" required />
                <br><br>

                <label for="datetime">End Date & Time (optional)</label>
                <input type="datetime-local" name="endtime" />
                <br><br>

                <label for="location">Location</label>
                <input type="text" name="location" required />
                <br><br>

                <label for="image">Upload Image</label>
                <input type="file" name="image" accept="image/*" />
                <br><br>

                <label for="link">External Link (optional)</label>
                <input type="text" name="link" />
                <br><br>

                <label for="cost">Cost (in dollars)</label>
                <input type="number" name="cost" min="0" step="1" required />
                <br><br>


                <label for="type">Type of Event</label>
                <select name="type" id="type">
                    <option value="camp">Camp</option>
                    <option value="spring training">Spring Training</option>
                    <option value="experience camp">Experience Camp</option>
                    <option value="performance">Performance</option>
                    <option value="fundraiser">Fundraiser</option>
                    <option value="BGI Audition">BGI Audition</option>
                    <option value="BGI Camp">BGI Camp</option>
                    <option value="BGI Performance">BGI Performance</option>
                    <option value="other">Other</option>
                </select>
                <br><br>

                <div style="text-align: center;">
                    <button type="submit">Add Event</button>
                </div>
            </form>

        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>