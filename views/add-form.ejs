<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <h1 style="text-align: center;">Add Form</h1>
        <br>

        <div style="padding: 8px;">
            <form action="/add-form/" method="POST" enctype="multipart/form-data">
            <label for="title">Title</label>
            <input type="text" name="title" value="" required/>
            <br>
            <br>
            <label for="description">Description</label>
            <input type="text" name="description" value="" required/>
            <br>
            <br>
            <label for="document_path">Upload PDF</label>
            <input type="file" name="document_path" value="" accept="application/pdf"/>
            <br>
            <br>
            <div style="align-items: center;">
                <label for="upload">Require user to upload form?</label>
                <input type="checkbox" name="upload"/>
            </div>
            <br>
            <label for="due_date">Due Date</label>
            <input type="date" name="due_date" required/>
            <br>
            <br>
            <label for="expire_date">Expiration Date</label>
            <input type="date" name="expire_date" required/>
            <br>
            <br>
            <label for="content">Form content (optional)</label>
            <textarea name="content" placeholder="Enter form data here"></textarea>
            <br>
            <br>
            <div style="text-align: center;">
                <button>Add</button>
            </div>
        </form>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>