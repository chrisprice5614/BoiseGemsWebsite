<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Form | Boise Gems</title>
  <%- include("includes/head") %>
  <link rel="stylesheet" href="/css/form-wizard.css">
</head>
<body>
<header><%- include("includes/header") %></header>
<main class="form-wizard">
  <h1 style="text-align:center;margin:12px 0 0;">Create a form</h1>
  <p style="text-align:center;color:#6b5585;margin:8px 0 0;">We'll go one step at a time. You can go back anytime.</p>

  <div class="form-wizard__progress" aria-hidden="true">
    <span class="form-wizard__dot is-active"></span>
    <span class="form-wizard__dot"></span>
    <span class="form-wizard__dot"></span>
    <span class="form-wizard__dot"></span>
    <span class="form-wizard__dot"></span>
  </div>

  <form id="addFormWizard" action="/add-form" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="fields_json" id="fieldsJson" value="[]">

    <!-- Step 1: Name -->
    <section class="form-wizard__step is-active" data-step="0">
      <p class="form-wizard__kicker">Step 1 of 5</p>
      <h2 class="form-wizard__title">What is the name of this form?</h2>
      <p class="form-wizard__help">Use a clear name people will recognize, like “Medical Release 2027”.</p>
      <label for="title" class="sr-only">Form name</label>
      <input type="text" id="title" name="title" placeholder="Type the form name here" autocomplete="off" required>
      <div class="form-wizard__actions">
        <button type="button" class="button" data-next>Next</button>
      </div>
    </section>

    <!-- Step 2: Description -->
    <section class="form-wizard__step" data-step="1">
      <p class="form-wizard__kicker">Step 2 of 5</p>
      <h2 class="form-wizard__title">Write a short description</h2>
      <p class="form-wizard__help">One or two sentences explaining what this form is for.</p>
      <label for="description" class="sr-only">Description</label>
      <textarea id="description" name="description" placeholder="Example: Everyone on Corps must sign this before tour." required></textarea>
      <div class="form-wizard__actions">
        <button type="button" class="form-wizard__secondary" data-back>Back</button>
        <button type="button" class="button" data-next>Next</button>
      </div>
    </section>

    <!-- Step 3: PDF + fields -->
    <section class="form-wizard__step" data-step="2">
      <p class="form-wizard__kicker">Step 3 of 5</p>
      <h2 class="form-wizard__title">Upload the PDF and place fill-in boxes</h2>
      <p class="form-wizard__help">
        1) Choose the PDF.<br>
        2) Use the floating buttons (Text, Signature, Date, Initials).<br>
        3) Click on the page where that answer should go.<br>
        Drag a box to move it. Grab any edge to resize. Right-click a box to delete it.
      </p>
      <label for="wizardPdf"><strong>Choose PDF</strong></label>
      <input type="file" id="wizardPdf" name="document_path" accept="application/pdf" required>
      <br><br>
      <div class="fw-pdf-shell">
        <div class="fw-pdf-layout">
          <div class="fw-pdf-pages" id="wizardPdfPages">
            <p style="text-align:center;padding:40px 12px;color:#6b5585;margin:0;">Your PDF will show up here after you choose a file.</p>
          </div>
          <aside class="fw-tools fw-tools--float" id="wizardTools">
            <p class="fw-tools__hint">Choose a field type</p>
            <button type="button" data-field-type="text">Text</button>
            <button type="button" data-field-type="signature">Signature</button>
            <button type="button" data-field-type="date">Date</button>
            <button type="button" data-field-type="initials">Initials</button>
            <button type="button" class="fw-tools__save" data-next>Next</button>
          </aside>
        </div>
      </div>
      <div class="fw-field-list" id="wizardFieldList"></div>
      <div class="form-wizard__actions">
        <button type="button" class="form-wizard__secondary" data-back>Back</button>
        <button type="button" class="button" data-next>Next</button>
      </div>
    </section>

    <!-- Step 4: Audience -->
    <section class="form-wizard__step" data-step="3">
      <p class="form-wizard__kicker">Step 4 of 5</p>
      <h2 class="form-wizard__title">Who needs to sign this?</h2>
      <p class="form-wizard__help">Check every group that should see and sign this form. You can pick more than one.</p>
      <div class="form-wizard__checks">
        <label class="form-wizard__check"><input type="checkbox" name="audience_corps" value="1"> Corps</label>
        <label class="form-wizard__check"><input type="checkbox" name="audience_independent" value="1"> Independent</label>
        <label class="form-wizard__check"><input type="checkbox" name="audience_affiliate" value="1"> Affiliate</label>
        <label class="form-wizard__check"><input type="checkbox" name="audience_staff" value="1"> Staff</label>
      </div>
      <div class="form-wizard__actions">
        <button type="button" class="form-wizard__secondary" data-back>Back</button>
        <button type="button" class="button" data-next>Next</button>
      </div>
    </section>

    <!-- Step 5: Dates + notify -->
    <section class="form-wizard__step" data-step="4">
      <p class="form-wizard__kicker">Step 5 of 5</p>
      <h2 class="form-wizard__title">When is it due, and when does it expire?</h2>
      <p class="form-wizard__help">Due date is when people should finish it. Expiration date is when it stops showing up.</p>
      <label for="due_date"><strong>Due date</strong></label>
      <input type="date" id="due_date" name="due_date" required>
      <br><br>
      <label for="expire_date"><strong>Expiration date</strong></label>
      <input type="date" id="expire_date" name="expire_date" required>
      <br><br>
      <label class="form-wizard__check">
        <input type="checkbox" name="notify" value="1" checked>
        Email members and parents now to tell them they need to sign
      </label>
      <p class="fw-error" id="wizardError" hidden></p>
      <div class="form-wizard__actions">
        <button type="button" class="form-wizard__secondary" data-back>Back</button>
        <button type="submit" class="button">Save form</button>
      </div>
    </section>
  </form>
</main>
<footer><%- include("includes/footer") %></footer>
<script type="module" src="/js/form-wizard.js"></script>
</body>
</html>
