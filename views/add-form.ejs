<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <h1 style="text-align: center;">Add Form</h1>
        <br>

        <div style="padding: 8px;">
            <form action="/add-form/" method="POST" enctype="multipart/form-data">
                <label for="title">Title</label>
                <input type="text" name="title" required>
                <br><br>

                <label for="description">Description</label>
                <input type="text" name="description" required>
                <br><br>

                <label for="document_path">Upload PDF</label>
                <input type="file" name="document_path" accept="application/pdf">
                <br><br>

                <div style="align-items: center;">
                    <label for="upload">Require user to upload form?</label>
                    <input type="checkbox" name="upload">
                </div>
                <br>

                <!-- NEW: Audience / Contracted controls -->
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px; align-items:center;">
                    <div>
                        <label for="ensemble_type">Audience</label>
                        <select name="ensemble_type" id="ensemble_type">
                            <option value="all" selected>All members</option>
                            <option value="corps">Corps (contracted)</option>
                            <option value="independent">Independent (contracted)</option>
                        </select>
                    </div>
                    <div>
                        <label for="contracted">Contracted only?</label>
                        <input type="checkbox" name="contracted" id="contracted">
                        <small style="display:block; opacity:.8;">
                            If you pick “Corps” or “Independent”, this will auto-enable.
                        </small>
                    </div>
                </div>
                <br>

                <label for="due_date">Due Date</label>
                <input type="date" name="due_date" required>
                <br><br>

                <label for="expire_date">Expiration Date</label>
                <input type="date" name="expire_date" required>
                <br><br>

                <label for="content">Form content (optional)</label>
                <textarea name="content" placeholder="Enter form data here"></textarea>
                <br><br>

                <div style="text-align: center;">
                    <button>Add</button>
                </div>
            </form>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>

    <script>
      // Keep contracted checkbox in sync with ensemble_type rule:
      // - corps/independent => contracted MUST be true (forced + disabled)
      // - all => contracted can be toggled freely
      (function(){
        const sel = document.getElementById('ensemble_type');
        const chk = document.getElementById('contracted');
        function sync() {
          const v = (sel.value || '').toLowerCase();
          if (v === 'corps' || v === 'independent') {
            chk.checked = true;
            chk.disabled = true;
          } else {
            chk.disabled = false;
            // leave whatever the admin set for "all"
          }
        }
        sel.addEventListener('change', sync);
        sync();
      })();
    </script>
</body>
</html>
