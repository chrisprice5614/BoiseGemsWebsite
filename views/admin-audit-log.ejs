<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit log - Admin</title>
  <%- include("includes/head") %>
  <style>
    body.roles-admin-page { background: #ebe7f0; }
    body.roles-admin-page main { max-width: none; width: 100%; margin: 0; padding: 0; background: transparent; box-shadow: none; }
    .ra-hero { background: linear-gradient(135deg, #4a3263 0%, #60437D 48%, #7a5a9a 100%); color: #fff; padding: 28px 32px 32px; }
    .ra-hero a { color: rgba(255,255,255,0.85); text-decoration: none; }
    .ra-hero h1 { margin: 10px 0 6px; color: #fff; font-size: 1.85rem; }
    .ra-wrap { width: min(1200px, calc(100% - 48px)); margin: -18px auto 48px; }
    .ra-panel { background: #fff; border: 1px solid rgba(96,67,125,0.12); border-radius: 14px; padding: 22px 24px; box-shadow: 0 8px 24px rgba(40,24,60,0.06); }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; vertical-align: top; color: #1a1228 !important; }
    th { background: #f3eef8 !important; color: #2a1840 !important; font-weight: 700; }
    tbody tr:nth-child(even) td { background: #faf8fc !important; }
    tbody tr:nth-child(odd) td { background: #fff !important; }
    .filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
    .filters input, .filters select { padding: 8px 10px; border: 1px solid #ccc; border-radius: 8px; }
    .meta { color: #666; word-break: break-word; max-width: 320px; }
  </style>
</head>
<body class="roles-admin-page">
<header><%- include("includes/header") %></header>
<main>
  <div class="ra-hero">
    <a href="/admin-portal#system">&larr; System</a>
    <h1>Audit log</h1>
  </div>
  <div class="ra-wrap">
    <form class="filters" method="GET" action="/admin/audit-log">
      <select name="action">
        <option value="">All actions</option>
        <% ["record_view","record_edit","document_download","permission_change","financial_change","contract_change","medical_access","staff_record_access"].forEach(function(a) { %>
          <option value="<%= a %>" <%= action === a ? "selected" : "" %>><%= a %></option>
        <% }) %>
      </select>
      <input type="search" name="q" value="<%= q || '' %>" placeholder="Search email, target, meta...">
      <button type="submit">Filter</button>
    </form>
    <div class="ra-panel">
      <table>
        <thead>
          <tr><th>When</th><th>Actor</th><th>Action</th><th>Target</th><th>Meta</th></tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %><tr><td colspan="5">No entries.</td></tr><% } %>
          <% rows.forEach(function(r) { %>
            <tr>
              <td><%= new Date(r.created_at).toLocaleString() %></td>
              <td><%= r.actor_email || r.actor_id || "-" %></td>
              <td><%= r.action %></td>
              <td><%= r.target_type || "" %> <%= r.target_id || "" %></td>
              <td class="meta"><%= r.meta_json || "" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
