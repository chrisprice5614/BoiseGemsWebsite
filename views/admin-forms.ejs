<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Forms Completion - Boise Gems</title>
  <%- include("includes/head") %>
</head>
<body>
<header><%- include("includes/header") %></header>
<main>
  <div style="margin:12px;">
    <h1>Forms Completion</h1>

    <form method="GET" action="/admin-forms" style="margin-bottom:16px;">
      <label>Membership:
        <select name="membership">
          <option value="all" <%= membership==="all" ? "selected" : "" %>>All</option>
          <option value="corps" <%= membership==="corps" ? "selected" : "" %>>Corps</option>
          <option value="independent" <%= membership==="independent" ? "selected" : "" %>>Independent</option>
          <option value="affiliate" <%= membership==="affiliate" ? "selected" : "" %>>Affiliate</option>
        </select>
      </label>

      <label style="margin-left:12px;">
        Section:
        <input type="text" name="section" value="<%= sectionFilter %>" placeholder="e.g. Trumpet">
      </label>

      <button style="margin-left:12px;">Filter</button>
    </form>

    <% if (!rows.length) { %>
      <p>No users matched that filter.</p>
    <% } else { %>
      <table style="width:100%; border-collapse:collapse;">
        <thead>
        <tr>
          <th style="text-align:left; border-bottom:1px solid #ccc;">Name</th>
          <th style="text-align:left; border-bottom:1px solid #ccc;">Section</th>
          <th style="text-align:left; border-bottom:1px solid #ccc;">Instrument</th>
          <th style="text-align:left; border-bottom:1px solid #ccc;">Membership</th>
          <th style="text-align:left; border-bottom:1px solid #ccc;">Forms submitted</th>
          <th style="text-align:left; border-bottom:1px solid #ccc;">Blank fields</th>
          <th style="text-align:left; border-bottom:1px solid #ccc;"></th>
        </tr>
        </thead>
        <tbody>
        <% rows.forEach(function(r){ 
             const u = r.user;
             const finished = r.requiredCount > 0 && r.missingCount === 0;
             let memberLabel = "None";
             if (u.contractedCorps) memberLabel = "Corps";
               if (u.contractedIndependent) memberLabel = "Independent";
               if (u.contractedAffiliate) memberLabel = "Affiliate";
        %>
          <tr>
            <td><%= u.firstname %> <%= u.lastname %></td>
            <td><%= u.section || "" %></td>
            <td><%= u.instrument || "" %></td>
            <td><%= memberLabel %></td>
            <td>
              <% if (!r.requiredCount) { %>
                n/a
              <% } else if (finished) { %>
                ✅ <%= r.requiredCount %> / <%= r.requiredCount %>
              <% } else { %>
                ❌ <%= r.requiredCount - r.missingCount %> / <%= r.requiredCount %>
              <% } %>
            </td>
            <td>
              <% if (r.blankFieldCount > 0) { %>
                <span style="color:#9b1c1c; font-weight:600;">
                  ⚠ <%= r.blankFieldCount %> blank
                  <span style="font-weight:400; color:#666;">(<%= r.formsWithBlanks %> form<%= r.formsWithBlanks === 1 ? "" : "s" %>)</span>
                </span>
              <% } else if (finished) { %>
                <span style="color:#2f6b3a;">None</span>
              <% } else { %>
                —
              <% } %>
            </td>
            <td>
              <a href="/view-forms/<%= u.id %>"><button type="button">View</button></a>
            </td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
