<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Boise Gems | Instrument History</title>
  <%- include("includes/head") %>
  <style>
    .hist-table { width: 100%; border-collapse: collapse; }
    .hist-table th {
      text-align: left;
      border-bottom: 2px solid #bbb;
      padding: 8px 10px;
      background: #f0f0f0;
    }
    .hist-table td {
      padding: 8px 10px;
      border-bottom: 1px solid #e0e0e0;
      vertical-align: top;
    }
    .hist-table tr:hover td { background: #fafafa; }
    .badge-out  { background:#fff3cd; color:#5a4000; border-radius:4px; padding:2px 8px; font-size:0.85em; white-space:nowrap; }
    .badge-in   { background:#d4edda; color:#155724; border-radius:4px; padding:2px 8px; font-size:0.85em; white-space:nowrap; }
  </style>
</head>
<body>
<header>
  <%- include("includes/header") %>
</header>

<main>
  <div style="padding: 16px;">
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; margin-bottom:8px;">
      <a href="/admin/instrument-checkout">&larr; Instrument Checkout</a>
    </div>
    <h1 style="text-align:center;">📋 Full Instrument Checkout History</h1>
    <br/>

    <!-- Filters -->
    <form method="GET" action="/admin/instrument-history" style="display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; margin-bottom:18px;">
      <div>
        <label for="search" style="display:block; margin-bottom:4px;">Search</label>
        <input type="text" id="search" name="search" value="<%= search %>" placeholder="Name, instrument, or serial…" style="min-width:220px;" />
      </div>
      <div>
        <label for="status" style="display:block; margin-bottom:4px;">Status</label>
        <select name="status" id="status">
          <option value="all"  <%= status === "all"  ? "selected" : "" %>>All</option>
          <option value="out"  <%= status === "out"  ? "selected" : "" %>>Currently Out</option>
          <option value="in"   <%= status === "in"   ? "selected" : "" %>>Returned</option>
        </select>
      </div>
      <div>
        <button type="submit">Filter</button>
        <% if (search || status !== "all") { %>
          <a href="/admin/instrument-history" style="margin-left:8px;">Clear</a>
        <% } %>
      </div>
    </form>

    <p style="color:#666; margin-bottom:12px;"><%= records.length %> record<%= records.length !== 1 ? "s" : "" %> found</p>

    <% if (records.length === 0) { %>
      <p style="text-align:center; color:#888;">No records match your filters.</p>
    <% } else { %>
      <div style="overflow-x:auto;">
        <table class="hist-table">
          <thead>
            <tr>
              <th style="color: #000;">Member</th>
              <th style="color: #000;">Instrument</th>
              <th style="color: #000;">Model</th>
              <th style="color: #000;">Serial</th>
              <th style="color: #000;">Checked Out</th>
              <th style="color: #000;">Checked In</th>
              <th style="color: #000;">Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% records.forEach(function(inst) { %>
              <tr>
                <td>
                  <a href="/instruments/<%= inst.user_id %>">
                    <%= inst.firstname %> <%= inst.lastname %>
                  </a>
                  <% if (inst.section) { %><br/><span style="color:#888; font-size:0.85em;"><%= inst.section %></span><% } %>
                </td>
                <td style="text-transform:capitalize;"><%= inst.instrument_type %></td>
                <td><%= inst.model || "—" %></td>
                <td><%= inst.serial || "—" %></td>
                <td>
                  <%= inst.checked_out_date
                    ? new Date(inst.checked_out_date).toLocaleDateString("en-US", { year:"numeric", month:"short", day:"numeric" })
                    : "—" %>
                </td>
                <td>
                  <% if (inst.checked_in_date) { %>
                    <%= new Date(inst.checked_in_date).toLocaleDateString("en-US", { year:"numeric", month:"short", day:"numeric" }) %>
                  <% } else { %>
                    <span style="color:#888;">—</span>
                  <% } %>
                </td>
                <td>
                  <% if (inst.checked_in_date) { %>
                    <span class="badge-in">Returned</span>
                  <% } else { %>
                    <span class="badge-out">Out</span>
                  <% } %>
                </td>
                <td>
                  <% if (!inst.checked_in_date) { %>
                    <form method="POST" action="/admin/instrument-checkout/checkin/<%= inst.id %>">
                      <button type="submit" style="font-size:0.85em; padding:4px 10px;">Check In</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<footer>
  <%- include("includes/footer") %>
</footer>
</body>
</html>
