<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Join Corps Page - Admin</title>
  <%- include("includes/head") %>
</head>
<body>
<header><%- include("includes/header") %></header>

<main class="portal-main" style="max-width:900px;margin:0 auto;padding:16px;">
  <a href="/admin-portal?section=content" class="staff-admin-back" style="display:inline-block;margin-bottom:12px;">← Admin Portal</a>
  <h1 style="margin:0 0 6px;">Join Corps Audition Page</h1>
  <p style="margin:0 0 20px;color:#6b5585;line-height:1.5;">
    Edit the scroll experience at <a href="/join-corps" target="_blank" rel="noopener">/join-corps</a>.
    What you type below is exactly what visitors see. Use the toolbar for headings, bold, and alignment.
  </p>

  <div class="form-panel">
    <form method="POST" action="/admin/join-corps-settings" id="jcAdminForm" onsubmit="jcSubmit(event)">
      <label class="staff-field" style="display:block;margin-bottom:18px;">
        <span class="staff-field-label">Topographic line opacity</span>
        <input type="number" name="join_corps_topo_opacity"
               min="0" max="1" step="0.01"
               value="<%= topoOpacity %>"
               style="max-width:120px;">
      </label>

      <div class="ann-editor-box">
        <div class="ann-toolbar" role="toolbar" aria-label="Page formatting">
          <button type="button" class="jc-fmt-btn" title="Heading" onclick="jcFmt('heading')"><span style="font-weight:800;">H</span></button>
          <button type="button" class="jc-fmt-btn" title="Subheading" onclick="jcFmt('subheading')"><span style="font-weight:700;font-size:0.78rem;">Sub</span></button>
          <button type="button" class="jc-fmt-btn" title="Bold" onclick="jcFmt('bold')"><strong>B</strong></button>
          <span class="ann-toolbar-sep" aria-hidden="true"></span>
          <button type="button" class="jc-fmt-btn" title="Align left" onclick="jcFmt('alignLeft')">
            <svg class="jc-align-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M4 12h10M4 19h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          </button>
          <button type="button" class="jc-fmt-btn" title="Align center" onclick="jcFmt('alignCenter')">
            <svg class="jc-align-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M7 12h10M5 19h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          </button>
          <button type="button" class="jc-fmt-btn" title="Align right" onclick="jcFmt('alignRight')">
            <svg class="jc-align-svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M10 12h10M6 19h14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          </button>
          <span class="ann-toolbar-sep" aria-hidden="true"></span>
          <button type="button" class="jc-fmt-btn jc-fmt-btn--wide" title="Insert image" onclick="document.getElementById('jcImgInput').click()">Image</button>
          <input type="file" id="jcImgInput" accept="image/*" hidden onchange="jcImageSelected(this)">
        </div>
        <div id="jcEditor" class="jc-wysiwyg" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Write the audition page content here…"><%- bodyHtml %></div>
      </div>

      <input type="hidden" id="jcHtmlField" name="join_corps_body_html" value="">

      <div style="margin-top:18px;display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
        <button type="submit">Save Page</button>
        <a href="/join-corps" target="_blank" rel="noopener" class="pd-action-btn">Open live page</a>
      </div>
    </form>
  </div>
</main>

<footer><%- include("includes/footer") %></footer>

<style>
  .jc-fmt-btn {
    --bevel: 8px;
    padding: 6px 11px !important;
    min-width: 36px;
    font-size: 0.85rem !important;
    text-transform: none !important;
    letter-spacing: 0 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff !important;
  }
  .jc-fmt-btn strong,
  .jc-fmt-btn span {
    color: #fff !important;
  }
  .jc-align-svg {
    display: block;
    width: 20px;
    height: 20px;
    color: #fff;
    pointer-events: none;
  }
  .jc-fmt-btn--wide {
    min-width: auto;
    padding: 6px 14px !important;
    font-weight: 700 !important;
  }
  #jcImgInput { display: none !important; }
  .jc-wysiwyg img.jc-embed-img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1em auto;
    --bevel: 12px;
    clip-path: polygon(
      var(--bevel) 0,
      100% 0,
      100% calc(100% - var(--bevel)),
      calc(100% - var(--bevel)) 100%,
      0 100%,
      0 var(--bevel)
    );
  }
  .jc-wysiwyg {
    min-height: 420px;
    max-height: 70vh;
    overflow-y: auto;
    padding: 18px 20px;
    font-size: 1rem;
    line-height: 1.7;
    color: #2a1f38;
    outline: none;
    background: #fff;
  }
  .jc-wysiwyg:empty::before {
    content: attr(data-placeholder);
    color: #a898bc;
    pointer-events: none;
  }
  .jc-wysiwyg h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--secondary-color);
    margin: 0.8em 0 0.35em;
    line-height: 1.25;
  }
  .jc-wysiwyg h2:first-child { margin-top: 0; }
  .jc-wysiwyg h3 {
    font-size: 1.12rem;
    font-weight: 700;
    color: #4a3767;
    margin: 0.7em 0 0.3em;
  }
  .jc-wysiwyg p { margin: 0 0 0.85em; }
  .jc-wysiwyg p:last-child { margin-bottom: 0; }
  .jc-wysiwyg ul, .jc-wysiwyg ol { margin: 0.5em 0 1em 1.4em; padding: 0; }
  .jc-wysiwyg strong, .jc-wysiwyg b { font-weight: 700; }
</style>

<script>
function jcFmt(cmd) {
  var editor = document.getElementById('jcEditor');
  if (!editor) return;
  editor.focus();
  if (cmd === 'heading') document.execCommand('formatBlock', false, 'h2');
  else if (cmd === 'subheading') document.execCommand('formatBlock', false, 'h3');
  else if (cmd === 'bold') document.execCommand('bold', false, null);
  else if (cmd === 'alignLeft') document.execCommand('justifyLeft', false, null);
  else if (cmd === 'alignCenter') document.execCommand('justifyCenter', false, null);
  else if (cmd === 'alignRight') document.execCommand('justifyRight', false, null);
}

function jcSubmit(e) {
  var editor = document.getElementById('jcEditor');
  var text = (editor.textContent || '').replace(/\u00a0/g, ' ').trim();
  if (!text) {
    e.preventDefault();
    if (window.bgAlert) bgAlert('Please add some content for the page.', function () { editor.focus(); });
    return;
  }
  document.getElementById('jcHtmlField').value = editor.innerHTML;
}

function jcImageSelected(input) {
  var file = input.files && input.files[0];
  if (!file) return;
  var editor = document.getElementById('jcEditor');
  var fd = new FormData();
  fd.append('image', file);
  fetch('/admin/join-corps/upload-image', { method: 'POST', body: fd })
    .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
    .then(function (data) {
      if (!data || !data.ok) {
        if (window.bgAlert) bgAlert((data && data.message) || 'Image upload failed.');
        return;
      }
      editor.focus();
      var html = '<p><img src="' + data.url + '" alt="" class="jc-embed-img"></p>';
      document.execCommand('insertHTML', false, html);
    })
    .catch(function () {
      if (window.bgAlert) bgAlert('Image upload failed.');
    });
  input.value = '';
}

(function () {
  var editor = document.getElementById('jcEditor');
  if (!editor) return;
  editor.addEventListener('paste', function (e) {
    e.preventDefault();
    var text = (e.clipboardData || window.clipboardData).getData('text/plain');
    document.execCommand('insertText', false, text);
  });
})();
</script>
</body>
</html>
