<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login history - Admin</title>
  <%- include("includes/head") %>
  <style>
    body.roles-admin-page { background: #ebe7f0; }
    body.roles-admin-page main { max-width: none; width: 100%; margin: 0; padding: 0; background: transparent; box-shadow: none; }
    .ra-hero { background: linear-gradient(135deg, #4a3263 0%, #60437D 48%, #7a5a9a 100%); color: #fff; padding: 28px 32px 32px; }
    .ra-hero a { color: rgba(255,255,255,0.85); text-decoration: none; }
    .ra-hero h1 { margin: 10px 0 6px; color: #fff; font-size: 1.85rem; }
    .ra-wrap { width: min(1100px, calc(100% - 48px)); margin: -18px auto 48px; }
    .ra-panel { background: #fff; border: 1px solid rgba(96,67,125,0.12); border-radius: 14px; padding: 22px 24px; box-shadow: 0 8px 24px rgba(40,24,60,0.06); }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; color: #1a1228 !important; }
    th { background: #f3eef8 !important; color: #2a1840 !important; font-weight: 700; }
    tbody tr:nth-child(even) td { background: #faf8fc !important; }
    tbody tr:nth-child(odd) td { background: #fff !important; }
    .ok { color: #1b5e20; font-weight: 600; }
    .fail { color: #b71c1c; font-weight: 600; }
    .filters { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; align-items: center; }
    .filters input { padding: 8px 10px; border: 1px solid #ccc; border-radius: 8px; }
  </style>
</head>
<body class="roles-admin-page">
<header><%- include("includes/header") %></header>
<main>
  <div class="ra-hero">
    <a href="/admin-portal#system">&larr; System</a>
    <h1>Login history</h1>
  </div>
  <div class="ra-wrap">
    <form class="filters" method="GET" action="/admin/login-history">
      <input type="search" name="q" value="<%= q || '' %>" placeholder="Email or IP...">
      <label style="display:flex;gap:6px;align-items:center;font-weight:500;">
        <input type="checkbox" name="fail" value="1" <%= onlyFail ? "checked" : "" %>> Failures only
      </label>
      <button type="submit">Filter</button>
    </form>
    <div class="ra-panel">
      <table>
        <thead>
          <tr><th>When</th><th>Email</th><th>Result</th><th>IP</th><th>User agent</th></tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %><tr><td colspan="5">No entries.</td></tr><% } %>
          <% rows.forEach(function(r) { %>
            <tr>
              <td><%= new Date(r.created_at).toLocaleString() %></td>
              <td><%= r.email || "-" %></td>
              <td class="<%= r.success ? 'ok' : 'fail' %>"><%= r.success ? "Success" : "Failed" %></td>
              <td><%= r.ip || "-" %></td>
              <td style="max-width:280px;word-break:break-word;color:#666;"><%= r.user_agent || "" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
