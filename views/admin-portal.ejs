  </main>
</div>

<footer><%- include("includes/footer") %></footer>

<!-- Image viewer modal (shared with ann-feed) -->
<div id="annImgModalOverlay" class="ann-modal-overlay" onclick="this.hidden=true" hidden>
  <div class="ann-modal-box" onclick="event.stopPropagation()">
    <button class="ann-modal-close" onclick="document.getElementById('annImgModalOverlay').hidden=true">&times;</button>
    <img id="annImgModalImg" src="" alt="Announcement image">
  </div>
</div>

<script src="/js/portal-nav.js"></script>
<script>
/* ── Announcement compose ── */
var _annEditingId = null;

function annResetCompose() {
  _annEditingId = null;
  _annPendingFilenames = [];
  document.getElementById('annForm').action = '/admin/announcements';
  document.getElementById('annSubmitBtn').innerHTML = '<ion-icon name="send"></ion-icon> Post Announcement';
  document.getElementById('annComposeTitle').textContent = 'Write Announcement';
  document.getElementById('annEditor').innerHTML = '';
  document.getElementById('annImgList').innerHTML = '';
  document.getElementById('annImagesField').value = '[]';
  document.querySelectorAll('.ann-audience input[type="checkbox"]').forEach(function(cb) { cb.checked = false; });
}

function annToggleCompose() {
  var el = document.getElementById('annCompose');
  if (!el.hidden) {
    el.hidden = true;
    annResetCompose();
    return;
  }
  annResetCompose();
  el.hidden = false;
  var editor = document.getElementById('annEditor');
  if (editor) editor.focus();
}

function annStartEdit(id) {
  var dataEl = document.getElementById('ann-data-' + id);
  if (!dataEl) return;
  var data = JSON.parse(dataEl.textContent);
  _annEditingId = id;
  _annPendingFilenames = data.images.slice();
  document.getElementById('annForm').action = '/admin/announcements/' + id + '/edit';
  document.getElementById('annSubmitBtn').innerHTML = '<ion-icon name="save"></ion-icon> Save Changes';
  document.getElementById('annComposeTitle').textContent = 'Edit Announcement';
  document.getElementById('annEditor').innerHTML = data.body_html;
  document.getElementById('annImagesField').value = JSON.stringify(_annPendingFilenames);
  document.querySelector('[name="aud_parents"]').checked = !!data.aud_parents;
  document.querySelector('[name="aud_fans"]').checked = !!data.aud_fans;
  document.querySelector('[name="aud_corps"]').checked = !!data.aud_corps;
  document.querySelector('[name="aud_independent"]').checked = !!data.aud_independent;
  document.querySelector('[name="aud_uncontracted"]').checked = !!data.aud_uncontracted;
  annRenderPendingImages();
  var el = document.getElementById('annCompose');
  el.hidden = false;
  el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  document.getElementById('annEditor').focus();
}

function annFmt(cmd) {
  var editor = document.getElementById('annEditor');
  editor.focus();
  if (cmd === 'heading') {
    document.execCommand('formatBlock', false, 'h2');
  } else {
    document.execCommand(cmd, false, null);
  }
}

var _annPendingFilenames = [];

function annSyncImagesField() {
  document.getElementById('annImagesField').value = JSON.stringify(_annPendingFilenames);
}

function annRemovePendingImage(filename) {
  _annPendingFilenames = _annPendingFilenames.filter(function(f) { return f !== filename; });
  annSyncImagesField();
  annRenderPendingImages();
}

function annRenderPendingImages() {
  var list = document.getElementById('annImgList');
  list.innerHTML = '';
  _annPendingFilenames.forEach(function(filename) {
    var wrap = document.createElement('div');
    wrap.className = 'ann-pending-wrap';
    var thumb = document.createElement('img');
    thumb.src = '/img/publicupload/' + filename;
    thumb.className = 'ann-pending-thumb';
    thumb.alt = 'Attached image';
    var removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'ann-pending-remove';
    removeBtn.title = 'Remove image';
    removeBtn.innerHTML = '&times;';
    removeBtn.onclick = function() { annRemovePendingImage(filename); };
    wrap.appendChild(thumb);
    wrap.appendChild(removeBtn);
    list.appendChild(wrap);
  });
}

function annImagesSelected(input) {
  if (!input.files || !input.files.length) return;
  Array.from(input.files).forEach(function(file) {
    var fd = new FormData();
    fd.append('image', file);
    fetch('/admin/announcements/upload-image', { method: 'POST', body: fd })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (!data.ok) { bgAlert('Image upload failed.'); return; }
        _annPendingFilenames.push(data.filename);
        annSyncImagesField();
        annRenderPendingImages();
      });
  });
  input.value = '';
}

function annEditorEmpty(editor) {
  var text = (editor.textContent || '').replace(/\u00a0/g, ' ').trim();
  return !text;
}

function annSubmit(e) {
  e.preventDefault();
  var editor = document.getElementById('annEditor');
  if (annEditorEmpty(editor)) {
    bgAlert('Please write some text for the announcement.', function(){ editor.focus(); });
    return;
  }
  document.getElementById('annHtmlField').value = editor.innerHTML;
  document.getElementById('annMdField').value = editor.innerText.trim();
  e.target.submit();
}

/* Keep editor clean on paste - plain text only, browser applies formatting via toolbar */
(function() {
  var editor = document.getElementById('annEditor');
  if (!editor) return;
  editor.addEventListener('paste', function(e) {
    e.preventDefault();
    var text = (e.clipboardData || window.clipboardData).getData('text/plain');
    document.execCommand('insertText', false, text);
  });
})();

/* ── Image modal ── */
function annImgModal(src) {
  document.getElementById('annImgModalImg').src = src;
  document.getElementById('annImgModalOverlay').hidden = false;
}

(function() {
  var typeEl = document.getElementById('storePromoType');
  var valueWrap = document.getElementById('storePromoValueWrap');
  if (!typeEl || !valueWrap) return;
  function syncPromoValue() {
    valueWrap.style.display = typeEl.value === 'free_shipping' ? 'none' : '';
  }
  typeEl.addEventListener('change', syncPromoValue);
  syncPromoValue();
})();

/* ── Our History editor ── */
function ohFmt(cmd) {
  var editor = document.getElementById('ohEditor');
  if (!editor) return;
  editor.focus();
  if (cmd === 'heading') document.execCommand('formatBlock', false, 'h2');
  else document.execCommand(cmd, false, null);
}

function ohSubmit(e) {
  var editor = document.getElementById('ohEditor');
  var text = (editor.textContent || '').replace(/\u00a0/g, ' ').trim();
  if (!text) {
    e.preventDefault();
    if (window.bgAlert) bgAlert('Please add some content for Our History.', function () { editor.focus(); });
    return;
  }
  document.getElementById('ohHtmlField').value = editor.innerHTML;
}

(function () {
  var editor = document.getElementById('ohEditor');
  if (!editor) return;
  editor.addEventListener('paste', function (e) {
    e.preventDefault();
    var text = (e.clipboardData || window.clipboardData).getData('text/plain');
    document.execCommand('insertText', false, text);
  });
})();
</script>
</body>
</html>
