          <% } %>
        </div>

        <div class="form-panel" style="max-width:560px;margin-top:24px;">
          <form method="POST" action="/admin/system-settings">
            <div class="pd-sub-heading" style="margin-top:0;">Messaging</div>
            <label style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;line-height:1.5;">
              <input type="checkbox" name="messaging_all_users" value="1" <%= (!siteSettings || siteSettings.messaging_all_users) ? 'checked' : '' %> style="margin-top:4px;">
              <span>Allow all logged-in users to use messaging</span>
            </label>
            <p style="margin:10px 0 18px;color:#6b5585;font-size:0.9rem;line-height:1.5;">
              When off, only administrators and staff can open the messenger. Other users will not see the chat button.
            </p>
            <button type="submit">Save Settings</button>
          </form>
        </div>

        <div class="form-panel" style="max-width:720px;margin-top:28px;">
          <div class="pd-sub-heading" style="margin-top:0;">Our History page</div>
          <p style="margin:0 0 16px;color:#6b5585;font-size:0.9rem;line-height:1.5;">
            Edit the history section on <a href="/our-history-about" target="_blank" rel="noopener">Our History</a>.
            Use the toolbar for headings, bold, italic, and underline.
          </p>
          <form method="POST" action="/admin/our-history-settings" id="ohAdminForm" onsubmit="ohSubmit(event)">
            <div class="ann-editor-box">
              <div class="ann-toolbar" role="toolbar" aria-label="Our History formatting">
                <button type="button" class="ann-fmt-btn" title="Heading" onclick="ohFmt('heading')"><span class="ann-fmt-h">H</span></button>
                <button type="button" class="ann-fmt-btn" title="Bold" onclick="ohFmt('bold')"><strong>B</strong></button>
                <button type="button" class="ann-fmt-btn" title="Italic" onclick="ohFmt('italic')"><em>I</em></button>
                <button type="button" class="ann-fmt-btn" title="Underline" onclick="ohFmt('underline')"><span class="ann-fmt-u">U</span></button>
              </div>
              <div id="ohEditor" class="ann-wysiwyg oh-wysiwyg" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Write the Our History section here…"><%- ourHistoryHtml %></div>
            </div>
            <input type="hidden" id="ohHtmlField" name="our_history_body_html" value="">
            <button type="submit" style="margin-top:16px;">Save Our History</button>
          </form>
        </div>
      </div>
    </div>

    <!-- ══ MY INFO ════════════════════════════════════════ -->
    <div class="pd-section" id="pd-sec-myinfo">
      <div class="pd-section-inner">
        <div class="pd-section-heading">My Info</div>
        <div class="pd-section-sub">Your account details.</div>

        <!-- Hero -->
        <div class="pd-hero">
          <a href="/update-profile-photo" style="border:none;background:none;padding:0;display:block;flex:0 0 auto;">
            <img class="pd-hero-avatar" src="<%= srcImage %>" alt="Profile photo">
          </a>
