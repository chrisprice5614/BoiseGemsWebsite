<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>Stripe Reconcile - Boise Gems</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <%- include("includes/head") %>
  <style>
    .sr-wrap { max-width: 1100px; margin: 16px auto; padding: 16px; }
    .sr-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; margin: 16px 0 24px; }
    .sr-card { border: 1px solid #ddd; border-radius: 8px; padding: 12px; background: #fafafa; }
    .sr-card strong { display: block; font-size: 1.25rem; margin-top: 4px; }
    .sr-warn { background: #fff3cd; border-color: #ffc107; }
    .sr-bad { background: #fce8e6; border-color: #d93025; }
    .sr-ok { background: #e6f4ea; border-color: #34a853; }
    .sr-info { background: #e8f0fe; border-color: #4285f4; }
    .sr-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    .sr-table th, .sr-table td { border-bottom: 1px solid #eee; padding: 8px 6px; text-align: left; vertical-align: top; }
    .sr-table th { border-bottom: 1px solid #ccc; }
    .sr-muted { color: #666; font-size: 0.85em; }
    .sr-section { margin: 28px 0; }
    .sr-filters { display: flex; flex-wrap: wrap; gap: 10px; align-items: end; margin: 16px 0; }
    .sr-filters label { display: flex; flex-direction: column; gap: 4px; font-size: 0.9rem; }
    .sr-filters input { padding: 8px; border-radius: 6px; border: 1px solid #ccc; }
    .sr-pay {
      border: 1px solid #d93025;
      border-radius: 10px;
      padding: 14px;
      margin: 14px 0;
      background: #fff8f7;
    }
    .sr-pay--ok {
      border-color: #34a853;
      background: #e6f4ea;
    }
    .sr-pay h3 { margin: 0 0 8px; }
    .sr-actions label { display: block; margin: 6px 0; }
    .sr-actions select, .sr-actions input[type="text"], .sr-actions input[type="number"] {
      padding: 6px 8px; border-radius: 6px; border: 1px solid #ccc; min-width: 220px;
    }
    .sr-flash { padding: 10px 12px; border-radius: 8px; background: #e6f4ea; border: 1px solid #34a853; margin: 12px 0; }
  </style>
</head>
<body>
<header>
  <%- include("includes/header") %>
</header>

<main>
  <div class="sr-wrap">
    <p style="margin:0 0 8px;"><a href="/admin-portal#pd-sec-system">&larr; Admin Portal</a></p>
    <h1>Stripe vs Website Reconcile</h1>

    <div class="sr-card sr-info" style="margin:12px 0;">
      <strong style="font-size:1rem;">Did the money go through?</strong>
      <p style="margin:8px 0 0;">
        Yes. Rows on this page come from <code>succeeded</code> Stripe PaymentIntents / paid Checkout Sessions.
        A <code>payment_intent</code> id (starts with <code>pi_</code>) with succeeded status means Stripe successfully charged the card.
        The usual failure was our site only recording the payment when the browser hit the success URL — if that page never loaded, Stripe kept the money and the website never wrote the balance/unlock.
      </p>
    </div>

    <% if (typeof flashMessage !== "undefined" && flashMessage) { %>
      <div class="sr-flash"><%= flashMessage %></div>
    <% } %>

    <form method="GET" action="/admin/stripe-reconcile" class="sr-filters">
      <label>
        Start
        <input type="date" name="start" value="<%= start %>" required />
      </label>
      <label>
        End
        <input type="date" name="end" value="<%= end %>" required />
      </label>
      <button type="submit">Compare</button>
    </form>

    <% if (error) { %>
      <div class="sr-card sr-bad">
        <div>Could not load Stripe comparison</div>
        <strong style="font-size:1rem;"><%= error %></strong>
      </div>
    <% } else if (report) { %>
      <% const t = report.totals; %>
      <% const money = (c) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format((c || 0) / 100); %>
      <% const when = (ms) => ms ? new Date(ms).toLocaleString() : '-'; %>
      <% const seasonYear = typeof currentSeasonYear !== 'undefined' ? currentSeasonYear : new Date().getFullYear(); %>

      <div class="sr-summary">
        <div class="sr-card">
          From boisegems.org
          <strong><%= report.stripeCount %></strong>
          <span class="sr-muted"><%= money(t.stripeCents) %></span>
        </div>
        <div class="sr-card">
          Website Stripe records
          <strong><%= report.localCount %></strong>
          <span class="sr-muted"><%= money(t.localCents) %></span>
        </div>
        <div class="sr-card sr-ok">
          Reconciled
          <strong><%= report.matched.length %></strong>
          <span class="sr-muted"><%= money(t.matchedStripeCents) %></span>
        </div>
        <div class="sr-card <%= report.stripeOnly.length ? 'sr-bad' : 'sr-ok' %>">
          Needs action
          <strong><%= report.stripeOnly.length + ((report.pendingChrisOnly && report.pendingChrisOnly.length) || 0) %></strong>
          <span class="sr-muted"><%= money(t.stripeOnlyCents) %></span>
        </div>
        <div class="sr-card <%= report.siteOnly.length ? 'sr-warn' : 'sr-ok' %>">
          On site, not in Stripe
          <strong><%= report.siteOnly.length %></strong>
          <span class="sr-muted"><%= money(t.siteOnlyCents) %></span>
        </div>
        <div class="sr-card sr-info">
          Ignored (not this site)
          <strong><%= (report.excludedOffsiteStripe && report.excludedOffsiteStripe.length) || 0 %></strong>
          <span class="sr-muted"><%= money(t.excludedOffsiteCents) %></span>
        </div>
      </div>

      <p class="sr-muted" style="margin:0 0 16px;">
        Only Stripe checkouts with success/cancel URLs on <code>boisegems.org</code> (or store PaymentIntents with site <code>potential_order_id</code>) are reconciled.
        Jackets / Payment Links / Dashboard charges are listed under “Ignored” and never auto-applied to balances.
      </p>

      <% const eventOptions = typeof eventsForSelect !== 'undefined' && eventsForSelect ? eventsForSelect : []; %>
      <% const pendingChrisOnly = report.pendingChrisOnly || []; %>
      <% const actionQueue = (report.stripeOnly || []).concat(pendingChrisOnly); %>

      <div class="sr-section" id="stripe-only">
        <h2>Needs your decision (<%= actionQueue.length %>)</h2>
        <% if (!actionQueue.length) { %>
          <p>None — everything in range is reconciled (or denied).</p>
        <% } else { %>
          <% actionQueue.forEach(function(s, idx) {
            const suggested = s.suggestedAction || 'donation';
            const defaultUserId = (s.matchedUser && !s.matchedUser.isParent)
              ? s.matchedUser.id
              : (s.children && s.children[0] ? s.children[0].id : (s.matchedUser ? s.matchedUser.id : ''));
            const defaultParentId = (s.matchedUser && s.matchedUser.isParent) ? s.matchedUser.id : '';
            const defaultUserName = (function() {
              if (s.matchedUser && String(s.matchedUser.id) === String(defaultUserId)) return s.matchedUser.name;
              if (s.children) {
                for (var i = 0; i < s.children.length; i++) {
                  if (String(s.children[i].id) === String(defaultUserId)) {
                    return (s.children[i].firstname || '') + ' ' + (s.children[i].lastname || '');
                  }
                }
              }
              return '';
            })();
            const parentName = s.matchedUser && s.matchedUser.isParent ? s.matchedUser.name : '';
            const hideUser = suggested === 'donation' || suggested === 'merch';
            const needsAccount = !!s.needsAccountAction;
            const needsChris = !!s.needsChrisAction;
            const cardClass = (!needsAccount && !needsChris) ? 'sr-pay sr-pay--ok' : 'sr-pay';
          %>
            <div class="<%= cardClass %>" id="pay-<%= idx %>">
              <h3><%= money(s.amount) %> · <%= when(s.created) %></h3>
              <p style="margin:4px 0;">
                <strong>Email:</strong> <%= s.email || '(none on Stripe)' %>
                <% if (s.matchedUser) { %>
                  · matched
                  <strong>#<%= s.matchedUser.id %> <%= s.matchedUser.name %></strong>
                  (<%= s.matchedUser.isParent ? 'PARENT' : 'member' %>,
                  owed <%= money(s.matchedUser.owed) %>)
                  <% if (s.matchedUser.isParent) { %>
                    <span style="color:#a50e0e;"> — credit a linked child, not the parent</span>
                  <% } %>
                <% } else { %>
                  · <span style="color:#a50e0e;">no matching site user by email</span>
                <% } %>
              </p>
              <p class="sr-muted" style="margin:4px 0;">
                Stripe id <code><%= s.id %></code>
                <% if (s.sessionId) { %> · session <code><%= s.sessionId %></code><% } %>
                · guessed: <strong><%= s.guessedKind || 'unknown' %></strong>
              </p>
              <% if (s.description) { %><p style="margin:4px 0;"><%= s.description %></p><% } %>
              <% if (s.lineItems && s.lineItems.length) { %>
                <ul style="margin:6px 0 6px 1.2em;">
                  <% s.lineItems.forEach(function(li) { %>
                    <li><%= li.name %> — <%= money(li.amount) %></li>
                  <% }) %>
                </ul>
              <% } %>
              <% if (s.matchedEvent) { %>
                <p class="sr-ok sr-card" style="display:inline-block;">
                  Matched event: <strong>#<%= s.matchedEvent.id %> <%= s.matchedEvent.title %></strong>
                </p>
              <% } %>
              <% if (s.children && s.children.length) { %>
                <p><strong>Linked children:</strong>
                  <% s.children.forEach(function(c) { %>
                    #<%= c.id %> <%= c.firstname %> <%= c.lastname %> (owed <%= money(c.owed) %>)<%= c !== s.children[s.children.length-1] ? '; ' : '' %>
                  <% }) %>
                </p>
              <% } %>

              <p style="margin:10px 0 4px;">
                <strong>Account / payment history:</strong>
                <% if (!needsAccount) { %>
                  <span style="color:#1e6e2e;">recorded / resolved</span>
                <% } else { %>
                  <span style="color:#a50e0e;">NOT on a user account yet</span>
                <% } %>
                &nbsp;·&nbsp;
                <strong>Chris Payment 3%:</strong>
                <% if (s.chrisShareApplied) { %>
                  <span style="color:#1e6e2e;">already on Chris Payment (<%= money(s.chrisShareCents) %><% if (s.chrisShareMatchedAt) { %>, matched by time<% } %>)</span>
                <% } else if (!needsChris) { %>
                  <span style="color:#1e6e2e;">resolved</span>
                <% } else { %>
                  <span style="color:#a50e0e;">no Chris credit within 1 min of this payment time</span>
                <% } %>
              </p>

              <% if (needsAccount) { %>
                <form method="POST" action="/admin/stripe-reconcile/apply" class="sr-actions"
                      style="border-top:1px solid #eee; padding-top:10px; margin-top:10px;">
                  <input type="hidden" name="start" value="<%= start %>" />
                  <input type="hidden" name="end" value="<%= end %>" />
                  <input type="hidden" name="scope" value="account" />
                  <input type="hidden" name="stripe_id" value="<%= s.id || '' %>" />
                  <input type="hidden" name="payment_intent_id" value="<%= String(s.id || '').indexOf('pi_') === 0 ? s.id : '' %>" />
                  <input type="hidden" name="session_id" value="<%= s.sessionId || '' %>" />
                  <input type="hidden" name="paid_at" value="<%= s.created || '' %>" />
                  <input type="hidden" name="stripe_amount_cents" value="<%= s.amount || 0 %>" />
                  <input type="hidden" name="email" value="<%= s.email || '' %>" />
                  <input type="hidden" name="name" value="<%= s.matchedUser ? s.matchedUser.name : (s.email || '') %>" />
                  <input type="hidden" name="potential_id" value="<%= (s.leftoverPotential && s.leftoverPotential.id) || (s.leftoverVideo && s.leftoverVideo.id) || (s.leftoverMerch && s.leftoverMerch.id) || (s.leftoverEventRsvp && s.leftoverEventRsvp.id) || s.guessedPotentialId || '' %>" />
                  <input type="hidden" name="chris_base_cents" value="<%= s.chrisBaseCents || 0 %>" />

                  <p><strong>1) Put this on a user account / payment history?</strong></p>
                  <label>
                    Payment type
                    <select name="action" required onchange="srToggle(this)">
                      <option value="pay_behalf" <%= suggested === 'pay_behalf' ? 'selected' : '' %>>Parent payment for a child</option>
                      <option value="tuition" <%= suggested === 'tuition' ? 'selected' : '' %>>Performer tuition / balance payment</option>
                      <option value="event_rsvp" <%= suggested === 'event_rsvp' ? 'selected' : '' %>>Event / camp RSVP</option>
                      <option value="donation" <%= suggested === 'donation' ? 'selected' : '' %>>Donation (no member balance)</option>
                      <option value="video_audition" <%= suggested === 'video_audition' ? 'selected' : '' %>>Video audition unlock</option>
                      <option value="merch" <%= suggested === 'merch' ? 'selected' : '' %>>Store order</option>
                      <option value="contract" <%= suggested === 'contract' ? 'selected' : '' %>>Contract down payment</option>
                    </select>
                  </label>

                  <div class="sr-field-user" style="<%= hideUser ? 'display:none;' : '' %>">
                    <label>
                      Member / child to credit (name shown)
                      <% if ((s.matchedUser && !s.matchedUser.isParent) || (s.children && s.children.length)) { %>
                        <select name="user_id_pick" onchange="if (this.value) this.form.user_id.value=this.value;">
                          <option value="">— pick —</option>
                          <% if (s.matchedUser && !s.matchedUser.isParent) { %>
                            <option value="<%= s.matchedUser.id %>" <%= String(defaultUserId) === String(s.matchedUser.id) ? 'selected' : '' %>>
                              #<%= s.matchedUser.id %> <%= s.matchedUser.name %>
                            </option>
                          <% } %>
                          <% if (s.children && s.children.length) { %>
                            <% s.children.forEach(function(c) { %>
                              <option value="<%= c.id %>" <%= String(defaultUserId) === String(c.id) ? 'selected' : '' %>>
                                #<%= c.id %> <%= c.firstname %> <%= c.lastname %> (<%= money(c.owed) %> owed)
                              </option>
                            <% }) %>
                          <% } %>
                        </select>
                      <% } %>
                      <input type="number" name="user_id" value="<%= defaultUserId %>" placeholder="user id" style="margin-top:6px;" />
                      <% if (defaultUserId && defaultUserName) { %>
                        <span class="sr-muted">Selected: #<%= defaultUserId %> <%= defaultUserName %></span>
                      <% } %>
                    </label>
                  </div>

                  <div class="sr-field-parent" style="<%= suggested === 'pay_behalf' ? '' : 'display:none;' %>">
                    <label>
                      Parent
                      <input type="number" name="parent_id" value="<%= defaultParentId %>" placeholder="parent user id" />
                      <% if (defaultParentId && parentName) { %>
                        <span class="sr-muted">#<%= defaultParentId %> <%= parentName %></span>
                      <% } %>
                    </label>
                  </div>

                  <div class="sr-field-event" style="<%= suggested === 'event_rsvp' ? '' : 'display:none;' %>">
                    <label>
                      Event
                      <select name="event_id">
                        <option value="">— pick event —</option>
                        <% if (s.matchedEvent) { %>
                          <option value="<%= s.matchedEvent.id %>" selected>
                            #<%= s.matchedEvent.id %> <%= s.matchedEvent.title %>
                          </option>
                        <% } %>
                        <% eventOptions.forEach(function(ev) {
                          if (s.matchedEvent && Number(ev.id) === Number(s.matchedEvent.id)) return;
                        %>
                          <option value="<%= ev.id %>">#<%= ev.id %> <%= ev.title %></option>
                        <% }) %>
                      </select>
                    </label>
                  </div>

                  <div class="sr-field-audition" style="<%= suggested === 'video_audition' ? '' : 'display:none;' %>">
                    <label>
                      Program
                      <select name="program">
                        <option value="corps">Corps</option>
                        <option value="independent">Independent / BGI</option>
                      </select>
                    </label>
                    <label>
                      Season year
                      <input type="number" name="season_year" value="<%= seasonYear %>" />
                    </label>
                  </div>

                  <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:10px;">
                    <button type="submit" name="decision" value="accept"
                      onclick="return confirm('ACCEPT: write payment history and update the account balance using the original Stripe time?');"
                      style="background:#e6f4ea;border:1px solid #34a853;color:#1e6e2e;padding:8px 14px;border-radius:6px;cursor:pointer;font-weight:600;">
                      Accept → account
                    </button>
                    <button type="submit" name="decision" value="deny"
                      onclick="return confirm('DENY: remove this account prompt (will not credit any user)?');"
                      style="background:#fce8e6;border:1px solid #d93025;color:#a50e0e;padding:8px 14px;border-radius:6px;cursor:pointer;font-weight:600;">
                      Deny account
                    </button>
                  </div>
                </form>
              <% } %>

              <% if (needsChris) { %>
                <form method="POST" action="/admin/stripe-reconcile/apply" class="sr-actions"
                      style="border-top:1px solid #eee; padding-top:10px; margin-top:12px;">
                  <input type="hidden" name="start" value="<%= start %>" />
                  <input type="hidden" name="end" value="<%= end %>" />
                  <input type="hidden" name="scope" value="chris" />
                  <input type="hidden" name="stripe_id" value="<%= s.id || '' %>" />
                  <input type="hidden" name="payment_intent_id" value="<%= String(s.id || '').indexOf('pi_') === 0 ? s.id : '' %>" />
                  <input type="hidden" name="session_id" value="<%= s.sessionId || '' %>" />
                  <input type="hidden" name="paid_at" value="<%= s.created || '' %>" />
                  <input type="hidden" name="stripe_amount_cents" value="<%= s.amount || 0 %>" />
                  <input type="hidden" name="chris_base_cents" value="<%= s.chrisBaseCents || 0 %>" />
                  <input type="hidden" name="action" value="<%= suggested %>" />
                  <input type="hidden" name="suggested_action" value="<%= suggested %>" />
                  <input type="hidden" name="chris_note" value="Stripe reconcile <%= s.id || s.sessionId || '' %>" />

                  <p><strong>2) Add Chris Payment 3% (<%= money(s.chrisShareCents) %>)?</strong></p>
                  <div style="display:flex; gap:8px; flex-wrap:wrap;">
                    <button type="submit" name="decision" value="accept"
                      onclick="return confirm('ACCEPT: add <%= money(s.chrisShareCents) %> to Chris Payment using the original Stripe time?');"
                      style="background:#e6f4ea;border:1px solid #34a853;color:#1e6e2e;padding:8px 14px;border-radius:6px;cursor:pointer;font-weight:600;">
                      Accept → Chris Payment
                    </button>
                    <button type="submit" name="decision" value="deny"
                      onclick="return confirm('DENY: do not add Chris Payment share for this Stripe payment?');"
                      style="background:#fce8e6;border:1px solid #d93025;color:#a50e0e;padding:8px 14px;border-radius:6px;cursor:pointer;font-weight:600;">
                      Deny Chris share
                    </button>
                  </div>
                </form>
              <% } %>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="sr-section">
        <h2>On website as Stripe, missing / unmatched in Stripe (<%= report.siteOnly.length %>)</h2>
        <% if (!report.siteOnly.length) { %>
          <p>None — every site Stripe record in range matched a Stripe payment.</p>
        <% } else { %>
          <div style="overflow-x:auto;">
            <table class="sr-table">
              <thead>
                <tr>
                  <th>When</th>
                  <th>Amount</th>
                  <th>Source</th>
                  <th>Who</th>
                  <th>Label</th>
                </tr>
              </thead>
              <tbody>
                <% report.siteOnly.forEach(function(r) { %>
                  <tr>
                    <td><%= when(r.created) %></td>
                    <td><%= money(r.amount) %></td>
                    <td><%= r.source %> #<%= r.id %></td>
                    <td>
                      <%= r.name || '-' %>
                      <div class="sr-muted"><%= r.email || '' %></div>
                      <% if (r.userId) { %>
                        <div><a href="/transaction-edit/<%= r.userId %>">User transactions</a></div>
                      <% } %>
                    </td>
                    <td>
                      <%= r.label %>
                      <div class="sr-muted"><%= r.detail %></div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <div class="sr-section" id="ignored-offsite">
        <h2>Ignored — not from boisegems.org (<%= (report.excludedOffsiteStripe && report.excludedOffsiteStripe.length) || 0 %>)</h2>
        <% if (!report.excludedOffsiteStripe || !report.excludedOffsiteStripe.length) { %>
          <p>None in this range.</p>
        <% } else { %>
          <p class="sr-muted">These Stripe charges have no boisegems.org success/cancel URL (jackets, Payment Links, Dashboard, etc.) and are never applied to member balances.</p>
          <% report.excludedOffsiteStripe.forEach(function(s) { %>
            <div class="sr-pay" style="border-color:#9aa0a6;background:#f8f9fa;">
              <h3><%= money(s.amount) %> · <%= when(s.created) %></h3>
              <p style="margin:4px 0;"><%= s.email || '(no email)' %> · <code><%= s.id %></code></p>
              <% if (s.description) { %><p style="margin:4px 0;"><%= s.description %></p><% } %>
              <p class="sr-muted" style="margin:4px 0;">
                success_url: <code style="word-break:break-all;"><%= s.successUrl || '(none)' %></code>
              </p>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="sr-section" id="matched">
        <h2>Reconciled / matched (<%= report.matched.length %>)</h2>
        <% if (!report.matched.length) { %>
          <p>No matches in this range.</p>
        <% } else { %>
          <% report.matched.forEach(function(m) { %>
            <div class="sr-pay <%= m.needsChrisAction ? '' : 'sr-pay--ok' %>">
              <h3><%= money(m.stripe.amount) %> · <%= when(m.stripe.created) %></h3>
              <p style="margin:4px 0;">
                <strong>Stripe:</strong> <%= m.stripe.email || '-' %>
                · <code><%= m.stripe.id %></code>
              </p>
              <p style="margin:4px 0;">
                <strong>Website:</strong>
                <%= m.local.source %> #<%= m.local.id %> — <%= m.local.label %>
                · <%= money(m.local.amount) %>
                <% if (m.local.name || m.local.email) { %>
                  · <%= m.local.name || '' %><% if (m.local.userId) { %> (#<%= m.local.userId %>)<% } %>
                  <%= m.local.email ? ' · ' + m.local.email : '' %>
                <% } %>
              </p>
              <p style="margin:4px 0;">
                <strong>Chris Payment 3%:</strong>
                <% if (m.stripe.chrisShareApplied) { %>
                  <span style="color:#1e6e2e;">found (<%= money(m.stripe.chrisShareCents) %><% if (m.stripe.chrisShareMatchedAt) { %> · <%= when(m.stripe.chrisShareMatchedAt) %><% } %>)</span>
                <% } else if (m.needsChrisAction) { %>
                  <span style="color:#a50e0e;">no time match within 1 min — see Needs your decision</span>
                <% } else { %>
                  <span style="color:#1e6e2e;">resolved</span>
                <% } %>
              </p>
              <p class="sr-muted" style="margin:4px 0;">Match: <%= m.how %></p>
            </div>
          <% }) %>
        <% } %>
      </div>
    <% } %>
  </div>
</main>

<footer>
  <%- include("includes/footer") %>
</footer>
<script>
  function srToggle(sel) {
    var form = sel.form;
    var action = sel.value;
    form.querySelectorAll('.sr-field-user').forEach(function(el) {
      el.style.display = (action === 'donation' || action === 'merch') ? 'none' : '';
    });
    form.querySelectorAll('.sr-field-parent').forEach(function(el) {
      el.style.display = action === 'pay_behalf' ? '' : 'none';
    });
    form.querySelectorAll('.sr-field-audition').forEach(function(el) {
      el.style.display = action === 'video_audition' ? '' : 'none';
    });
    form.querySelectorAll('.sr-field-event').forEach(function(el) {
      el.style.display = action === 'event_rsvp' ? '' : 'none';
      var eventSelect = el.querySelector('select[name="event_id"]');
      if (eventSelect) eventSelect.required = action === 'event_rsvp';
    });
  }
</script>
</body>
</html>
