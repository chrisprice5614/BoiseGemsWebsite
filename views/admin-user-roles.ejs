<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User roles - Admin</title>
  <%- include("includes/head") %>
  <style>
    body.roles-admin-page { background: #ebe7f0; }
    body.roles-admin-page main { max-width: none; width: 100%; margin: 0; padding: 0; background: transparent; box-shadow: none; }
    .ra-hero { background: linear-gradient(135deg, #4a3263 0%, #60437D 48%, #7a5a9a 100%); color: #fff; padding: 28px 32px 32px; }
    .ra-hero a { color: rgba(255,255,255,0.85); text-decoration: none; }
    .ra-hero h1 { margin: 10px 0 6px; color: #fff; font-size: 1.85rem; }
    .ra-wrap { width: min(1000px, calc(100% - 48px)); margin: -18px auto 48px; }
    .ra-panel { background: #fff; border: 1px solid rgba(96,67,125,0.12); border-radius: 14px; padding: 22px 24px; margin-bottom: 18px; box-shadow: 0 8px 24px rgba(40,24,60,0.06); }
    .ra-flash { background: #e8f5e9; border: 1px solid #a5d6a7; color: #1b5e20; padding: 12px 16px; border-radius: 10px; margin-bottom: 18px; }
    label { display: block; margin: 10px 0 4px; font-weight: 600; }
    input, select { width: 100%; padding: 8px 10px; border: 1px solid #ccc; border-radius: 8px; box-sizing: border-box; }
    .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; font-size: 0.95rem; color: #1a1228 !important; }
    th { background: #f3eef8 !important; color: #2a1840 !important; font-weight: 700; }
    tbody tr:nth-child(even) td { background: #faf8fc !important; }
    tbody tr:nth-child(odd) td { background: #fff !important; }
    @media (max-width: 700px) { .grid2 { grid-template-columns: 1fr; } }
  </style>
</head>
<body class="roles-admin-page">
<header><%- include("includes/header") %></header>
<main>
  <div class="ra-hero">
    <a href="/edit-users">&larr; Edit users</a>
    <h1>Roles for <%= thisUser.firstname %> <%= thisUser.lastname %></h1>
    <p style="margin:0;opacity:0.85;"><%= thisUser.email %></p>
  </div>
  <div class="ra-wrap">
    <% if (flashMessage) { %><div class="ra-flash"><%= flashMessage %></div><% } %>
    <div class="ra-panel">
      <h2 style="margin-top:0;">Assign role</h2>
      <form method="POST" action="/admin/user-roles/<%= thisUser.id %>">
        <label for="role_id">Role</label>
        <select id="role_id" name="role_id" required>
          <option value="">Select...</option>
          <% roles.forEach(function(r) { %>
            <option value="<%= r.id %>"><%= r.name %></option>
          <% }) %>
        </select>
        <div class="grid2">
          <div>
            <label for="program">Program scope</label>
            <select id="program" name="program">
              <option value="">All programs</option>
              <option value="corps">Corps</option>
              <option value="independent">Independent</option>
            </select>
          </div>
          <div>
            <label for="season_year">Season year</label>
            <input type="number" id="season_year" name="season_year" placeholder="<%= currentSeason %> (blank = all)">
          </div>
          <div>
            <label for="department">Department</label>
            <input type="text" id="department" name="department" placeholder="Optional">
          </div>
          <div>
            <label for="assignment_label">Assignment label</label>
            <input type="text" id="assignment_label" name="assignment_label" placeholder="Optional">
          </div>
          <div>
            <label for="starts_at">Starts</label>
            <input type="date" id="starts_at" name="starts_at">
          </div>
          <div>
            <label for="ends_at">Ends</label>
            <input type="date" id="ends_at" name="ends_at">
          </div>
        </div>
        <div style="margin-top:14px;"><button type="submit">Assign role</button></div>
      </form>
    </div>
    <div class="ra-panel">
      <h2 style="margin-top:0;">Current &amp; past assignments</h2>
      <table>
        <thead>
          <tr><th>Role</th><th>Scope</th><th>Dates</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% if (!assignments.length) { %>
            <tr><td colspan="5">No role assignments yet.</td></tr>
          <% } %>
          <% assignments.forEach(function(a) { %>
            <tr>
              <td><%= a.role_name %></td>
              <td>
                <%= a.program || "all programs" %>
                <% if (a.season_year) { %> · <%= a.season_year %><% } %>
                <% if (a.department) { %> · <%= a.department %><% } %>
                <% if (a.assignment_label) { %> · <%= a.assignment_label %><% } %>
              </td>
              <td>
                <%= a.starts_at ? new Date(a.starts_at).toLocaleDateString() : "-" %>
                →
                <%= a.ends_at ? new Date(a.ends_at).toLocaleDateString() : "open" %>
              </td>
              <td><%= a.active ? "Active" : "Ended" %></td>
              <td>
                <% if (a.active) { %>
                  <form method="POST" action="/admin/user-roles/<%= thisUser.id %>/revoke/<%= a.id %>" style="display:inline;">
                    <button type="submit" onclick="return confirm('Revoke this assignment?');">Revoke</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
