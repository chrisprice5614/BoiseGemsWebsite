<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Boise Gems Independent — About</title>
  <%- include("includes/head") %>
  <meta name="description" content="About Boise Gems Independent, indoor percussion, and staff.">
  <link rel="canonical" href="https://boisegems.org/boise-gems-independent">

  <style>
    .about-page { --pad: 12px; }
    .about-hero {
      position: relative;
      min-height: 48vh;
      background: #111 center/cover no-repeat;
      display: grid;
      place-items: center;
      overflow: hidden;
    }
    .about-hero::before {
      content: "";
      position: absolute; inset: 0;
      background: url('/img/photos/boise-gems-24.jpg') center/cover no-repeat;
      filter: brightness(.68);
    }
    .about-hero::after {
      content: "";
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,.1) 0%, rgba(0,0,0,.52) 100%);
    }
    .about-hero__content { position: relative; width: min(100%, 980px); margin: 0 var(--pad); color: #fff; text-align: center; }
    .about-hero__title { margin: 0 0 10px; font-size: clamp(28px, 5vw, 44px); color: #fff; }
    .about-hero__text  { margin: 0 auto; max-width: 760px; font-size: clamp(15px, 2.6vw, 19px); line-height: 1.6; color: #fff; }

    .about-section { margin: 20px var(--pad); }
    .about-wrap { margin: 0 auto; width: min(100%, 980px); }
    .about-section h2 { margin: 0 0 10px; font-size: clamp(22px, 3.5vw, 30px); }
    .about-prose p { margin: 10px 0; line-height: 1.75; font-size: 16px; }

    .staff-block { margin-top: 14px; }
    .staff-grid { display: grid; grid-template-columns: repeat(auto-fill, 240px); justify-content: center; gap: 14px; }
    .staff-card {
      border-radius: 14px; overflow: hidden;
      border: 1px solid #eee; background: #fff;
      transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }
    .staff-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,0,0,.08); border-color: #e6e6e6; }
    .staff-media { aspect-ratio: 4/3; background: #f1f1f1 center/cover no-repeat; }
    .staff-meta { padding: 12px; }
    .staff-name { margin: 0 0 2px; font-weight: 700; font-size: 18px; line-height: 1.25; }
    .staff-role { margin: 0; font-size: 14px; opacity: .75; }
    .staff-category { margin: 22px 0 10px; font-weight: 800; font-size: 16px; letter-spacing: .2px; opacity: .9; }
    .staff-link { display: block; color: inherit; text-decoration: none; height: 100%; }

    @media (max-width: 520px) {
      .staff-grid { grid-template-columns: repeat(auto-fill, 180px); gap: 12px; }
    }
  </style>
</head>
<body class="about-page" style="background:#fafafa;">
<header><%- include("includes/header") %></header>

<section class="about-hero">
  <div class="about-hero__content">
    <h1 class="about-hero__title">Boise Gems Independent</h1>
    <p class="about-hero__text">Indoor percussion with the same Gems commitment to education, achievement, and opportunity.</p>
  </div>
</section>

<section class="about-section">
  <div class="about-wrap about-prose">
    <h2>Program Overview</h2>
    <p>Boise Gems Independent extends the Gems Performing Arts mission into the indoor percussion season, offering members a focused ensemble experience during the fall and spring cycle.</p>
    <p>BGI is designed to grow musical excellence, individual accountability, and team culture while preparing performers for a competitive indoor environment.</p>
    <p>The group marks a major step in organization growth and expands year-round performing arts access for students in Idaho and neighboring regions.</p>
  </div>
</section>

<section class="about-section">
  <div class="about-wrap">
    <h2>Staff</h2>

    <% if (staffSections && staffSections.length) { %>
      <% staffSections.forEach(section => { %>
        <h3 class="staff-category"><%= section.title %></h3>
        <div class="staff-block">
          <div class="staff-grid">
            <% section.staff.forEach(s => {
              const imgUrl = s.image ? ("/img/publicupload/" + s.image) : "/img/ui/gem.png";
              const href = s.slug ? ("/staff/" + s.slug) : ("/staff/" + s.id);
            %>
              <article class="staff-card card">
                <a class="staff-link" href="<%= href %>" aria-label="<%= s.first %> <%= s.last %> — <%= s.position %>">
                  <div class="staff-media" style="background-image:url('<%= imgUrl %>');"></div>
                  <div class="staff-meta">
                    <h4 class="staff-name"><%= s.first %> <%= s.last %></h4>
                    <p class="staff-role"><%= s.position %></p>
                  </div>
                </a>
              </article>
            <% }); %>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p>No staff available right now.</p>
    <% } %>
  </div>
</section>

<footer><%- include("includes/footer") %></footer>
</body>
</html>
