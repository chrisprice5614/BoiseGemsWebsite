<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Calendar</title>
  <%- include("includes/head") %>
  <!-- styles moved to styles.css -->
</head>
<body>
<header><%- include("includes/header") %></header>
<script id="calendar-events-json" type="application/json"><%- JSON.stringify(events || []).replace(/</g, '\\u003c') %></script>

<main>
  <div class="cal" style="padding: 4px;">
    <div class="ical-wrap">
      <button type="button" class="ical-toggle" id="ical-toggle">Export iCal ▾</button>
      <div class="ical-menu" id="ical-menu" aria-hidden="true">
        <p class="ical-title">Choose event categories</p>
        <div class="ical-options" id="ical-options"></div>
        <div class="ical-actions">
          <button type="button" id="ical-check-all">Select All</button>
          <button type="button" id="ical-download">Download .ics</button>
        </div>
      </div>
    </div>

    <!-- Legend / Key -->
    <div class="key">
      <span class="chip"><span class="swatch" style="background:#43a047"></span>Camp</span>
      <span class="chip"><span class="swatch" style="background:#26a69a"></span>Experience Camp</span>
      <span class="chip"><span class="swatch" style="background:#5c6bc0"></span>Performance</span>
      <span class="chip"><span class="swatch" style="background:#ef6c00"></span>Fundraiser</span>
      <span class="chip"><span class="swatch" style="background:#9e9d24"></span>Spring Training</span>
      <span class="chip"><span class="swatch" style="background:#ec407a"></span>BGI Audition</span>
      <span class="chip"><span class="swatch" style="background:#26c6da"></span>BGI Camp</span>
      <span class="chip"><span class="swatch" style="background:#7e57c2"></span>BGI Performance</span>
      <span class="chip"><span class="swatch" style="background:#eeaaee"></span>Other</span>
    </div>


    <%
      /* ===== Helpers (scoped) ===== */
      const today = new Date(); // server time
      const start = new Date(today.getFullYear(), today.getMonth(), 1);
      const monthsToShow = 12; // current + 11 more
      const endWindow = new Date(start.getFullYear(), start.getMonth() + monthsToShow, 1);
      const weekdayShort = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

      const typeClass = (t='') => String(t).toLowerCase().replace(/\s+/g,'-');

            const typeColorMap = {
        'camp': '#43a047',
        'experience camp': '#26a69a',
        'performance': '#5c6bc0',
        'fundraiser': '#ef6c00',
        'spring training': '#9e9d24',
        'bgi audition': '#ec407a',
        'bgi camp': '#26c6da',
        'bgi performance': '#7e57c2',
        'other': '#eeaaee'
      };
      const typeColor = (t='') => typeColorMap[String(t).toLowerCase()] || '#444';


      const parseEventDate = (s) => {
        if (!s) return null;
        const d = new Date(s);
        return isNaN(d) ? null : d;
      };

      const ymdKey = (d) => {
        const yy = d.getFullYear();
        const mm = String(d.getMonth()+1).padStart(2,'0');
        const dd = String(d.getDate()).padStart(2,'0');
        return `${yy}-${mm}-${dd}`;
      };

      const stripMidnight = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate());

      // Expand an event across all days it spans (inclusive).
      // Uses event.endtime (e.g., "2025-11-14T12:50") when valid and >= start.
      const expandEventDays = (ev) => {
        const s = parseEventDate(ev.datetime);
        if (!s) return [];
        const e = ev.endtime ? parseEventDate(ev.endtime) : null;

        let lastDay = stripMidnight(s);
        if (e && e >= s) lastDay = stripMidnight(e);

        const days = [];
        let cur = stripMidnight(s);
        while (cur <= lastDay) {
          days.push(new Date(cur));
          cur = new Date(cur.getFullYear(), cur.getMonth(), cur.getDate() + 1);
        }
        return days;
      };

      const fmtDate = (d) => d.toLocaleDateString('en-US',{ weekday:'short', month:'short', day:'numeric' });
      const fmtTime = (d) => d.toLocaleTimeString('en-US',{ hour:'numeric', minute:'2-digit' });

      // Smart range label reused for both featured and popover
      const makeRangeLabel = (ev) => {
        const dtStart = parseEventDate(ev.datetime);
        const dtEnd = ev.endtime ? parseEventDate(ev.endtime) : null;
        if (dtStart && dtEnd) {
          const sameDay = dtStart.toDateString() === dtEnd.toDateString();
          return sameDay
            ? `${fmtDate(dtStart)} · ${fmtTime(dtStart)}-${fmtTime(dtEnd)}`
            : `${fmtDate(dtStart)} · ${fmtTime(dtStart)} → ${fmtDate(dtEnd)} · ${fmtTime(dtEnd)}`;
        } else if (dtStart) {
          return `${fmtDate(dtStart)} · ${fmtTime(dtStart)}`;
        }
        return '';
      };

      /* ===== Build events-by-day map (with multi-day expansion) ===== */
      const eventsByDay = {};
      (events || []).forEach(ev => {
        const s = parseEventDate(ev.datetime);
        if (!s) return;

        const days = expandEventDays(ev);
        days.forEach(day => {
          if (day >= start && day < endWindow) {
            const k = ymdKey(day);
            (eventsByDay[k] ||= []).push(ev);
          }
        });
      });

      /* ===== Pick soonest 3 events (upcoming) for featured ===== */
      const now = new Date();
      const normalized = (events || [])
        .map(ev => ({ ev, start: parseEventDate(ev.datetime) }))
        .filter(x => x.start);

      const upcoming = normalized
        .filter(x => x.start >= now)
        .sort((a,b) => a.start - b.start)
        .slice(0,3)
        .map(x => x.ev);

      const featuredEvents = upcoming.length ? upcoming
        : normalized.sort((a,b) => a.start - b.start).slice(0,3).map(x => x.ev);
    %>

    <!-- Featured soonest events -->
    <% if (featuredEvents.length) { %>
      <section class="featured-wrap">
        <div class="featured">
          <% featuredEvents.forEach(e => { 
               const label = makeRangeLabel(e);
               const cost = (e.cost != null && e.cost !== '') ? Number(e.cost) : null;
          %>
            <a class="feat-card" href="/event/<%= e.slug %>">
              <div class="feat-media">
                <div class="feat-img">
                  <img src="/img/publicupload/<%- e.image %>" alt="<%- e.title %> preview">
                </div>
                <span class="feat-type-pill" style="background:<%= typeColor(e.type) %>"><%= e.type %></span>
              </div>
              <div class="feat-body">
                <h3 class="feat-title"><%- e.title %></h3>
                <% if (e.description || e.desc) { %>
                  <p class="feat-desc"><%- e.description || e.desc %></p>
                <% } %>
                <div class="feat-meta">
                  <% if (label) { %><span><%= label %></span><% } %>
                  <% if (cost !== null && !Number.isNaN(cost)) { %>
                    <span class="feat-cost"><%= cost.toLocaleString('en-US',{ style:'currency', currency:'USD' }) %></span>
                  <% } %>
                </div>
              </div>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% for (let m = 0; m < monthsToShow; m++) {
         const first = new Date(start.getFullYear(), start.getMonth() + m, 1);
         const y = first.getFullYear();
         const mon = first.getMonth(); // 0-11
         const lastDayNum = new Date(y, mon + 1, 0).getDate();
         const firstWeekday = first.getDay(); // 0=Sun
    %>
      <section class="month">
        <h2><%= first.toLocaleString('default', { month: 'long' }) %> <%= y %></h2>

        <div class="weekdays">
          <% weekdayShort.forEach(w => { %><div><%= w %></div><% }) %>
        </div>

        <div class="grid">
          <% for (let day = 1; day <= lastDayNum; day++) {
               const cellDate = new Date(y, mon, day);
               const dayKey   = ymdKey(cellDate);
               const isFirst  = day === 1;
               const gridStart = isFirst ? (firstWeekday + 1) : 'auto';
          %>
            <div class="day" style="grid-column-start:<%= gridStart %>">
              <div class="date"><%= day %></div>
              <div class="events">
                <% (eventsByDay[dayKey] || []).forEach(e => {
                     const rangeLabel = makeRangeLabel(e);
                %>
                  <a class="event type-<%= typeClass(e.type) %>" href="/event/<%= e.slug %>" title="<%- e.title %>">
                    <span class="evt-label"><%- e.title %></span>

                    <% if (e.image) { %>
                      <span class="evt-pop" aria-hidden="true">
                        <span class="evt-pop-img">
                          <img src="/img/publicupload/<%- e.image %>" alt="<%- e.title %> preview">
                        </span>
                        <span class="evt-pop-body">
                          <span class="evt-pop-title"><%- e.title %></span>

                          <!-- Type pill -->
                          <span class="cal evt-type-pill" style="background:<%= typeColor(e.type) %>">
                            <%= e.type %>
                          </span>

                          <% if (rangeLabel) { %>
                            <span class="evt-pop-meta"><%= rangeLabel %></span>
                          <% } %>
                        </span>
                      </span>
                    <% } %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>
  </div>
</main>

<footer><%- include("includes/footer") %></footer>
<script>
  (() => {
    const rawEventsJson = document.getElementById('calendar-events-json')?.textContent || '[]';
    const eventsData = JSON.parse(rawEventsJson);

    const typeColorMap = {
      'camp': '#43a047',
      'experience camp': '#26a69a',
      'performance': '#5c6bc0',
      'fundraiser': '#ef6c00',
      'spring training': '#9e9d24',
      'bgi audition': '#ec407a',
      'bgi camp': '#26c6da',
      'bgi performance': '#7e57c2',
      'other': '#eeaaee'
    };
    const orderedTypes = [
      'camp',
      'experience camp',
      'performance',
      'fundraiser',
      'spring training',
      'bgi audition',
      'bgi camp',
      'bgi performance',
      'other'
    ];

    const normalizeType = (value) => String(value || '').trim().toLowerCase();
    const dateOrNull = (value) => {
      if (!value) return null;
      const dt = new Date(value);
      return Number.isNaN(dt.getTime()) ? null : dt;
    };

    const toMountainLocalStamp = (value) => {
      if (!value) return null;
      const raw = String(value).trim();
      const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})(?:[T\s](\d{2}):(\d{2})(?::(\d{2}))?)?/);
      if (!match) return null;

      const year = match[1];
      const month = match[2];
      const day = match[3];
      const hour = match[4] || '00';
      const minute = match[5] || '00';
      const second = match[6] || '00';

      return `${year}${month}${day}T${hour}${minute}${second}`;
    };

    const allTypesSet = new Set(eventsData.map(e => normalizeType(e.type)).filter(Boolean));
    orderedTypes.forEach(t => allTypesSet.add(t));
    const categoryTypes = Array.from(allTypesSet).sort((a, b) => {
      const ai = orderedTypes.indexOf(a);
      const bi = orderedTypes.indexOf(b);
      const ar = ai === -1 ? 999 : ai;
      const br = bi === -1 ? 999 : bi;
      return ar !== br ? ar - br : a.localeCompare(b);
    });

    const toggleBtn = document.getElementById('ical-toggle');
    const menu = document.getElementById('ical-menu');
    const optionsRoot = document.getElementById('ical-options');
    const checkAllBtn = document.getElementById('ical-check-all');
    const downloadBtn = document.getElementById('ical-download');

    if (!toggleBtn || !menu || !optionsRoot || !checkAllBtn || !downloadBtn) return;

    optionsRoot.innerHTML = categoryTypes.map((type) => {
      const color = typeColorMap[type] || '#666';
      const label = type.replace(/\b\w/g, (m) => m.toUpperCase());
      return `
        <label class="ical-option">
          <input type="checkbox" class="ical-type" value="${type}" checked>
          <span class="ical-dot" style="background:${color}"></span>
          <span>${label}</span>
        </label>
      `;
    }).join('');

    const getCheckedTypes = () => {
      return Array.from(document.querySelectorAll('.ical-type:checked')).map((node) => node.value);
    };

    const escapeIcalText = (value) => {
      return String(value || '')
        .replace(/\\/g, '\\\\')
        .replace(/;/g, '\\;')
        .replace(/,/g, '\\,')
        .replace(/\r?\n/g, '\\n');
    };

    const toIcalTimestamp = (value) => {
      const dt = dateOrNull(value);
      if (!dt) return null;
      const year = dt.getUTCFullYear();
      const month = String(dt.getUTCMonth() + 1).padStart(2, '0');
      const day = String(dt.getUTCDate()).padStart(2, '0');
      const hour = String(dt.getUTCHours()).padStart(2, '0');
      const min = String(dt.getUTCMinutes()).padStart(2, '0');
      const sec = String(dt.getUTCSeconds()).padStart(2, '0');
      return `${year}${month}${day}T${hour}${min}${sec}Z`;
    };

    const makeUid = (event) => {
      const base = event.slug || `${event.title || 'event'}-${event.datetime || Date.now()}`;
      return `${String(base).replace(/\s+/g, '-').toLowerCase()}@boisegems.org`;
    };

    const buildIcs = (selectedTypes) => {
      const selectedSet = new Set(selectedTypes.map(normalizeType));
      const filtered = eventsData.filter((event) => selectedSet.has(normalizeType(event.type)));
      const dtStamp = toIcalTimestamp(new Date().toISOString());

      const rows = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Boise Gems//Calendar Export//EN',
        'CALSCALE:GREGORIAN',
        'METHOD:PUBLISH',
        'X-WR-TIMEZONE:America/Denver',
        'BEGIN:VTIMEZONE',
        'TZID:America/Denver',
        'X-LIC-LOCATION:America/Denver',
        'BEGIN:DAYLIGHT',
        'TZOFFSETFROM:-0700',
        'TZOFFSETTO:-0600',
        'TZNAME:MDT',
        'DTSTART:19700308T020000',
        'RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU',
        'END:DAYLIGHT',
        'BEGIN:STANDARD',
        'TZOFFSETFROM:-0600',
        'TZOFFSETTO:-0700',
        'TZNAME:MST',
        'DTSTART:19701101T020000',
        'RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU',
        'END:STANDARD',
        'END:VTIMEZONE'
      ];

      filtered.forEach((event) => {
        const start = toMountainLocalStamp(event.datetime);
        if (!start) return;
        const end = toMountainLocalStamp(event.endtime) || start;

        rows.push('BEGIN:VEVENT');
        rows.push(`UID:${escapeIcalText(makeUid(event))}`);
        rows.push(`DTSTAMP:${dtStamp}`);
        rows.push(`DTSTART;TZID=America/Denver:${start}`);
        rows.push(`DTEND;TZID=America/Denver:${end}`);
        rows.push(`SUMMARY:${escapeIcalText(event.title || 'Boise Gems Event')}`);

        if (event.description || event.desc) {
          rows.push(`DESCRIPTION:${escapeIcalText(event.description || event.desc)}`);
        }
        if (event.location) {
          rows.push(`LOCATION:${escapeIcalText(event.location)}`);
        }
        if (event.type) {
          rows.push(`CATEGORIES:${escapeIcalText(event.type)}`);
        }

        rows.push('END:VEVENT');
      });

      rows.push('END:VCALENDAR');
      return rows.join('\r\n');
    };

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('active');
      menu.setAttribute('aria-hidden', menu.classList.contains('active') ? 'false' : 'true');
    });

    menu.addEventListener('click', (e) => e.stopPropagation());
    document.addEventListener('click', () => {
      menu.classList.remove('active');
      menu.setAttribute('aria-hidden', 'true');
    });

    checkAllBtn.addEventListener('click', () => {
      const checkboxes = Array.from(document.querySelectorAll('.ical-type'));
      const shouldCheckAll = checkboxes.some((input) => !input.checked);
      checkboxes.forEach((input) => { input.checked = shouldCheckAll; });
      checkAllBtn.textContent = shouldCheckAll ? 'Clear All' : 'Select All';
    });

    downloadBtn.addEventListener('click', () => {
      const selected = getCheckedTypes();
      if (!selected.length) {
        alert('Choose at least one category to export.');
        return;
      }

      const ics = buildIcs(selected);
      const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      const date = new Date();
      const yy = date.getFullYear();
      const mm = String(date.getMonth() + 1).padStart(2, '0');
      const dd = String(date.getDate()).padStart(2, '0');

      link.href = url;
      link.download = `boise-gems-calendar-${yy}${mm}${dd}.ics`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    });
  })();
</script>
</body>
</html>
