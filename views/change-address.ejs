<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <div style="padding: 8px; max-width: 640px; margin: 0 auto;">
            <br />
            <h1 style="text-align: center;">Update Your Information</h1>
            <br />

            <% if (typeof flashMessage !== "undefined" && flashMessage) { %>
                <div class="info"><%= flashMessage %></div>
                <br />
            <% } %>

            <div class="form-panel form-panel--narrow">
<form action="/change-address" method="POST">
                <!-- Address -->
                <label for="address"><strong>Mailing Address</strong></label><br />
                <input
                    type="text"
                    id="address"
                    name="address"
                    placeholder="123 E Fake Street"
                    required
                    style="width: 100%; padding: 8px;"
                    value="<%= member.address || '' %>"
                />
                <br /><br />

                <!-- Email -->
                <label for="email"><strong>Email</strong></label><br />
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="you@example.com"
                    required
                    style="width: 100%; padding: 8px;"
                    value="<%= member.email || '' %>"
                />
                <br /><br />

                <!-- Phone -->
                <label for="phone"><strong>Phone</strong></label><br />
                <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="555-555-5555"
                    style="width: 100%; padding: 8px;"
                    value="<%= member.phone || '' %>"
                />
                <br /><br />

                <!-- Birthday -->
                <label for="birthday"><strong>Birthday</strong></label><br />
                <input
                    type="date"
                    id="birthday"
                    name="birthday"
                    style="width: 100%; padding: 8px;"
                    value="<%= member.birthday ? (function(ms){ var d = new Date(ms); return d.getUTCFullYear() + '-' + String(d.getUTCMonth()+1).padStart(2,'0') + '-' + String(d.getUTCDate()).padStart(2,'0'); })(member.birthday) : '' %>"
                />
                <br /><br />

                <div style="text-align: center;">
                    <button type="submit">Save Info</button>
                </div>
            </form>
</div>
            <br />
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>
