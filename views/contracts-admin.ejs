<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Contract PDFs - Boise Gems</title>
  <%- include("includes/head") %>
</head>
<body>
<header><%- include("includes/header") %></header>
<main>
  <div style="margin:12px; max-width:720px;">
    <h1>Contract PDFs</h1>
    <p>
      Choose an ensemble to upload a new contract PDF or place fill-in fields
      (Text, Signature, Date, Initials) so members can sign online.
    </p>

    <%
      const contracts = [
        { key: "corps", label: "Corps", row: corpsContract },
        { key: "independent", label: "Independent", row: independentContract },
        { key: "affiliate", label: "Affiliate", row: affiliateContract },
      ];
    %>

    <% contracts.forEach(function (c) {
      const fieldCount = (function () {
        try {
          const parsed = JSON.parse((c.row && c.row.fields_json) || "[]");
          return Array.isArray(parsed) ? parsed.length : 0;
        } catch (_) { return 0; }
      })();
    %>
      <div class="form-panel" style="margin-bottom:16px; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px;">
        <div>
          <h2 style="margin:0 0 6px;"><%= c.label %> Contract</h2>
          <% if (c.row && c.row.pdf_path) { %>
            <p style="margin:0; color:#555;">
              PDF on file ·
              <a href="<%= c.row.pdf_path %>" target="_blank" rel="noopener">View</a>
              <% if (fieldCount) { %>
                · <%= fieldCount %> online field<%= fieldCount === 1 ? "" : "s" %>
              <% } else { %>
                · print &amp; upload (no online fields)
              <% } %>
            </p>
          <% } else { %>
            <p style="margin:0; color:#888;"><i>No PDF uploaded yet.</i></p>
          <% } %>
        </div>
        <a href="/contracts-admin/edit/<%= c.key %>"><button type="button">Edit</button></a>
      </div>
    <% }) %>
  </div>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
