                <% } %>
            </div><!-- /panel-subscribe -->

        </div><!-- /donate-page -->

        <!-- ═══ Donor Wall ═══ -->
        <div class="donor-wall">
            <h2>Thank You to Our Donors</h2>
            <p class="dw-sub">Your support makes all the difference.</p>
            <% if (typeof donorNames !== 'undefined' && donorNames && donorNames.length > 0) { %>
                <div class="donor-grid">
                    <% donorNames.forEach(name => { %>
                    <div class="donor-chip">
                        <p><%= name %></p>
                    </div>
                    <% }) %>
                </div>
            <% } else { %>
                <p style="text-align: center; color: #999;">Be the first to donate!</p>
            <% } %>
        </div>

    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>

    <script>
    /* ── Tab switching ── */
    function switchTab(tab) {
        document.querySelectorAll('.dn-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.dn-panel').forEach(p => p.classList.remove('active'));
        event.target.classList.add('active');
        document.getElementById('panel-' + tab).classList.add('active');
    }

    /* ── Feed the Corps ── */
    let selectedFtcCard = null;
    function selectFtc(card, tier, amountCents) {
        if (selectedFtcCard) selectedFtcCard.classList.remove('selected');
        card.classList.add('selected');
        selectedFtcCard = card;
        document.getElementById('ftcTier').value = tier;
        document.getElementById('ftcAmount').value = amountCents;
        const form = document.getElementById('ftc-form');
        form.classList.add('visible');
        form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    /* ── Shared helpers ── */
    const SHIRT_SIZES = ['XS','S','M','L','XL','2XL','3XL'];

    function renderShirtSelectors(container, shirts, prefix) {
        if (!shirts || shirts.length === 0) { container.innerHTML = ''; return; }
        let html = '<strong style="display:block; margin-bottom:10px; font-size:.95rem;">Select Shirt Size(s)</strong>';
        let idx = 0;
        shirts.forEach(s => {
            for (let i = 0; i < s.count; i++) {
                html += '<div class="shirt-row">' +
                    '<label>' + s.label + (s.count > 1 ? ' #' + (i+1) : '') + ':</label>' +
                    '<select name="' + prefix + '_' + idx + '" required>' +
                    '<option value="">-- Select --</option>' +
                    SHIRT_SIZES.map(sz => '<option value="'+sz+'">'+sz+'</option>').join('') +
                    '</select></div>';
                idx++;
            }
        });
        container.innerHTML = html;
    }

    function calcFillPercent(amount, thresholds) {
        for (let i = thresholds.length - 1; i >= 0; i--) {
            if (amount >= thresholds[i]) {
                if (i === thresholds.length - 1) return 100;
                const segPct = 100 / (thresholds.length - 1);
                const base = i * segPct;
                const range = thresholds[i + 1] - thresholds[i];
                const progress = Math.min((amount - thresholds[i]) / range, 1);
                return base + progress * segPct;
            }
        }
        if (amount > 0 && thresholds[0] > 0) {
            const firstSegPct = 100 / (thresholds.length - 1);
            return (amount / thresholds[0]) * firstSegPct * 0.8;
        }
        return 0;
    }

    function updateTracker(trackerId, fillId, amount, thresholds) {
        const tracker = document.getElementById(trackerId);
        const fill = document.getElementById(fillId);
        if (!tracker || !fill) return;
        const steps = tracker.querySelectorAll('.tt-step');
        let activeIdx = -1;
        steps.forEach((step, i) => {
            const min = thresholds[i];
            step.classList.remove('reached', 'active');
            if (amount >= min) {
                step.classList.add('reached');
                activeIdx = i;
            }
        });
        if (activeIdx >= 0) steps[activeIdx].classList.add('active');
        const barWidth = tracker.querySelector('.tt-step:last-child');
        const trackerRect = tracker.getBoundingClientRect();
        const pct = calcFillPercent(amount, thresholds);
        const maxWidth = trackerRect.width - 20;
        fill.style.width = Math.min(pct, 100) + '%';
    }

    function updateRewardsPanel(panelId, nudgeId, tier, amount, tierData) {
        const panel = document.getElementById(panelId);
        const nudge = document.getElementById(nudgeId);
        if (!panel) return;
        panel.className = 'rewards-panel';
        if (!tier) {
            panel.classList.add('rp-none');
            panel.innerHTML = '<h4>Your Rewards</h4>' +
                '<p class="rp-placeholder">Increase your donation to start earning tier rewards!</p>';
        } else {
            panel.classList.add('rp-' + tier.key);
            let html = '<h4 style="color:' + tier.color + ';">' + tier.label + ' Tier</h4><ul>';
            tier.perks.forEach(p => html += '<li>' + p + '</li>');
            html += '</ul>';
            panel.innerHTML = html;
        }
        if (nudge) {
            const currentIdx = tier ? tierData.indexOf(tier) : -1;
            const nextTier = tierData[currentIdx + 1];
            if (nextTier && amount > 0) {
                const diff = (nextTier.min - amount).toFixed(2);
                nudge.style.display = 'block';
                nudge.innerHTML = 'Add <strong>$' + diff + ' more</strong> to reach <strong>' + nextTier.label + '</strong> and unlock: ' + nextTier.perks[0];
            } else {
                nudge.style.display = 'none';
            }
        }
    }

    /* ════════════════════════════════════════════
       ONE-TIME INDIVIDUAL TIERS
       ════════════════════════════════════════════ */
    const OT_TIERS = [
        { key: 'bronze', min: 100, label: 'Bronze', color: '#9a5e1e',
          perks: ['Donor acknowledgement on website', 'Tax deductible contribution'],
          shirts: [] },
        { key: 'silver', min: 250, label: 'Silver', color: '#6b6b6b',
          perks: ['Shirt (1)', 'Donor acknowledgement on website', 'Tax deductible contribution'],
          shirts: [{ label: 'Shirt', count: 1 }] },
        { key: 'gold', min: 500, label: 'Gold', color: '#9e7400',
          perks: ['BG hat (1) + BG shirt (1)', 'Donor acknowledgement on website', 'Tax deductible contribution'],
          shirts: [{ label: 'BG Shirt', count: 1 }] },
        { key: 'platinum', min: 750, label: 'Platinum', color: '#555',
          perks: ['(2) GA Tickets for Drums Across the Gem State', 'BG hat (1) + BG shirts (2)', 'Donor acknowledgement on website', 'Tax deductible contribution'],
          shirts: [{ label: 'BG Shirt', count: 2 }] },
        { key: 'star_garnet', min: 1000, label: 'Star Garnet', color: '#7b1fa2',
          perks: ['VIP Tickets (2) for Drums Across the Gem State', 'BG hat (1) + BG shirts (2)', 'Donor acknowledgement on website', 'Tax deductible contribution'],
          shirts: [{ label: 'BG Shirt', count: 2 }] }
    ];
    const OT_THRESHOLDS = OT_TIERS.map(t => t.min);

    function updateOneTimeTier() {
        const amount = parseFloat(document.getElementById('onetimeAmount').value) || 0;
        let matched = null;
        for (let i = OT_TIERS.length - 1; i >= 0; i--) {
            if (amount >= OT_TIERS[i].min) { matched = OT_TIERS[i]; break; }
        }
        document.getElementById('onetimeTier').value = matched ? matched.key : '';
        document.getElementById('onetimeTierMin').value = matched ? matched.min * 100 : '';
        updateTracker('ot-tracker', 'ot-fill', amount, OT_THRESHOLDS);
        updateRewardsPanel('ot-rewards', 'ot-nudge', matched, amount, OT_TIERS);
        const shirtSection = document.getElementById('onetime-shirt-section');
        renderShirtSelectors(shirtSection, matched ? matched.shirts : [], 'shirtSize');
    }

    /* ════════════════════════════════════════════
       INDIVIDUAL SUBSCRIPTION TIERS
       ════════════════════════════════════════════ */
    const IND_SUB_TIERS = [
        { key: 'bronze', min: 10, label: 'Bronze', color: '#9a5e1e',
          perks: ['Donor acknowledgement on website for 2026 season', 'Tax deductible contribution'],
          shirts: [] },
        { key: 'silver', min: 25, label: 'Silver', color: '#6b6b6b',
          perks: ['Shirt (1)', 'Donor acknowledgement on website for 2026 season', 'Tax deductible contribution'],
          shirts: [{ label: 'Shirt', count: 1 }] },
        { key: 'gold', min: 50, label: 'Gold', color: '#9e7400',
          perks: ['BG hat (1) + BG shirt (1)', 'Donor acknowledgement on website for 2026 season', 'Tax deductible contribution'],
          shirts: [{ label: 'BG Shirt', count: 1 }] },
        { key: 'platinum', min: 75, label: 'Platinum', color: '#555',
          perks: ['(2) GA Tickets for Drums Across the Gem State', 'BG hat (1) + BG shirts (2)', 'Donor acknowledgement on website for 2026 season', 'Tax deductible contribution'],
          shirts: [{ label: 'BG Shirt', count: 2 }] },
        { key: 'star_garnet', min: 100, label: 'Star Garnet', color: '#7b1fa2',
          perks: ['VIP Tickets (2) for Drums Across the Gem State', 'BG hat (1) + BG shirts (2)', 'Donor acknowledgement on website for 2026 season', 'Tax deductible contribution'],
          shirts: [{ label: 'BG Shirt', count: 2 }] }
    ];
    const IND_SUB_THRESHOLDS = IND_SUB_TIERS.map(t => t.min);

    function updateIndSubTier() {
        const amount = parseFloat(document.getElementById('indSubAmount').value) || 0;
        let matched = null;
        for (let i = IND_SUB_TIERS.length - 1; i >= 0; i--) {
            if (amount >= IND_SUB_TIERS[i].min) { matched = IND_SUB_TIERS[i]; break; }
        }
        document.getElementById('indSubTier').value = matched ? matched.key : '';
        updateTracker('ind-tracker', 'ind-fill', amount, IND_SUB_THRESHOLDS);
        updateRewardsPanel('ind-rewards', 'ind-nudge', matched, amount, IND_SUB_TIERS);
        const shirtSection = document.getElementById('ind-shirt-section');
        renderShirtSelectors(shirtSection, matched ? matched.shirts : [], 'indShirtSize');
    }

    /* ════════════════════════════════════════════
       CORPORATE SUBSCRIPTION TIERS
       ════════════════════════════════════════════ */
    const CORP_SUB_TIERS = [
        { key: 'bronze', min: 100, label: 'Bronze', color: '#9a5e1e',
          perks: ['Donor acknowledgement on website for 2026 season', 'Acknowledgement at Drums Across the Gem State', '(1) social media acknowledgement', 'Tax deductible contribution'],
          shirts: [] },
        { key: 'silver', min: 500, label: 'Silver', color: '#6b6b6b',
          perks: ['BG shirts (2)', '(1) social media acknowledgement', 'Acknowledgement on website & at Drums Across the Gem State', 'Tax deductible contribution'],
          shirts: [{ label: 'BG Shirt', count: 2 }] },
        { key: 'gold', min: 1000, label: 'Gold', color: '#9e7400',
          perks: ['Logo on equipment trailer (Good location)', '(2) social media acknowledgements', 'Acknowledgement at Drums Across the Gem State & tour send-off', 'BG hats (2) + BG shirts (2)', 'Donor acknowledgement on website', 'Tax deductible contribution'],
          shirts: [{ label: 'BG Hat', count: 2 }, { label: 'BG Shirt', count: 2 }] },
        { key: 'platinum', min: 2500, label: 'Platinum', color: '#555',
          perks: ['Logo on equipment trailer (Great location)', 'Tour shirt (2)', 'GA tickets (4) w/ acknowledgement at all Gems events', '10% discount on all BG merch', '(3) social media posts', 'Donor acknowledgement on website', 'Tax deductible contribution'],
          shirts: [{ label: 'Tour Shirt', count: 2 }] },
        { key: 'star_garnet', min: 5000, label: 'Star Garnet', color: '#7b1fa2',
          perks: ['Logo on equipment trailer (Prominent location)', '2026 Tour shirt (4)', 'Premium tickets (4) w/ speaker acknowledgement at all Gems events', '10% discount on all BG merch', '(5) social media posts', 'Donor acknowledgement on website', 'Tax deductible contribution'],
          shirts: [{ label: '2026 Tour Shirt', count: 4 }] }
    ];
    const CORP_SUB_THRESHOLDS = CORP_SUB_TIERS.map(t => t.min);

    function updateCorpSubTier() {
        const amount = parseFloat(document.getElementById('corpSubAmount').value) || 0;
        let matched = null;
        for (let i = CORP_SUB_TIERS.length - 1; i >= 0; i--) {
            if (amount >= CORP_SUB_TIERS[i].min) { matched = CORP_SUB_TIERS[i]; break; }
        }
        document.getElementById('corpSubTier').value = matched ? matched.key : '';
        updateTracker('corp-tracker', 'corp-fill', amount, CORP_SUB_THRESHOLDS);
        updateRewardsPanel('corp-rewards', 'corp-nudge', matched, amount, CORP_SUB_TIERS);
        const shirtSection = document.getElementById('corp-shirt-section');
        renderShirtSelectors(shirtSection, matched ? matched.shirts : [], 'corpShirtSize');
    }
    </script>
</body>
</html>