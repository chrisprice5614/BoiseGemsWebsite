                            <p>Choose your monthly sponsorship amount and see your rewards. All sponsorships are tax deductible.</p>
                        </div>
                    </div>

                    <div class="dn-donate-card">
                        <form id="sub-form-corporate" action="/donate/subscribe" method="POST">
                            <input type="hidden" name="tier" id="corpSubTier" value="" />
                            <input type="hidden" name="fanType" value="corporate" />
                            <% if (typeof user === 'undefined' || !user) { %>
                            <div class="dn-guest-contact">
                                <div><label for="corpDonorEmail">Your Email</label><input type="email" name="donorEmail" id="corpDonorEmail" required placeholder="email@website.com"></div>
                                <div><label for="corpDonorName">Your Name</label><input type="text" name="donorName" id="corpDonorName" required placeholder="First and Last Name"></div>
                            </div>
                            <% } %>

                            <label style="font-weight:700; font-size:1.05rem; margin-bottom:10px;">Monthly Sponsorship Amount</label>
                            <div class="dn-amount-group">
                                <span class="dn-currency">$</span>
                                <input type="number" name="monthlyAmount" id="corpSubAmount" step="0.01" min="1" max="999999" required oninput="updateCorpSubTier()" />
                                <span class="dn-per-month">/month</span>
                            </div>

                            <div class="tier-tracker" id="corp-tracker">
                                <div class="tt-fill" id="corp-fill"></div>
                                <div class="tt-step" data-min="100">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Bronze<span>$100</span></div>
                                </div>
                                <div class="tt-step" data-min="500">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Silver<span>$500</span></div>
                                </div>
                                <div class="tt-step" data-min="1000">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Gold<span>$1,000</span></div>
                                </div>
                                <div class="tt-step" data-min="2500">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Platinum<span>$2,500</span></div>
                                </div>
                                <div class="tt-step" data-min="5000">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Star Garnet<span>$5,000</span></div>
                                </div>
                            </div>

                            <div id="corp-rewards" class="rewards-panel rp-none">
