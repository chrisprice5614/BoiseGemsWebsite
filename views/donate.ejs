                                <p class="rp-placeholder">Enter an amount above to see your sponsorship rewards.</p>
                            </div>

                            <div id="corp-nudge" class="next-tier-nudge" style="display:none;"></div>

                            <div id="corp-shirt-section" style="margin-bottom: 14px;"></div>

                            <p style="font-size:.85rem; color:#777; margin-bottom:12px; font-style:italic;">
                                If additional information is needed (e.g. corporate logos), you will receive an email with further instructions.
                            </p>
                            <p class="dn-fee-note">A processing fee is added to all transactions.</p>
                            <button type="submit" class="dn-submit">Start Subscription</button>
                        </form>
                    </div>

                <% } else { %>
                    <div class="dn-section-header">
                        <img src="/img/photos/boise-gems-05.jpg" alt="Members performing" />
                        <div class="dn-sh-text">
                            <h2>Individual Sponsorship &ndash; Monthly</h2>
                            <p>Choose your monthly contribution and see your rewards. All sponsorships are tax deductible.</p>
                        </div>
                    </div>

                    <div class="dn-donate-card">
                        <form id="sub-form-individual" action="/donate/subscribe" method="POST">
                            <input type="hidden" name="tier" id="indSubTier" value="" />
                            <input type="hidden" name="fanType" value="individual" />
                            <% if (typeof user === 'undefined' || !user) { %>
                            <div class="dn-guest-contact">
                                <div><label for="indDonorEmail">Your Email</label><input type="email" name="donorEmail" id="indDonorEmail" required placeholder="email@website.com"></div>
                                <div><label for="indDonorName">Your Name</label><input type="text" name="donorName" id="indDonorName" required placeholder="First and Last Name"></div>
                            </div>
                            <% } %>

                            <label style="font-weight:700; font-size:1.05rem; margin-bottom:10px;">Monthly Amount</label>
                            <div class="dn-amount-group">
                                <span class="dn-currency">$</span>
                                <input type="number" name="monthlyAmount" id="indSubAmount" step="0.01" min="1" max="999999" required oninput="updateIndSubTier()" />
                                <span class="dn-per-month">/month</span>
                            </div>

                            <div class="tier-tracker" id="ind-tracker">
                                <div class="tt-fill" id="ind-fill"></div>
                                <div class="tt-step" data-min="10">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Bronze<span>$10</span></div>
                                </div>
                                <div class="tt-step" data-min="25">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Silver<span>$25</span></div>
                                </div>
                                <div class="tt-step" data-min="50">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Gold<span>$50</span></div>
                                </div>
                                <div class="tt-step" data-min="75">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Platinum<span>$75</span></div>
                                </div>
                                <div class="tt-step" data-min="100">
                                    <div class="tt-dot"></div>
                                    <div class="tt-label">Star Garnet<span>$100</span></div>
                                </div>
                            </div>

                            <div id="ind-rewards" class="rewards-panel rp-none">
                                <h4>Your Rewards</h4>
                                <p class="rp-placeholder">Enter an amount above to see your tier rewards.</p>
                            </div>

                            <div id="ind-nudge" class="next-tier-nudge" style="display:none;"></div>

                            <div id="ind-shirt-section" style="margin-bottom: 14px;"></div>

                            <p class="dn-fee-note">A processing fee is added to all transactions.</p>
                            <button type="submit" class="dn-submit">Start Subscription</button>
