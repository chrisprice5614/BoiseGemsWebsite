<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Form | Boise Gems</title>
  <%- include("includes/head") %>
  <link rel="stylesheet" href="/css/form-wizard.css">
</head>
<body>
<header><%- include("includes/header") %></header>
<main class="form-wizard">
  <h1 style="text-align:center;">Edit form</h1>
  <p style="text-align:center;color:#6b5585;">Update the details below. Drag boxes on the PDF to change where people fill in or sign.</p>

  <form id="editFormWizard" action="/edit-form/<%= form.id %>" method="POST" enctype="multipart/form-data" class="form-wizard__step is-active" style="display:block;margin-top:20px;">
    <input type="hidden" name="fields_json" id="fieldsJson" value="[]">

    <label for="title"><strong>Form name</strong></label>
    <input type="text" name="title" id="title" value="<%= form.title %>" required>
    <br><br>

    <label for="description"><strong>Description</strong></label>
    <textarea name="description" id="description" required><%= form.description %></textarea>
    <br>

    <p><strong>Current PDF:</strong>
      <% if (form.document_path) { %>
        <a href="<%= form.document_path %>" target="_blank" rel="noopener">Open current PDF</a>
      <% } else { %>
        (none)
      <% } %>
    </p>

    <label for="wizardPdf"><strong>Replace PDF (optional)</strong></label>
    <input type="file" id="wizardPdf" name="document_path" accept="application/pdf">
    <p style="color:#6b5585;font-size:0.95rem;">If you upload a new PDF, place the fill-in boxes again below.</p>

    <div class="fw-pdf-shell">
      <div class="fw-pdf-layout">
        <div class="fw-pdf-pages" id="wizardPdfPages">
          <p style="text-align:center;padding:24px;color:#6b5585;margin:0;">Loading…</p>
        </div>
        <aside class="fw-tools fw-tools--float" id="wizardTools">
          <p class="fw-tools__hint">Choose a field type</p>
          <button type="button" data-field-type="text">Text</button>
          <button type="button" data-field-type="signature">Signature</button>
          <button type="button" data-field-type="date">Date</button>
          <button type="button" data-field-type="initials">Initials</button>
          <button type="submit" class="fw-tools__save">Save changes</button>
        </aside>
      </div>
    </div>
    <div class="fw-field-list" id="wizardFieldList"></div>
    <br>

    <h2 style="font-size:1.2rem;">Who needs to sign?</h2>
    <div class="form-wizard__checks">
      <label class="form-wizard__check"><input type="checkbox" name="audience_corps" value="1" <%= form.audience_corps ? "checked" : "" %>> Corps</label>
      <label class="form-wizard__check"><input type="checkbox" name="audience_independent" value="1" <%= form.audience_independent ? "checked" : "" %>> Independent</label>
      <label class="form-wizard__check"><input type="checkbox" name="audience_affiliate" value="1" <%= form.audience_affiliate ? "checked" : "" %>> Affiliate</label>
      <label class="form-wizard__check"><input type="checkbox" name="audience_staff" value="1" <%= form.audience_staff ? "checked" : "" %>> Staff</label>
    </div>

    <label for="due_date"><strong>Due date</strong></label>
    <input type="date" name="due_date" id="due_date"
           value="<%= form.due_date ? new Date(form.due_date).toISOString().slice(0,10) : '' %>">
    <br><br>
    <label for="expire_date"><strong>Expiration date</strong></label>
    <input type="date" name="expire_date" id="expire_date"
           value="<%= form.expire_date ? new Date(form.expire_date).toISOString().slice(0,10) : '' %>">
    <br><br>

    <div style="text-align:center;">
      <button type="submit" class="button">Save changes</button>
    </div>
  </form>
</main>
<footer><%- include("includes/footer") %></footer>
<script>
  window.__EDIT_FORM_BOOT__ = {
    pdfUrl: <%- JSON.stringify(form.document_path || "") %>,
    fields: <%- form.fields_json || "[]" %>
  };
</script>
<script type="module" src="/js/form-wizard.js"></script>
<script type="module">
  const boot = window.__EDIT_FORM_BOOT__ || { pdfUrl: "", fields: [] };
  function start() {
    if (!window.FormWizardPlacer) {
      setTimeout(start, 40);
      return;
    }
    const placer = window.FormWizardPlacer.createPlacer({
      fileInput: document.getElementById("wizardPdf"),
      pagesEl: document.getElementById("wizardPdfPages"),
      toolsEl: document.getElementById("wizardTools"),
      listEl: document.getElementById("wizardFieldList"),
      fieldsInput: document.getElementById("fieldsJson"),
      initialFields: Array.isArray(boot.fields) ? boot.fields : [],
    });
    if (boot.pdfUrl) placer.renderPdfFromUrl(boot.pdfUrl);
    const form = document.getElementById("editFormWizard");
    form.addEventListener("submit", function () {
      document.getElementById("fieldsJson").value = JSON.stringify(placer.getFields());
    });
  }
  start();
</script>
</body>
</html>
