<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <h1 style="text-align: center;">Edit Forms</h1>
        <br>
        <div style="text-align: center;">
            <a href="/add-form"><button>Add Form</button></a>
        </div>
        <div style="padding: 8px;">
            <% if(forms.length > 0) { %>
                <% forms.forEach(form => { %>
                    <div class="card">
                        <div style="display: grid; grid-template-columns: 2fr 1fr;">
                            <h3><%= form.title %></h3>
                            <div>
                                <div style="text-align: right;">
                                    <% if(form.document_path) { %>
                                    
                                        <a href="<%= form.document_path %>" target="_blank" style="margin-right: 24px; font-size: 1.5rem;"><ion-icon name="document-text-outline"></ion-icon></a>
                                        <button class="confirm-btn" next="/delete-form/<%= form.id %>">Delete Form</button>
                                    <% } %>
                                </div>
                            </div>
                            <div>
                                Due: <%= new Date(form.due_date + 86400000).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %>
                            </div>
                            <div></div>
                            <div>
                                Expires: <%= new Date(form.expire_date + 86400000).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) %>
                            </div>
                        </div>
                        <hr>
                        <p><%= form.description %></p>
                        
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>