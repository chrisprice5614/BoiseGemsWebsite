<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <h1 style="text-align: center;">Edit Forms</h1>
        <br>
        <div style="text-align: center;">
            <a href="/add-form"><button>Add Form</button></a>
        </div>
        <div style="padding: 8px;">
            <% if(forms.length > 0) { %>
                <% forms.forEach(form => { %>
                    <div class="card">
                        <h3><%= form.title %></h3>
                        <hr>
                        <p><%= form.description %></p>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>