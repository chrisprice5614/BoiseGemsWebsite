<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems | Edit Users</title>
    <%- include("includes/head") %>
    <% if(typeof search === "undefined") search = ""%>
    <% if(typeof filter === "undefined") filter = "all"%>

    <% pagination = `
    <div style="display: grid; grid-template-columns: 1fr 5fr 1fr; text-align: center;">
                <div>
                    `
                    if(page > 1)
                    {
                        pagination += `
                        <a href="/edit-users?search=${search}&filter=${filter}&page=${Number(page)-1}"><button><</button></a>
                        `
                    }
                    
                    pagination+=
                `
                </div>
                <div>
                    `

                    for(let i = 0; i < totalPages; i++){
                        var style
                        page == i+1 ? style = 'style="font-weight: 700; color: var(--tertiary-color);"' : style =''
                        pagination +=
                        `
                        <a href="/edit-users?search=${search}&filter=${filter}&page=${Number(i+1)}" ${style}> ${Number(i+1)}</a>`
                    }

                    pagination+=`
                </div>
                <div>
                `
                if(page < totalPages)
                {
                    pagination +=`
                    
                        <a href="/edit-users?search=${search}&filter=${filter}&page=${Number(page)+1}"><button>></button></a>
                        `
                    
                }
                    pagination +=    `
                </div>
            </div>
    ` %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <div style="padding: 8px;">
            <h1 style="text-align: center;">Edit Users</h1>
            <br>
            <form action="/edit-users">
                <p style="text-align: center;">Search Users</p>
                <div style="display: grid; grid-template-columns: 2fr 1fr;">
                    <div>
                        <label for="search">Name Search</label>
                        <input type="text" name="search" value="<%= search %>"/>
                    </div>
                    <div>
                        <label for="filter">Filter</label>
                        <select name="filter" value="">
                            <option value="all">All</option>
                            <option value="brass" <% if(filter == "brass") { %> selected="selected" <% } %>>Brass</option>
                            <option value="drumline" <% if(filter == "drumline") { %> selected="selected" <% } %>>Drumline</option>
                            <option value="front ensemble" <% if(filter == "front ensemble") { %> selected="selected" <% } %>>Front Ensemble</option>
                            <option value="guard" <% if(filter == "guard") { %> selected="selected" <% } %>>Guard</option>
                            <option value="drum major" <% if(filter == "drum major") { %> selected="selected" <% } %>>Drum Major</option>
                            <option value="staff" <% if(filter == "staff") { %> selected="selected" <% } %>>Staff</option>
                            <option value="parent" <% if(filter == "parent") { %> selected="selected" <% } %>>Parent</option>
                        </select>
                    </div>
                </div>
                <br>
                <div style="padding-left: 2.5%;">
                    <button >Search</button>
                </div>
            </form>
            <br>
            <%- pagination %>
            <br>
            <% if(users.length > 0) { %>
                <% users.forEach(thisUser => { if(1==1){ %>
                    <div class="card">
                        <div class="triple-to-single triple-to-single-mod " style="align-items: center;">
                            <div style="align-items: center;">
                                <input type="checkbox">
                                <span style="text-transform: capitalize;"><b><%= thisUser.firstname %> <%= thisUser.lastname %> <% if(thisUser.parent) { %> 👨‍👩‍👧‍👦 Parent/Guardian <% } else if(thisUser.admin) { %> 🧑‍💼 Admin <% } else if(thisUser.staff) { %> 🧑‍🏫 Staff <% } else { %> 👟 Member <% } %></b></span>
                            </div>
                            <div>
                                <a href="/change-account-type/<%= thisUser.id %>">Change Account Type</a>
                            </div>
                            <div>
                                <a href="/change-email/<%= thisUser.id %>">Change Email</a>
                            </div>
                            
                        </div>
                        <hr>
                        <div style="text-align: center;">
                            <button class="expand-button">—</button>
                        </div>
                        <div class="user-expand">
                            <br>
                            <div class="triple-to-single triple-to-single-mod">
                                <div>
                                    <p><b>Email: </b><span onclick="copyText(this)"><%= thisUser.email %></span></p>
                                    <p><b>Birthday: </b><%= new Date(thisUser.birthday + 86400000).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" }) %></p>
                                    <p><b>Age: </b><%= Math.floor((Date.now() - thisUser.birthday) / 31557600000) %></p>
                                </div>
                                <div>
                                    <p><b>Verified: </b><% if(thisUser.verified) { %> ✅ <% } else { %> ❌ <% } %></p>
                                </div>
                                <div>
                                    <a href="/send-message/<%= thisUser.id %>">Send Email</a>
                                </div>
                            </div>
                            <div class="triple-to-single triple-to-single-mod">
                                <div>
                                    <p><b>Section: </b><span><%= thisUser.section %></span></p>
                                </div>
                                <div>
                                    <p><b>Instrument/Role: </b><%= thisUser.instrument %></p>
                                </div>
                                <div>
                                    <a href="/edit-section/<%= thisUser.id %>">Change Section/Role</a>
                                </div>
                            </div>
                            <div class="triple-to-single triple-to-single-mod">
                                <div>
                                    <p><b>Due: </b><span><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(thisUser.owed / 100) %></span></p>
                                </div>
                                <div>
                                    <p><b>Paid: </b><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(thisUser.paid / 100) %></p>
                                </div>
                                <div>
                                    <a href="/transaction-edit/<%= thisUser.id %>">View/Add Transactions</a>
                                </div>
                            </div>
                            <div class="triple-to-single triple-to-single-mod">
                                <div>
                                    <p><b>Contracted Corps: </b><% if(thisUser.contractedCorps) { %> ✅ <% } else { %> ❌ <% } %></p>
                                </div>
                                <div>
                                    <a href="/extend-contract/<%= thisUser.id %>">Extend Contract</a>
                                </div>
                                <div>
                                    <a href="/change-membership/<%= thisUser.id %>">Change Membership</a>
                                </div>
                            </div>
                            <div class="triple-to-single triple-to-single-mod">
                                <div>
                                    <p><b>Contracted Independent: </b><% if(thisUser.contractedIndependent) { %> ✅ <% } else { %> ❌ <% } %></p>
                                </div>
                            </div>
                            <div class="triple-to-single triple-to-single-mod">
                                <div>
                                    <p><b>All Forms Uploaded?: </b><% if(thisUser.allForms) { %> ✅ <% } else { %> ❌ <% } %></p>
                                </div>
                                <div>
                                    
                                </div>
                                <div>
                                    <a href="/view-forms/<%= thisUser.id %>">View Forms</a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }}) %>
            <% } %>
            <br>
            <%- pagination %>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
<script>
    document.addEventListener("DOMContentLoaded", function(event) {
        var scrollpos = localStorage.getItem("scrollpos")
        if(scrollpos) window.scrollTo(0, scrollpos)
    })

    window.onbeforeunload = function(e) {
        localStorage.setItem('scrollpos', window.scrollY)
    }
</script>
<script>
    const buttons = document.querySelectorAll('.expand-button')
    const userData = document.querySelectorAll('.user-expand')

    let iteration = 0;

    buttons.forEach(button => {
        button.setAttribute(`onclick`,`expand(${iteration})`)
        iteration++;
    })

    function expand(selection){

        const isExpanded = userData[selection].classList.contains('active')

        if(isExpanded){
            userData[selection].classList.remove('active')
        } else {
            userData[selection].classList.add('active')
        }
    }
</script>
</html>