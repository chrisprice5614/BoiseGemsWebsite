<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Boise Gems | Edit Users</title>
  <%- include("includes/head") %>

  <% // sane defaults so the template never crashes %>
  <% const q       = typeof search === "string" ? search : ""; %>
  <% const section = typeof filter === "string" ? filter : "all"; %>
  <% const memberf = typeof membership === "string" ? membership : "all"; %>
  <% const sortf   = typeof sort === "string" ? sort : "section"; %>
  <% const daysf   = typeof days === "string" ? days : "all"; %>
  <% const p       = Number(page || 1); %>
  <% const pages   = Math.max(1, Number(totalPages || 1)); %>
</head>
<body>
<header>
  <%- include("includes/header") %>
</header>

<main>
  <br/>
  <div style="padding: 8px;">
    <h1 style="text-align:center;">Edit Users</h1>
    <br/>

    <!-- Search / Filters -->
    <form action="/edit-users" method="GET">
      <p style="text-align:center;">Search Users</p>
      <div style="display:grid; grid-template-columns: 2fr 1fr 1fr; gap:8px;">
        <div>
          <label for="search">Name Search</label>
          <input type="text" id="search" name="search" value="<%= q %>" />
        </div>

        <div>
          <label for="filter">Section</label>
          <select id="filter" name="filter">
            <option value="all" <%= section==="all" ? "selected" : "" %>>All</option>
            <option value="brass" <%= section==="brass" ? "selected" : "" %>>Brass</option>
            <option value="drumline" <%= section==="drumline" ? "selected" : "" %>>Drumline</option>
            <option value="front ensemble" <%= section==="front ensemble" ? "selected" : "" %>>Front Ensemble</option>
            <option value="guard" <%= section==="guard" ? "selected" : "" %>>Guard</option>
            <option value="drum major" <%= section==="drum major" ? "selected" : "" %>>Drum Major</option>
            <option value="staff" <%= section==="staff" ? "selected" : "" %>>Staff</option>
            <option value="parent" <%= section==="parent" ? "selected" : "" %>>Parent</option>
          </select>
        </div>

        <div>
          <label for="membership">Membership</label>
          <select id="membership" name="membership">
            <option value="all" <%= memberf==="all" ? "selected" : "" %>>All</option>
            <option value="corps" <%= memberf==="corps" ? "selected" : "" %>>Corps</option>
            <option value="independent" <%= memberf==="independent" ? "selected" : "" %>>Independent</option>
            <option value="affiliate" <%= memberf==="affiliate" ? "selected" : "" %>>Affiliate</option>
          </select>
        </div>
      </div>

      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-top:8px;">
        <div>
          <label for="sort-select">Sort By</label>
          <select id="sort-select" name="sort">
            <option value="section" <%= sortf==="section" ? "selected" : "" %>>By Section</option>
            <option value="newest" <%= sortf==="newest" ? "selected" : "" %>>Newest Members</option>
            <option value="oldest" <%= sortf==="oldest" ? "selected" : "" %>>Oldest Members</option>
          </select>
        </div>

        <div>
          <label for="days-select">Joined Within</label>
          <select id="days-select" name="days">
            <option value="all" <%= daysf==="all" ? "selected" : "" %>>All Time</option>
            <option value="30" <%= daysf==="30" ? "selected" : "" %>>Last 30 Days</option>
            <option value="60" <%= daysf==="60" ? "selected" : "" %>>Last 60 Days</option>
            <option value="90" <%= daysf==="90" ? "selected" : "" %>>Last 90 Days</option>
          </select>
        </div>
      </div>
      <br/>
    </form>

    <br/>

    <div id="results-area">

    <!-- Pagination (Top) -->
    <div style="display:grid; grid-template-columns: 1fr 5fr 1fr; text-align:center;">
      <div>
        <% if (p > 1) { %>
          <a href="/edit-users?search=<%= encodeURIComponent(q) %>&filter=<%= encodeURIComponent(section) %>&membership=<%= encodeURIComponent(memberf) %>&sort=<%= encodeURIComponent(sortf) %>&days=<%= encodeURIComponent(daysf) %>&page=<%= p-1 %>">
            <button>&lt;</button>
          </a>
        <% } %>
      </div>
      <div>
        <% for (let i = 1; i <= pages; i++) { %>
          <a href="/edit-users?search=<%= encodeURIComponent(q) %>&filter=<%= encodeURIComponent(section) %>&membership=<%= encodeURIComponent(memberf) %>&sort=<%= encodeURIComponent(sortf) %>&days=<%= encodeURIComponent(daysf) %>&page=<%= i %>"
             <%= p===i ? 'style="font-weight:700; color: var(--tertiary-color);"' : "" %>>
            <%= i %>
          </a>
        <% } %>
      </div>
      <div>
        <% if (p < pages) { %>
          <a href="/edit-users?search=<%= encodeURIComponent(q) %>&filter=<%= encodeURIComponent(section) %>&membership=<%= encodeURIComponent(memberf) %>&sort=<%= encodeURIComponent(sortf) %>&days=<%= encodeURIComponent(daysf) %>&page=<%= p+1 %>">
            <button>&gt;</button>
          </a>
        <% } %>
      </div>
    </div>

    <br/>

    <!-- Results -->
    <% if (Array.isArray(users) && users.length > 0) { %>
      <% users.forEach((thisUser, idx) => { %>
        <div class="card">
          <div class="triple-to-single triple-to-single-mod" style="align-items:center;">
            <div style="align-items:center;">
              <input type="checkbox" />
              <span style="text-transform:capitalize;">
                <b>
                  <%= thisUser.firstname %> <%= thisUser.lastname %>
                  <% if (thisUser.parent) { %> 👨‍👩‍👧‍👦 Parent/Guardian
                  <% } else if (thisUser.admin) { %> 🧑‍💼 Admin
                  <% } else if (thisUser.staff) { %> 🧑‍🏫 Staff
                  <% } else { %> 👟 Member <% } %>
                </b>
              </span>
            </div>
            <div>
              <a href="/change-account-type/<%= thisUser.id %>">Change Account Type</a>
            </div>
            <div>
              <a href="/change-email/<%= thisUser.id %>">Change Email</a>
            </div>
          </div>

          <hr/>

          <% if (thisUser.linkedParents && thisUser.linkedParents.length) { %>
            <p style="text-align:center;margin:8px 0 0;font-size:0.9rem;">
              <b>Linked parent<%= thisUser.linkedParents.length === 1 ? '' : 's' %>:</b>
              <%= thisUser.linkedParents.map(function(p) { return p.firstname + ' ' + p.lastname; }).join(', ') %>
            </p>
          <% } else if (thisUser.linkedChildren && thisUser.linkedChildren.length) { %>
            <p style="text-align:center;margin:8px 0 0;font-size:0.9rem;">
              <b>Linked member<%= thisUser.linkedChildren.length === 1 ? '' : 's' %>:</b>
              <%= thisUser.linkedChildren.map(function(c) { return c.firstname + ' ' + c.lastname; }).join(', ') %>
            </p>
          <% } %>

          <div style="text-align:center;">
            <button class="expand-button" data-target="<%= idx %>">More...</button>
          </div>

          <div class="user-expand" id="user-expand-<%= idx %>">
            <br/>
            <div style="text-align: center;">
              <div>
                <div class="image-wrapper" style="text-align: center; width: 33%;">
                    <% const srcImage = thisUser.img == null ? "/img/ui/gem.png" : thisUser.img %>
                      <img src="<%= srcImage %>" alt="Member photo for <%= thisUser.firstname %> <%= thisUser.lastname %>">
                </div>
              </div>
            </div>
            <br>
            <div class="triple-to-single triple-to-single-mod">
              <div>
                <p><b>Email: </b><span onclick="copyText(this)"><%= thisUser.email %></span></p>
                <p><b>Phone: </b>
                  <% if (thisUser.phone) { %>
                    <span class="copy-phone" title="Click to copy"><%= thisUser.phone %></span>
                  <% } else { %>
                    <span style="color:#888;"> - </span>
                  <% } %>
                </p>
                <p><b>Birthday: </b><%= new Date(thisUser.birthday).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }) %></p>
                <p><b>Age: </b><%= Math.floor((Date.now() - thisUser.birthday) / 31557600000) %></p>
              </div>
              <div>
                <p><b>Verified: </b><%= thisUser.verified ? "✅" : "❌" %></p>
              </div>
              <div>
                <a href="/send-message/<%= thisUser.id %>">Send Email</a>
              </div>
            </div>

            <div class="triple-to-single triple-to-single-mod">
              <div>
                <p><b>Section: </b><span><%= thisUser.section %></span></p>
              </div>
              <div>
                <p><b>Instrument/Role: </b><%= thisUser.instrument %></p>
              </div>
              <div>
                <a href="/edit-section/<%= thisUser.id %>">Change Section/Role</a>
              </div>
            </div>

            <div class="triple-to-single triple-to-single-mod">
              <div>
                <p><b>Shirt Size: </b><%= thisUser.shirtSize || "Not chosen" %></p>
              </div>
              <div></div>
              <div></div>
            </div>

            <% if (thisUser.linkedParents && thisUser.linkedParents.length) { %>
            <div class="triple-to-single triple-to-single-mod">
              <div style="width:100%;">
                <p><b>Linked Parents / Guardians:</b></p>
                <ul style="margin:4px 0 0 1.2em;padding:0;">
                  <% thisUser.linkedParents.forEach(function(p) { %>
                    <li><%= p.firstname %> <%= p.lastname %> - <%= p.email %></li>
                  <% }); %>
                </ul>
              </div>
            </div>
            <% } else if (thisUser.linkedChildren && thisUser.linkedChildren.length) { %>
            <div class="triple-to-single triple-to-single-mod">
              <div style="width:100%;">
                <p><b>Linked Members:</b></p>
                <ul style="margin:4px 0 0 1.2em;padding:0;">
                  <% thisUser.linkedChildren.forEach(function(c) { %>
                    <li>
                      <%= c.firstname %> <%= c.lastname %>
                      <% if (c.section) { %> - <%= c.section %><% if (c.instrument) { %> / <%= c.instrument %><% } %><% } %>
                      - <%= c.email %>
                    </li>
                  <% }); %>
                </ul>
              </div>
            </div>
            <% } %>

            <div class="triple-to-single triple-to-single-mod">
              <div>
                <p><b>Due: </b>
                  <span><%= new Intl.NumberFormat('en-US', { style:'currency', currency:'USD' }).format((thisUser.owed||0) / 100) %></span>
                </p>
              </div>
              <div>
                <p><b>Paid: </b>
                  <%= new Intl.NumberFormat('en-US', { style:'currency', currency:'USD' }).format((thisUser.paid||0) / 100) %>
                </p>
              </div>
              <div>
                <a href="/transaction-edit/<%= thisUser.id %>">View/Add Transactions/Charges</a>
              </div>
            </div>

            <div class="triple-to-single triple-to-single-mod">
              <div>
                <p><b>Contracted Corps: </b><%= thisUser.contractedCorps ? "✅" : "❌" %></p>
              </div>
              <div>
                <a href="/extend-contract/<%= thisUser.id %>"><button style="background:#e6f4ea;border:1px solid #34a853;color:#1e6e2e;padding:6px 14px;border-radius:6px;cursor:pointer;font-weight:600;">Extend Contract</button></a>
              </div>
              <div>
                <a href="/change-membership/<%= thisUser.id %>">Change Membership</a>
              </div>
            </div>

            <div class="triple-to-single triple-to-single-mod">
              <div>
                <p><b>Contracted Independent: </b><%= thisUser.contractedIndependent ? "✅" : "❌" %></p>
              </div>
            </div>

            <div class="triple-to-single triple-to-single-mod">
              <div>
                <p><b>Contracted Affiliate: </b><%= thisUser.contractedAffiliate ? "✅" : "❌" %></p>
              </div>
            </div>

             <% if (thisUser.contracts && thisUser.contracts.length) { %>
              <div class="triple-to-single triple-to-single-mod">
                <div>
                  <p><b>Contracts on file:</b></p>
                  <ul style="margin: 4px 0 0 1em; padding: 0;">
                    <% thisUser.contracts.forEach(function(c) { %>
                      <li>
                        Season <%= c.season %> - <%= c.ensemble %>
                        <% if (c.signedContractPath) { %>
                          - 
                          <a href="/admin/contracts/<%= thisUser.id %>/<%= c.id %>" target="_blank" rel="noopener noreferrer">
                            View signed contract
                          </a>
                        <% } else { %>
                         - (no file uploaded)
                        <% } %>
                      </li>
                    <% }); %>
                  </ul>
                </div>
                <div></div>
                <div></div>
              </div>
            <% } %>

            <div class="triple-to-single triple-to-single-mod">
              <div>
                <p><b>All Forms Uploaded?: </b><%= thisUser.allForms ? "✅" : "❌" %></p>
              </div>
              <div></div>
              <div>
                <a href="/view-forms/<%= thisUser.id %>">View Forms</a><br/>
                <a href="/view-emergency/<%= thisUser.id %>">Emergency Contacts</a>
                <a href="/instruments/<%= thisUser.id %>">Instruments</a>
              </div>
            </div>

            <div style="margin-top:20px;padding-top:16px;border-top:1px solid #ddd;text-align:center;">
              <% if (thisUser.id !== user.userid) { %>
                <button type="button" class="delete-member-btn" data-user-id="<%= thisUser.id %>" data-user-name="<%= thisUser.firstname %> <%= thisUser.lastname %>" style="background:#fdeaea;border:1px solid #e57373;color:#b02020;padding:8px 16px;cursor:pointer;font-weight:600;">Delete Member</button>
              <% } else { %>
                <span style="color:#888;font-size:0.9rem;">You cannot delete your own account from this page.</span>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p style="text-align:center;">No users match your filters.</p>
    <% } %>

    <br/>

    <!-- Pagination (Bottom) -->
    <div style="display:grid; grid-template-columns: 1fr 5fr 1fr; text-align:center;">
      <div>
        <% if (p > 1) { %>
          <a href="/edit-users?search=<%= encodeURIComponent(q) %>&filter=<%= encodeURIComponent(section) %>&membership=<%= encodeURIComponent(memberf) %>&sort=<%= encodeURIComponent(sortf) %>&days=<%= encodeURIComponent(daysf) %>&page=<%= p-1 %>">
            <button>&lt;</button>
          </a>
        <% } %>
      </div>
      <div>
        <% for (let i = 1; i <= pages; i++) { %>
          <a href="/edit-users?search=<%= encodeURIComponent(q) %>&filter=<%= encodeURIComponent(section) %>&membership=<%= encodeURIComponent(memberf) %>&sort=<%= encodeURIComponent(sortf) %>&days=<%= encodeURIComponent(daysf) %>&page=<%= i %>"
             <%= p===i ? 'style="font-weight:700; color: var(--tertiary-color);"' : "" %>>
            <%= i %>
          </a>
        <% } %>
      </div>
      <div>
        <% if (p < pages) { %>
          <a href="/edit-users?search=<%= encodeURIComponent(q) %>&filter=<%= encodeURIComponent(section) %>&membership=<%= encodeURIComponent(memberf) %>&sort=<%= encodeURIComponent(sortf) %>&days=<%= encodeURIComponent(daysf) %>&page=<%= p+1 %>">
            <button>&gt;</button>
          </a>
        <% } %>
      </div>
    </div>

    </div><!-- /#results-area -->
  </div>
</main>

<footer>
  <%- include("includes/footer") %>
</footer>

<script>
  // ── Toast ──────────────────────────────────────────────────────────────
  (function(){
    let t = document.getElementById('copy-toast');
    if (!t) {
      t = document.createElement('div');
      t.id = 'copy-toast';
      t.style.cssText = 'position:fixed;left:50%;bottom:24px;transform:translateX(-50%);'
        + 'padding:10px 16px;background:rgba(0,0,0,0.8);color:#fff;border-radius:8px;'
        + 'font-size:14px;box-shadow:0 2px 6px rgba(0,0,0,0.3);z-index:9999;'
        + 'opacity:0;pointer-events:none;transition:opacity 200ms ease;';
      document.body.appendChild(t);
    }
    window.showToast = function(msg){
      t.textContent = msg;
      t.style.opacity = '1';
      clearTimeout(t._hideTimer);
      t._hideTimer = setTimeout(()=>{ t.style.opacity = '0'; }, 1500);
    };
  })();

  // Copy helper
  function copyText(node) {
    const text = node.textContent || node.innerText || "";
    navigator.clipboard.writeText(text).catch(()=>{});
  }

  // ── Re-attach interactive behaviours after every results swap ──────────
  function initResults() {
    // Expand/Collapse
    document.querySelectorAll('.expand-button').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-target');
        const el = document.getElementById('user-expand-' + id);
        if (!el) return;
        el.classList.toggle('active');
      });
    });

    // Copy phone
    document.querySelectorAll('.copy-phone').forEach(el => {
      el.style.cursor = 'pointer';
      el.addEventListener('click', () => {
        navigator.clipboard.writeText(el.textContent || '').then(
          () => showToast('Phone copied to clipboard'),
          () => showToast('Unable to copy')
        );
      });
    });

    // Delete member (double confirmation)
    document.querySelectorAll('.delete-member-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-user-id');
        const name = btn.getAttribute('data-user-name') || 'this member';
        if (!id) return;
        bgConfirm(
          'Delete ' + name + '? This permanently removes their account and related records. This cannot be undone.',
          function() {
            bgConfirm(
              'Final confirmation: permanently delete ' + name + '?',
              function() {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/admin/delete-user/' + id;
                document.body.appendChild(form);
                form.submit();
              }
            );
          }
        );
      });
    });

    // Pagination links → instant fetch instead of full reload
    document.querySelectorAll('#results-area a[href]').forEach(a => {
      a.addEventListener('click', e => {
        const href = a.getAttribute('href');
        if (!href || !href.startsWith('/edit-users')) return;
        e.preventDefault();
        const params = new URL(href, window.location.origin).searchParams;
        currentPage = parseInt(params.get('page') || '1', 10);
        // sync controls with whatever the link carries
        document.getElementById('search').value         = params.get('search')     || '';
        document.getElementById('filter').value         = params.get('filter')     || 'all';
        document.getElementById('membership').value     = params.get('membership') || 'all';
        document.getElementById('sort-select').value    = params.get('sort')       || 'section';
        document.getElementById('days-select').value    = params.get('days')       || 'all';
        doFetch();
      });
    });
  }

  // ── Instant-search core ────────────────────────────────────────────────
  let currentPage = <%= p %>;
  let debounceTimer = null;

  async function doFetch() {
    const searchVal     = document.getElementById('search').value;
    const filterVal     = document.getElementById('filter').value;
    const membershipVal = document.getElementById('membership').value;
    const sortVal       = document.getElementById('sort-select').value;
    const daysVal       = document.getElementById('days-select').value;

    const url = new URL('/edit-users', window.location.origin);
    url.searchParams.set('search',     searchVal);
    url.searchParams.set('filter',     filterVal);
    url.searchParams.set('membership', membershipVal);
    url.searchParams.set('sort',       sortVal);
    url.searchParams.set('days',       daysVal);
    url.searchParams.set('page',       currentPage);

    // Update address bar without reloading
    history.replaceState(null, '', url.pathname + url.search);

    try {
      const resp = await fetch(url);
      const html  = await resp.text();
      const doc   = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.getElementById('results-area');
      if (fresh) {
        document.getElementById('results-area').replaceWith(fresh);
        initResults();
      }
    } catch(err) {
      console.error('Search fetch failed', err);
    }
  }

  function onFilterChange() {
    currentPage = 1;
    clearTimeout(debounceTimer);
    doFetch();
  }

  function onSearchInput() {
    currentPage = 1;
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(doFetch, 300);
  }

  // Prevent form from doing a page-reload
  document.querySelector('form[action="/edit-users"]').addEventListener('submit', e => {
    e.preventDefault();
    onFilterChange();
  });

  document.getElementById('search').addEventListener('input', onSearchInput);
  document.getElementById('filter').addEventListener('change', onFilterChange);
  document.getElementById('membership').addEventListener('change', onFilterChange);
  document.getElementById('sort-select').addEventListener('change', onFilterChange);
  document.getElementById('days-select').addEventListener('change', onFilterChange);

  // Wire up the initial set of results
  initResults();
</script>
</body>
</html>
