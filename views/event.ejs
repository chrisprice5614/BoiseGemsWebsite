<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= meta?.title || (event.title + " — Boise Gems") %></title>
  <%- include("includes/head") %>

  <% if (meta) { %>
    <meta name="description" content="<%= meta.description %>">
    <link rel="canonical" href="<%= meta.url %>">
    <meta property="og:type" content="event">
    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.description %>">
    <meta property="og:url" content="<%= meta.url %>">
    <% if (meta.image) { %>
      <meta property="og:image" content="<%= meta.image %>">
      <meta name="twitter:image" content="<%= meta.image %>">
    <% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= meta.title %>">
    <meta name="twitter:description" content="<%= meta.description %>">
  <% } %>

  <style>
    .share-row{ display:flex; align-items:center; gap:10px; margin:16px 0 10px; }
    .share-label{ font-weight:700; letter-spacing:.02em; }
    .share-ico{
      display:inline-flex; align-items:center; justify-content:center;
      width:36px; height:36px; border-radius:999px;
      background:#121318; border:1px solid #2a2c33; color:#e9eaee;
      text-decoration:none; cursor:pointer; transition:transform .12s ease, box-shadow .12s ease;
    }
    .share-ico:hover{ transform: translateY(-1px); box-shadow:0 6px 14px rgba(0,0,0,.35); }
    .share-ico ion-icon{ font-size:18px; }
    #share-copy.copied{ outline:2px solid #43a047; }
  </style>
</head>
<body>
<header>
  <%- include("includes/header") %>
</header>

<main>
  <%
    // Determine if the event has passed by more than 1 hour.
    // Use endtime if present; otherwise use start time.
    const startMs  = new Date(event.datetime).getTime();
    const endMs    = event.endtime ? new Date(event.endtime).getTime() : startMs;
    const cutoffMs = endMs + 60 * 60 * 1000; // +1 hour after end (or start if no end)
    const isPast   = Date.now() > cutoffMs;

    const dtStart = new Date(event.datetime);
    const hasEnd  = !!event.endtime;
    const dtEnd   = hasEnd ? new Date(event.endtime) : null;

    const sharePlainUrl = (meta && meta.url) ? meta.url : ('https://boisegems.org/event/' + event.slug);
    const shareUrl = encodeURIComponent(sharePlainUrl);
    const shareText = encodeURIComponent(event.title);
  %>

  <% if (isPast) { %>
    <div style="background:#ffe8e8; color:#b00020; padding:10px 12px; margin:8px; border:1px solid #f5c2c7; border-radius:10px; font-weight:600; text-align:center;">
      This event has passed. RSVP is closed.
    </div>
  <% } %>

  <div style="width: 100%; aspect-ratio: 16/4.5; background-image: url('/img/publicupload/<%= event.image %>'); background-position: center; background-size: cover;"></div>

  <!-- Share row -->
  <section style="padding: 8px;">
    <div class="share-row">
      <span class="share-label">Share:</span>

      <!-- Copy link -->
      <a id="share-copy" href="#" class="share-ico" rel="noopener" title="Copy link" aria-label="Copy link">
        <ion-icon name="link-outline"></ion-icon>
      </a>

      <!-- Facebook -->
      <a class="share-ico" target="_blank" rel="noopener"
         href="https://www.facebook.com/sharer/sharer.php?u=<%= shareUrl %>"
         title="Share on Facebook" aria-label="Share on Facebook">
        <ion-icon name="logo-facebook"></ion-icon>
      </a>

      <!-- X (Twitter) -->
      <a class="share-ico" target="_blank" rel="noopener"
         href="https://twitter.com/intent/tweet?url=<%= shareUrl %>&text=<%= shareText %>"
         title="Share on X" aria-label="Share on X">
        <ion-icon name="logo-twitter"></ion-icon>
      </a>

      <!-- Reddit -->
      <a class="share-ico" target="_blank" rel="noopener"
         href="https://www.reddit.com/submit?url=<%= shareUrl %>&title=<%= shareText %>"
         title="Share on Reddit" aria-label="Share on Reddit">
        <ion-icon name="logo-reddit"></ion-icon>
      </a>

      <!-- Email -->
      <a class="share-ico"
         href="mailto:?subject=<%= shareText %>&body=<%= sharePlainUrl %>"
         title="Share via Email" aria-label="Share via Email">
        <ion-icon name="mail-outline"></ion-icon>
      </a>
    </div>
  </section>

  <div style="padding: 8px;">
    <span class="pill"><%= event.type %></span>
    <br>
    <h1 style="text-align: left;">
      <%= event.title %>
      <% if(event.cost > 0) { %>
        <span style="color: rgb(14, 145, 14)"><%= (event.cost).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %></span>
      <% } %>
    </h1>
    <br>

    <!-- Date / time range -->
    <small>
      <%= dtStart.toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' }) %> •
    </small>
    <small>
      <%= dtStart.toLocaleTimeString('en-US', { hour:'numeric', minute:'2-digit', hour12:true }) %>
    </small>
    <% if (dtEnd && dtEnd > dtStart) { %>
      <small> - <%= dtEnd.toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' }) %> • </small>
      <small><%= dtEnd.toLocaleTimeString('en-US', { hour:'numeric', minute:'2-digit', hour12:true }) %></small>
    <% } %>

    <br>
    <small><a href="<%= locale %>" target="_blank" rel="noopener"><%= event.location %></a></small>
    <br><br>

    <p><%= event.description %></p>
    <br>

    <!-- RSVP block -->
    <% 
      const normalizedType = String(event.type || "").toLowerCase();
      const canRsvpType = ["camp", "experience camp", "spring training", "bgi audition", "bgi camp", "other"].includes(normalizedType);
    %>
    <% if (canRsvpType) { %>
      <% if (user) { %>
        <% if (isPast) { %>
          <p style="color:#b00020;"><strong>RSVP is closed for this event.</strong></p>
        <% } else { %>
          <% if (reservedSelf) { %>
            <p><strong>You have RSVP'd for this event!</strong></p>
          <% } else { %>
            <form action="/event/<%= event.slug %>/rsvp" method="POST" style="display:inline;">
              <button type="submit">RSVP</button>
            </form>
          <% } %>
        <% } %>
      <% } else { %>
        <% if (isPast) { %>
          <p style="color:#b00020;">This event has passed. RSVP is closed.</p>
        <% } else { %>
          <p>Login to RSVP</p>
          <br>
          <button onclick="window.location='/login'">Login</button>
        <% } %>
      <% } %>
    <% } %>

    <br><br>

    <!-- Map -->
    <iframe
      width="100%" height="300px"
      src="https://maps.google.com/maps?width=100%&amp;height=600&amp;hl=en&amp;q=<%= mapAddy %>&amp;ie=UTF8&amp;t=&amp;z=12&amp;iwloc=B&amp;output=embed"
      frameborder="0" scrolling="no" marginheight="0" marginwidth="0"
      style="border-radius: 16px; box-shadow: 4px 4px 8px rgba(0,0,0,0.3);">
    </iframe>

    <br><br>

    <!-- Admin RSVP list -->
    <% if (user && user.admin) { %>
      <h2>People Who've RSVP'd</h2>
      <div style="margin: 8px 0 16px; display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <input id="rsvp-search" type="text" placeholder="Search name…" style="padding:8px 10px; border:1px solid #ddd; border-radius:8px; min-width:220px;">
        <select id="rsvp-section" style="padding:8px 10px; border:1px solid #ddd; border-radius:8px;">
          <option value="all">All sections</option>
        </select>
        <small id="rsvp-count" class="muted"></small>
      </div>

      <div id="rsvp-results" style="display:grid; gap:12px;"></div>

      <script>
        (function(){
          const slug = "<%= event.slug %>";
          const $search = document.getElementById('rsvp-search');
          const $section = document.getElementById('rsvp-section');
          const $results = document.getElementById('rsvp-results');
          const $count = document.getElementById('rsvp-count');

          let state = { q: '', section: 'all', sectionsLoaded: false };

          function debounce(fn, ms) {
            let t; return (...args) => { clearTimeout(t); t = setTimeout(() => fn.apply(this, args), ms); };
          }

          function pill(text) {
            const el = document.createElement('span');
            el.className = 'pill';
            el.textContent = text;
            return el;
          }

          function render(rows){
            $results.innerHTML = '';
            $count.textContent = rows.length ? `${rows.length} RSVP${rows.length===1?'':'s'}` : '';

            if(rows.length === 0){
              $results.innerHTML = '<p class="muted">No matches.</p>';
              return;
            }

            const list = document.createElement('div');
            list.style.display = 'grid';
            list.style.gap = '10px';

            rows.forEach(r => {
              const row = document.createElement('div');
              row.style.display = 'flex';
              row.style.alignItems = 'center';
              row.style.gap = '10px';
              row.style.padding = '8px 10px';
              row.style.border = '1px solid #eee';
              row.style.borderRadius = '10px';
              row.style.background = '#fff';

              const name = document.createElement('span');
              name.innerHTML = `<strong>${r.firstname} ${r.lastname}</strong>`;

              // If this RSVP is from a parent with children, show them right under the name
              if (Array.isArray(r.children) && r.children.length) {
                const label = r.children.length > 1 ? 'Children' : 'Child';
                const kids = r.children
                  .map(c => `${c.firstname} ${c.lastname}`)
                  .join(', ');
                name.innerHTML += `<br><small>${label}: ${kids}</small>`;
              }

              row.appendChild(name);

              if (r.section) row.appendChild(pill(r.section));
              if (r.instrument) row.appendChild(pill(r.instrument));

              if (r.paid) {
                const paid = pill('Paid');
                paid.style.background = '#e8fff0';
                paid.style.color = '#177245';
                row.appendChild(paid);
              }

              list.appendChild(row);
            });

            $results.appendChild(list);
          }

          async function fetchData(){
            const params = new URLSearchParams();
            if(state.q) params.set('q', state.q);
            if(state.section && state.section !== 'all') params.set('section', state.section);

            const res = await fetch(`/event/${slug}/rsvps-data?` + params.toString(), { credentials: 'same-origin' });
            if(!res.ok) { $results.innerHTML = '<p class="muted">Failed to load results.</p>'; return; }
            const data = await res.json();

            if(!state.sectionsLoaded){
              (data.sections || []).forEach(sec => {
                const opt = document.createElement('option');
                opt.value = sec;
                opt.textContent = sec;
                $section.appendChild(opt);
              });
              state.sectionsLoaded = true;
            }

            render(data.rsvps || []);
          }

          const doSearch = debounce(() => { state.q = $search.value.trim(); fetchData(); }, 200);

          $search.addEventListener('input', doSearch);
          $section.addEventListener('change', () => { state.section = $section.value; fetchData(); });

          fetchData();
        })();
      </script>
    <% } %>
  </div>
</main>

<footer>
  <%- include("includes/footer") %>
</footer>

<script>
  // Copy link + show site toast (sticky-message) without duplicating footer code
  (function(){
    const btn = document.getElementById('share-copy');
    const url = "<%- sharePlainUrl %>";
    if (!btn) return;

    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1200);
      if (typeof showMessage === 'function') {
        showMessage("Link Copied to Clipboard!");
      }
    });
  })();
</script>
</body>
</html>
