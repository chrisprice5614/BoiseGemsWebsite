<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Music & Files | Boise Gems</title>
  <%- include("includes/head") %>
  <link rel="stylesheet" href="/css/files-drive.css">
</head>
<body class="files-drive-page">
<header><%- include("includes/header") %></header>

<main class="files-drive">
  <div class="files-drive__top">
    <div>
      <h1 class="files-drive__title">Music &amp; Files</h1>
      <p class="files-drive__subtitle">Season folders for charts, audio, and rehearsal materials.</p>
    </div>
  </div>

  <div class="files-drive__grid" id="filesDriveItems">
    <% if (showCorps) { %>
    <a href="/files/corps/<%= filesYear %>" class="files-drive-item files-drive-card files-drive-card--ensemble">
      <div class="files-drive-card__icon files-drive-card__icon--lg"><ion-icon name="folder"></ion-icon></div>
      <p class="files-drive-card__name"><%= filesYear %> Corps</p>
      <p class="files-drive-card__meta">Brass, percussion, guard, and more</p>
    </a>
    <% } %>
    <% if (showIndependent) { %>
    <a href="/files/indoor/<%= filesYear %>" class="files-drive-item files-drive-card files-drive-card--ensemble">
      <div class="files-drive-card__icon files-drive-card__icon--lg"><ion-icon name="folder"></ion-icon></div>
      <p class="files-drive-card__name"><%= filesYear %> Independent</p>
      <p class="files-drive-card__meta">Indoor drumline and front ensemble</p>
    </a>
    <% } %>
  </div>

  <% if (!showCorps && !showIndependent) { %>
  <div class="files-drive-empty">
    <ion-icon name="folder-open-outline"></ion-icon>
    <p>No file libraries are available for your account.</p>
  </div>
  <% } %>
</main>

<footer><%- include("includes/footer") %></footer>
</body>
</html>
