<script>
(function() {
  var overlay = document.getElementById('confirm-overlay');
  var yesBtn = document.getElementById('confirm-yes');
  var noBtn = document.getElementById('confirm-no');
  var msgEl = document.getElementById('confirm-message');
  var pendingCallback = null;

  function openConfirm(message, onYes, opts) {
    opts = opts || {};
    if (msgEl) msgEl.textContent = message || 'Are you sure you want to continue?';
    pendingCallback = typeof onYes === 'function' ? onYes : null;
    overlay.classList.toggle('confirm-overlay--alert', !!opts.alert);
    if (opts.alert) {
      yesBtn.textContent = 'Okay';
      noBtn.hidden = true;
    } else {
      yesBtn.textContent = 'Yes';
      noBtn.hidden = false;
    }
    overlay.hidden = false;
  }

  function closeConfirm() {
    overlay.hidden = true;
    overlay.classList.remove('confirm-overlay--alert');
    pendingCallback = null;
    yesBtn.textContent = 'Yes';
    noBtn.hidden = false;
  }

  window.bgConfirm = function(message, onYes) {
    openConfirm(message, onYes, { alert: false });
  };

  window.bgAlert = function(message, onOk) {
    openConfirm(message, onOk || null, { alert: true });
  };

  document.querySelectorAll('.confirm-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var href = btn.getAttribute('next') || '#';
      openConfirm('Are you sure you want to continue?', function() {
        if (href && href !== '#') window.location.href = href;
      }, { alert: false });
    });
  });

  yesBtn.addEventListener('click', function() {
    var cb = pendingCallback;
    closeConfirm();
    if (cb) cb();
  });

  noBtn.addEventListener('click', closeConfirm);

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closeConfirm();
  });
})();
</script>

