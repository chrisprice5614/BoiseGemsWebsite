<script>
(function () {
  var KEY = "bg_test_site_notice_seen";
  try {
    if (localStorage.getItem(KEY) === "1") return;
  } catch (e) {}
  var overlay = document.getElementById("test-site-overlay");
  var ok = document.getElementById("test-site-ok");
  if (!overlay || !ok) return;
  overlay.hidden = false;
  function dismiss() {
    try { localStorage.setItem(KEY, "1"); } catch (e) {}
    overlay.hidden = true;
  }
  ok.addEventListener("click", dismiss);
})();
</script>
