<% headerLinks = 
`
<a href="/">Home</a>
<div class="about-dropdown">
    <span class="about-trigger">About ▼</span>
    <div class="about-dropdown-menu">
        <a href="/our-history-about">Our History</a>
        <a href="/boise-gems-corps-about">Boise Gems Drum &amp; Bugle Corps</a>
        <a href="/boise-gems-independent">Boise Gems Independent</a>
    </div>
</div>
<a href="/news">News</a>
<a href="/contact">Contact</a>
<a href="/donate">Donate</a>
<a href="/calendar">Calendar</a>
<a href="/join-corps">Audition Info</a>
`

if(user)
{
    headerLinks += `
    <a href="/logout"><button>Log Out</button></a>`
}
else
{
    headerLinks += `<a href="/login"><button>Log In</button></a>`
}
%>

<div style="display: grid; grid-template-columns: 1fr 2fr; align-items: center; width: 100%;">
    <div style="display: flex; align-items: center;">
        <div style="text-align: left; height: 96px; padding: 16px;">
            <a href="/">
                <img src="/img/ui/gem.png" alt="Gems logo" style="height: 90%;">
            </a>
        </div>
        <% if(user.admin) { %>
            <a href="/admin-portal"><button>Admin Portal</button></a>
        <% } else if(user.parent) { %>
            <a href="/parent-portal"><button>Parent Portal</button></a>
        <% } else if(user.staff) { %>
            <a href="/member-portal"><button>Staff Portal</button></a>
        <% } else if(user) { %>
            <a href="/member-portal"><button>Member Portal</button></a>
        <% } %>
    </div>
    <div style="text-align: right; padding-right: 32px;">
        <div class="hidden-desktop" style="text-align: right; font-size: x-large;" onclick="toggleHamburger()">
            <span id="hamburger">☰</span>
            <div id="mobile-menu">
                <%- headerLinks %>
            </div>
        </div>
        <div class="hidden-mobile">
            <%- headerLinks %>
        </div>
    </div>
</div>
<script>
    let hamburger = false;

    const hamburgerText = document.getElementById("hamburger")
    const mobileMenu = document.getElementById("mobile-menu")
    function toggleHamburger() {
        hamburger = !hamburger;

        if(hamburger){
            hamburgerText.innerHTML='X'

            mobileMenu.classList.add('active')
        }

        if(!hamburger){
            hamburgerText.innerHTML='☰'
            mobileMenu.classList.remove('active')
        }
    };
</script>

<div id="stickyMessage" style="display: none;">Hello</div>

<div id="confirm-overlay" style="
  display: none;
  position: fixed;
  z-index: 9999;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  align-items: center;
  justify-content: center;
">
  <div style="
    background: white;
    padding: 2rem;
    border-radius: 10px;
    text-align: center;
    max-width: 300px;
    width: 100%;
  ">
    <p style="margin-bottom: 1.5rem; color: #000;">Are you sure you want to continue?</p>
    <div style="display: flex; justify-content: center; gap: 1rem;">
      <button id="confirm-yes" style="padding: 0.5rem 1rem; background: red; color: white; border: none; border-radius: 6px;">Yes</button>
      <button id="confirm-no" style="padding: 0.5rem 1rem; background: #ccc; border: none; border-radius: 6px;">No</button>
    </div>
  </div>
</div>

