<div class="header-inner">

  <!-- Logo: gem + text logo (both link to home) -->
  <div class="header-left">
    <a href="/" class="header-gem-link">
      <img src="/img/ui/gem.png" alt="Boise Gems">
    </a>
    <a href="/" class="header-text-link">
      <img src="/img/ui/text-logo.png" alt="Boise Gems">
    </a>
  </div>

  <!-- Desktop nav -->
  <nav class="header-nav">
    <div class="nav-dropdown">
      <span class="nav-trigger">BGPA</span>
      <div class="nav-dropdown-menu">
        <a href="/our-history-about">Our History</a>
        <a href="/board-of-directors">Board of Directors</a>
        <a href="/boise-gems-corps-about">Boise Gems Drum &amp; Bugle Corps</a>
        <a href="/boise-gems-independent">Boise Gems Independent</a>
      </div>
    </div>
    <div class="nav-dropdown">
      <span class="nav-trigger">Support Us</span>
      <div class="nav-dropdown-menu">
        <a href="/donate">Donate</a>
        <% if (typeof merchEnabled !== 'undefined' && merchEnabled) { %>
        <a href="/store">Store</a>
        <% } %>
        <a href="/volunteer">Volunteer</a>
      </div>
    </div>
    <div class="nav-dropdown">
      <span class="nav-trigger">Info</span>
      <div class="nav-dropdown-menu">
        <a href="/news">News</a>
        <a href="/calendar">Calendar</a>
        <a href="/join-corps">Audition Info</a>
      </div>
    </div>
    <a href="/contact"><button>Contact</button></a>
    <% if(user && user.admin) { %>
      <a href="/admin-portal"><button>Admin Portal</button></a>
    <% } else if(user && user.parent) { %>
      <a href="/parent-portal"><button>Parent Portal</button></a>
    <% } else if(user && user.staff) { %>
      <a href="/member-portal"><button>Staff Portal</button></a>
    <% } else if(user && user.fan) { %>
      <a href="/fan-portal"><button>Fan Portal</button></a>
    <% } else if(user) { %>
      <a href="/member-portal"><button>Member Portal</button></a>
    <% } %>
    <% if(user) { %>
      <a href="/logout"><button>Log Out</button></a>
    <% } else { %>
      <a href="/login"><button>Log In</button></a>
    <% } %>
  </nav>

  <!-- Mobile hamburger -->
  <button class="hamburger-btn" id="hamburger-btn" onclick="openMobileMenu()" aria-label="Open menu">
    <span class="hamburger-bar"></span>
    <span class="hamburger-bar"></span>
    <span class="hamburger-bar"></span>
  </button>

</div>

<!-- Mobile fullscreen overlay -->
<div id="mobile-overlay" class="mobile-overlay">
  <div class="mobile-overlay-top">
    <div class="mobile-overlay-left">
      <a href="/" class="header-gem-link">
        <img src="/img/ui/gem.png" alt="Boise Gems">
      </a>
      <button class="mobile-back-btn" id="mobile-back-btn" onclick="closeSubMenu()" aria-label="Back">&#9664;</button>
    </div>
    <button class="hamburger-btn hamburger-btn--close" onclick="closeMobileMenu()" aria-label="Close menu">
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>
  </div>

  <div class="mobile-menu-container">

    <!-- Main menu view -->
    <div id="mobile-main-menu" class="mobile-menu-view">
      <button class="mobile-nav-link" onclick="openSubMenu('bgpa')">BGPA</button>
      <button class="mobile-nav-link" onclick="openSubMenu('support')">Support</button>
      <button class="mobile-nav-link" onclick="openSubMenu('info')">Info</button>
      <a href="/contact" class="mobile-nav-link">Contact</a>
      <% if(user && user.admin) { %>
        <a href="/admin-portal" class="mobile-nav-link">Admin Portal</a>
      <% } else if(user && user.parent) { %>
        <a href="/parent-portal" class="mobile-nav-link">Parent Portal</a>
      <% } else if(user && user.staff) { %>
        <a href="/member-portal" class="mobile-nav-link">Staff Portal</a>
      <% } else if(user && user.fan) { %>
        <a href="/fan-portal" class="mobile-nav-link">Fan Portal</a>
      <% } else if(user) { %>
        <a href="/member-portal" class="mobile-nav-link">Member Portal</a>
      <% } %>
      <% if(user) { %>
        <a href="/logout" class="mobile-nav-link">Log Out</a>
      <% } else { %>
        <a href="/login" class="mobile-nav-link">Log In</a>
      <% } %>
    </div>

    <!-- BGPA submenu -->
    <div id="mobile-sub-bgpa" class="mobile-submenu-view">
      <a href="/our-history-about" class="mobile-nav-link">Our History</a>
      <a href="/board-of-directors" class="mobile-nav-link">Board of Directors</a>
      <a href="/boise-gems-corps-about" class="mobile-nav-link">Boise Gems Drum &amp; Bugle Corps</a>
      <a href="/boise-gems-independent" class="mobile-nav-link">Boise Gems Independent</a>
    </div>

    <!-- Support submenu -->
    <div id="mobile-sub-support" class="mobile-submenu-view">
      <a href="/donate" class="mobile-nav-link">Donate</a>
      <% if (typeof merchEnabled !== 'undefined' && merchEnabled) { %>
      <a href="/store" class="mobile-nav-link">Store</a>
      <% } %>
      <a href="/volunteer" class="mobile-nav-link">Volunteer</a>
    </div>

    <!-- Info submenu -->
    <div id="mobile-sub-info" class="mobile-submenu-view">
      <a href="/news" class="mobile-nav-link">News</a>
      <a href="/calendar" class="mobile-nav-link">Calendar</a>
      <a href="/join-corps" class="mobile-nav-link">Audition Info</a>
    </div>

  </div>
</div>

<script>
  const _mobileOverlay = document.getElementById('mobile-overlay');
  const _hamburgerBtn  = document.getElementById('hamburger-btn');
  const _mobileMain    = document.getElementById('mobile-main-menu');
  const _mobileBackBtn = document.getElementById('mobile-back-btn');
  let _currentSub = null;
  let _menuHistoryPushed = false;

  function openMobileMenu() {
    _mobileOverlay.classList.add('is-open');
    _hamburgerBtn.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    _mobileOverlay.classList.remove('is-open');
    _hamburgerBtn.classList.remove('is-open');
    document.body.style.overflow = '';
    if (_currentSub) {
      var hadMenuHistory = _menuHistoryPushed;
      closeSubMenu(true);
      if (hadMenuHistory) history.back();
    }
    _mobileBackBtn.classList.remove('is-visible');
  }

  function openSubMenu(id, fromHistory) {
    const sub = document.getElementById('mobile-sub-' + id);
    if (!sub) return;
    _mobileMain.classList.add('slide-out-left');
    sub.classList.add('slide-in');
    _currentSub = sub;
    _mobileBackBtn.classList.add('is-visible');
    if (!fromHistory) {
      history.pushState({ bgMenuSub: id }, '', window.location.href);
      _menuHistoryPushed = true;
    }
  }

  function closeSubMenu(fromHistory) {
    if (!_currentSub) return;
    _mobileMain.classList.remove('slide-out-left');
    _currentSub.classList.remove('slide-in');
    _currentSub = null;
    _mobileBackBtn.classList.remove('is-visible');
    if (fromHistory) {
      _menuHistoryPushed = false;
      return;
    }
    if (_menuHistoryPushed) {
      _menuHistoryPushed = false;
      history.back();
    }
  }

  window.addEventListener('popstate', function (e) {
    if (!_mobileOverlay.classList.contains('is-open')) return;
    if (e.state && e.state.bgMenuSub) {
      openSubMenu(e.state.bgMenuSub, true);
      return;
    }
    if (_currentSub) closeSubMenu(true);
  });
</script>

<div id="stickyMessage" style="display: none;">Hello</div>
