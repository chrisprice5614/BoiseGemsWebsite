<div class="merch-store-bar">
  <h1><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Merch Store' %></h1>
  <a href="/store/cart" class="merch-cart-link">
    <ion-icon name="cart-outline" style="font-size:1.4rem;"></ion-icon>
    Cart
    <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
      <span class="merch-cart-badge"><%= cartCount %></span>
    <% } %>
  </a>
</div>
