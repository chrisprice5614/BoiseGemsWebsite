<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems | Instruments</title>
    <%- include("includes/head") %>
</head>
<body>
<header>
    <%- include("includes/header") %>
</header>
<main>
    <br>
    <h1 style="text-align: center;">
        Instruments for <%= thisUser.firstname %> <%= thisUser.lastname %>
    </h1>
    <br>

    <div style="padding: 8px;">
        <h2>Add Instrument Checkout</h2>
        <form method="POST" action="/instruments/<%= thisUser.id %>/add">
            <label for="instrument_type">Instrument Type</label>
            <input type="text" name="instrument_type" id="instrument_type" required>

            <br><br>

            <label for="model">Model</label>
            <input type="text" name="model" id="model">

            <br><br>

            <label for="serial">Serial Number</label>
            <input type="text" name="serial" id="serial">

            <br><br>

            <div style="text-align: center;">
                <button type="submit">Check Out</button>
            </div>
        </form>
    </div>

    <br>
    <hr>
    <br>

    <div style="padding: 8px;">
        <h2>Instrument History</h2>
        <% if (instruments && instruments.length) { %>
            <% instruments.forEach(inst => { %>
                <div style="margin-bottom: 8px; border: solid 1px var(--dark-quarter); box-shadow: 0px 1px 4px rgba(0,0,0,0.6); padding: 4px; border-radius: 8px;">
                    <h3><%= inst.instrument_type %> <%= inst.model ? ("— " + inst.model) : "" %></h3>
                    <p><b>Serial:</b> <%= inst.serial || "N/A" %></p>
                    <p><b>Checked Out:</b>
                        <%= inst.checked_out_date
                            ? new Date(inst.checked_out_date).toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric"
                              })
                            : "Unknown" %>
                    </p>
                    <p><b>Checked In:</b>
                        <% if (inst.checked_in_date) { %>
                            <%= new Date(inst.checked_in_date).toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric"
                            }) %>
                        <% } else { %>
                            Currently checked out
                        <% } %>
                    </p>

                    <% if (!inst.checked_in_date) { %>
                        <form method="POST" action="/instruments/<%= thisUser.id %>/checkin/<%= inst.id %>">
                            <button type="submit">Check In Today</button>
                        </form>
                    <% } %>
                </div>
            <% }) %>
        <% } else { %>
            <p>No instruments on record.</p>
        <% } %>
    </div>
</main>
<footer>
    <%- include("includes/footer") %>
</footer>
</body>
</html>