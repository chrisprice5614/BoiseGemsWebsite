<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Join The 2027 Season | Boise Gems Drum &amp; Bugle Corps</title>
  <%- include("includes/head") %>
  <link rel="stylesheet" href="/css/join-corps.css">
  <% if (!testSite) { %>
  <meta name="description" content="Join the Boise Gems Drum & Bugle Corps 2027 season. Audition info, materials, and everything you need to take the first step.">
  <link rel="canonical" href="https://boisegems.org/join-corps">
  <meta property="og:title" content="Join The 2027 Season | Boise Gems">
  <meta property="og:description" content="Idaho's summer marching arts experience. Start your audition journey.">
  <% } %>

</head>
<body class="join-corps-page">
  <header><%- include("includes/header") %></header>

  <div class="join-corps-experience"
       data-topo-opacity="<%= topoOpacity %>"
       style="--jc-topo-opacity: <%= topoOpacity %>;">

    <div class="join-corps-experience__bg" aria-hidden="true"></div>
    <canvas class="join-corps-experience__grid" id="joinCorpsGrid" aria-hidden="true"></canvas>
    <canvas class="join-corps-experience__topo" id="joinCorpsTopo" aria-hidden="true"></canvas>

    <div class="join-corps-scroll">
      <section class="join-corps-hero">
        <h1 class="join-corps-hero__title"><span class="join-corps-hero__join">Join</span> The 2027 Season</h1>
        <a href="<%= ctaHref %>" class="join-corps-cta join-corps-cta--hero"><%= ctaLabel %></a>
      </section>

      <section class="join-corps-body">
        <%- joinCorpsHtml %>
      </section>

      <footer class="join-corps-footer">
        <a href="<%= ctaHref %>" class="join-corps-cta"><%= ctaLabel %></a>
      </footer>
    </div>
  </div>

  <footer><%- include("includes/footer") %></footer>
  <script src="/js/join-corps-experience.js" defer></script>
</body>
</html>
