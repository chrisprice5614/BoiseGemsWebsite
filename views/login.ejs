<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems | Login</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <div style="padding: 8px">
            <br>
            <% if(errors.length) { %>
                <% errors.forEach(error => { %>
                    <div class="error">
                        <%= error %>
                    </div>
                <% }) %>
            <% } %>
            <h1>Login</h1>
            <form action="/login" method="POST">
                <label for="email">Email</label>
                <input type="email" name="email" autocomplete="off" placeholder="John@email.com" required/>
                <br>
                <br>
                <label for="password">Password</label>
                <input type="password" name="password" autocomplete="off" required/>
                <br>
                <br>
                <div style="text-align: center;">
                    <button>Login</button>
                </div>
            </form>
            <br>
            <p style="padding: 8px">Don't have an account? <a href="/register">Register here</a>!</p>
            <p style="padding: 8px">Forgot password? <a href="/forgot-password">Reset password</a>!</p>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>