<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Boise Gems | Login</title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="icon" type="image/x-icon" href="/img/ui/favicon.ico" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      min-height: 100dvh;
    }

    /* ── Full-screen abstract purple background ── */
    .bg {
      min-height: 100dvh;
      background:
        radial-gradient(ellipse at 12% 20%, rgba(157,118,187,.82) 0%, transparent 52%),
        radial-gradient(ellipse at 88%  8%, rgba(72,22,130,.90)   0%, transparent 46%),
        radial-gradient(ellipse at 70% 85%, rgba(67,30,201,.48)   0%, transparent 54%),
        radial-gradient(ellipse at  4% 88%, rgba(140,100,180,.65) 0%, transparent 44%),
        radial-gradient(ellipse at 92% 62%, rgba(96,67,125,.72)   0%, transparent 48%),
        radial-gradient(ellipse at 48% 48%, rgba(255,255,255,.50) 0%, transparent 62%),
        radial-gradient(ellipse at 30% 70%, rgba(180,140,210,.50) 0%, transparent 40%),
        #ddd0f0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
    }

    /* ── Frosted-glass login card ── */
    .login-card {
      background: rgba(255,255,255,.90);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border: 1px solid rgba(255,255,255,.74);
      border-radius: 22px;
      box-shadow:
        0 12px 48px rgba(72,22,130,.22),
        0 2px 10px rgba(0,0,0,.09);
      width: 100%;
      max-width: 420px;
      padding: 48px 42px 38px;
    }

    .login-logo {
      display: block;
      width: 70px;
      height: auto;
      margin: 0 auto 14px;
      filter: drop-shadow(0 2px 10px rgba(96,67,125,.30));
    }

    .login-title {
      text-align: center;
      font-size: 1.75rem;
      font-weight: 700;
      color: #35166a;
      margin-bottom: 4px;
      letter-spacing: -.3px;
    }

    .login-subtitle {
      text-align: center;
      color: #7858a0;
      font-size: .9rem;
      margin-bottom: 30px;
    }

    /* ── Error messages ── */
    .error-box {
      background: #fdeaea;
      border: 1.5px solid #f5a0a0;
      border-radius: 10px;
      padding: 10px 14px;
      color: #b02020;
      font-size: .88rem;
      margin-bottom: 10px;
    }

    /* ── Form fields ── */
    .field-group { margin-bottom: 18px; }

    .field-group label {
      display: block;
      font-size: .84rem;
      font-weight: 600;
      color: #4a2e7a;
      margin-bottom: 6px;
    }

    .field-group input {
      width: 100%;
      padding: 12px 15px;
      border: 1.5px solid #c8b4e0;
      border-radius: 11px;
      font-size: .97rem;
      background: rgba(255,255,255,.93);
      color: #1a1030;
      outline: none;
      transition: border-color 180ms, box-shadow 180ms;
      font-family: inherit;
    }

    .field-group input:focus {
      border-color: #9d76bb;
      box-shadow: 0 0 0 3.5px rgba(157,118,187,.22);
    }

    /* ── Primary button ── */
    .login-btn {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #9d76bb 0%, #5c3d80 100%);
      color: #fff;
      border: none;
      border-radius: 11px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      letter-spacing: .2px;
      margin-top: 6px;
      transition: opacity 180ms, transform 100ms;
      box-shadow: 0 4px 16px rgba(80,35,130,.28);
      font-family: inherit;
    }

    .login-btn:hover  { opacity: .87; }
    .login-btn:active { transform: scale(.98); }

    /* ── Footer links ── */
    .login-links {
      text-align: center;
      margin-top: 24px;
      font-size: .87rem;
      color: #7858a0;
    }

    .login-links p { margin: 7px 0; }

    .login-links a {
      color: #5c3d80;
      font-weight: 600;
      text-decoration: none;
    }

    .login-links a:hover { text-decoration: underline; }

    /* ── Responsive ── */
    @media (max-width: 480px) {
      .login-card  { padding: 34px 22px 28px; }
      .login-title { font-size: 1.5rem; }
    }

    /* ── Neutralise global form / label / input rules ── */
    .login-card form {
      background: none;
      border: none;
      box-shadow: none;
      margin: 0;
      padding: 0;
    }
    .field-group label { margin-left: 0; }
    .field-group input  { margin: 0; }
  </style>
</head>
<body>
<div class="bg">
  <div class="login-card">

    <img class="login-logo" src="/img/ui/gem.png" alt="Boise Gems logo" />
    <h1 class="login-title">Welcome Back</h1>
    <p class="login-subtitle">Sign in to your account</p>

    <% if (errors && errors.length) { %>
      <% errors.forEach(function(err) { %>
        <div class="error-box"><%= err %></div>
      <% }) %>
    <% } %>

    <form action="/login" method="POST">
      <div class="field-group">
        <label for="email">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          placeholder="john@email.com"
          required
        />
      </div>

      <div class="field-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
        />
      </div>

      <button class="login-btn" type="submit">Login</button>
    </form>

    <div class="login-links">
      <p>Don't have an account? <a href="/register">Register here</a></p>
      <p>Forgot your password? <a href="/forgot-password">Reset it here</a></p>
    </div>

  </div>
</div>
</body>
</html>