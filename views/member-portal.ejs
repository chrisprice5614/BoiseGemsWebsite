<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
    <!-- styles moved to styles.css -->

</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <div style="margin: 12px;">
            <% if (member.minor && (!member.parentId || member.parentId == 0)) { %>
                <div style="padding: 18px; border-radius: 10px; background: linear-gradient(90deg,#fff6e6,#ffecea); border: 3px solid #ff8a6b; margin-bottom: 16px;">
                    <h2 style="margin-top:0;">Action required: Parent/Guardian Needed</h2>
                    <p style="font-weight:700;">We see you're under 18. A parent/guardian must claim you as their child to upload forms and sign contracts.</p>
                    <p>Enter your parent or guardian's email below and we'll send them an email with simple instructions to register or login and claim you.</p>
                    <form action="/member-portal/request-parent-invite" method="POST" style="display:flex; gap:8px; align-items:center; margin-top:8px;">
                        <input type="email" name="parentEmail" placeholder="Parent or guardian email" required style="flex:1; padding:8px; border-radius:6px; border:1px solid #ccc;" />
                        <button type="submit" style="padding:10px 14px; border-radius:8px; background:#ff7a5a; color:#fff; border:0; font-weight:700;">Send Invite</button>
                    </form>
                </div>
            <% } %>
            <% if(member.staff){ %>
                <div style="padding: 12px; border-radius: 8px; margin-bottom: 12px; box-shadow: 2px 2px 3px rgba(0,0,0,0.1);" class="purple-storm">
                    <h2>Staff Portal</h2>
                </div>
            <% } %>
            <% if((member.section != "staff") || (member.staff == 0)) { %>
                <br>
                
                <br>
            <% } %>
            <div style="display: grid; grid-template-columns: 1fr 2fr; place-items: center; background: url('/img/ui/gem-back.jpg'); border-radius: 8px; box-shadow: 2px 2px 3px rgba(0,0,0,0.1);">
                <div>   
                    <div class="image-wrapper">
                         <a href="/update-profile-photo">
                            <% const srcImage = member.img == null ? "/img/ui/gem.png" : member.img %>
                            <img src="<%= srcImage %>" alt="Member photo for <%= user.firstname %> <%= user.lastname %>">
                        </a>
                        <% if(member.img == null) { %>
                            <span style="color: #fff;">Click image to change profile photo.</span>
                        <% } %>
                    </div>
                </div>
                <div>
                    <h2 style="text-align: center; text-transform: capitalize;"><b><%= user.firstname %> <%= user.lastname %></b> - <%= member.section %>, <%= member.instrument %></h2>
                    <% if(member.contractedIndependent) {%>
                        <p style="text-align: center;">Contracted for <b>Boise Gems Independent</b></p>
                    <% } %>
                                        <% if(member.contractedAffiliate) {%>
                                                <p style="text-align: center;">Contracted for <b>Boise Gems Affiliate</b></p>
                                        <% } %>
                    <% if(member.contractedCorps) {%>
                        <p style="text-align: center;">Contracted for <b>Boise Gems Drum & Bugle Corps</b></p>
                    <% } %>
                    <% 
                                            const isContracted = member.contractedIndependent || member.contractedCorps || member.contractedAffiliate;
                      let videoAuditionUrl = null;
                      if (!isContracted && member.section) {
                        if (member.section === "brass") {
                          videoAuditionUrl = "https://www.omnipply.com/programs/34bbd8ff-73b0-4452-a1ae-617a566d8817/apply";
                        } else if (member.section === "front ensemble" || member.section === "drumline") {
                          videoAuditionUrl = "https://www.omnipply.com/programs/54e57104-fb5f-4df1-8ad4-8a61f24513b8/apply";
                        }
                      }
                    %>
                    <% if (videoAuditionUrl) { %>
                      <div style="text-align: center; margin-top: 12px;">
                        <a href="<%= videoAuditionUrl %>" target="_blank" rel="noopener">
                          <button>Video audition for <%= member.section %></button>
                        </a>
                      </div>
                    <% } %>


                </div>
            </div>
            <div class="duple-to-single">
                <div style="margin: 24px 8px; padding: 8px; background-color: #dfdfdf; border-radius: 12px; box-shadow: 2px 2px 6px rgba(0,0,0,0.25);">
                    <%- include("includes/shirt-size-section") %>
                    <br>
                    <p><b>Email:</b> <%= member.email %></p>
                    <br>
                    <p><b>Address:</b> <%= member.address %></p>
                    <br>
                    <p><b>Phone:</b> <%= member.phone %></p>
                    <br>
                    <p><b>Birthday:</b> <%= new Date( member.birthday ).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }).replace(/(\d{1,2})(,)/, '$1th$2') %></p>
                    <br>
                    <p><b>Email verified: </b>✅</p>
                    <br>
                    <% if(!member.staff) { %>
                    <p><b>Balance Due: </b><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(member.owed / 100) %></p>
                    <% } %>
                    <br>
                    <div style="margin: 8px 0; padding: 8px; border-radius: 8px; background:#f5f5f5;">
                        <h3 style="margin-top:0;">Boise Gems Indoor</h3>

                        <% if (member.indoorSection) { %>
                            <p>
                            Section: <strong><%= member.indoorSection %></strong><br/>
                            Instrument:
                            <strong><%= member.indoorInstrument || "Not specified" %></strong>
                            </p>
                        <% } else { %>
                            <p>You’re not currently signed up for Boise Gems Indoor.</p>
                        <% } %>

                        <form action="/member-portal/indoor" method="POST">
                            <label for="indoorSection">Indoor section</label><br/>
                            <select id="indoorSection" name="indoorSection">
                            <option value="">Not this season</option>
                            <option value="Front Ensemble" <%= member.indoorSection === "Front Ensemble" ? "selected" : "" %>>
                                Front Ensemble
                            </option>
                            <option value="Drumline" <%= member.indoorSection === "Drumline" ? "selected" : "" %>>
                                Drumline
                            </option>
                            </select>

                            <br><br>

                            <label for="indoorInstrument">Indoor instrument</label><br/>
                            <input
                            type="text"
                            id="indoorInstrument"
                            name="indoorInstrument"
                            value="<%= member.indoorInstrument || "" %>"
                            placeholder="e.g. Snare, Tenors, Basses, Marimba, Vibes"
                            style="max-width: 280px;"
                            />

                            <br><br>
                            <button type="submit">Save Indoor preference</button>
                        </form>
                        </div>
                </div>
                <div style="margin: 24px 8px; padding: 8px; background-color: #dfdfdf; border-radius: 12px; box-shadow: 2px 2px 6px rgba(0,0,0,0.25);">
                     <% if (contracts.length) { %>
                        <div style="text-align: center;">
                            <h3>You have a membership contract to view!</h3>
                            <% contracts.forEach(function (contract) { 
                                let groupString = "Corps";

                                if (contract.season && contract.season.includes("independent")) {
                                    groupString = "Independent";
                                } else if (contract.season && contract.season.includes("affiliate")) {
                                    groupString = "Affiliate";
                                }

                                const dueMs = Number(contract.due_date || 0);
                                let daysRemaining = null;
                                let dueLabel = "";

                                if (dueMs) {
                                    const now = Date.now();
                                    const diffMs = dueMs - now;
                                    daysRemaining = Math.ceil(diffMs / (24 * 60 * 60 * 1000));

                                    const dueDateObj = new Date(dueMs);
                                    dueLabel = dueDateObj.toLocaleDateString("en-US", {
                                        year: "numeric",
                                        month: "long",
                                        day: "numeric"
                                    });
                                }
                            %>
                                <br>
                                <% if (dueLabel) { %>
                                    <p style="margin: 4px 0;">
                                        Contract due by <%= dueLabel %>
                                        <% if (typeof daysRemaining === "number" && !Number.isNaN(daysRemaining)) { %>
                                            (
                                            <% if (daysRemaining > 0) { %>
                                                <%= daysRemaining %> day<%= daysRemaining === 1 ? "" : "s" %> remaining
                                            <% } else if (daysRemaining === 0) { %>
                                                due today
                                            <% } else { %>
                                                past due
                                            <% } %>
                                            )
                                        <% } %>
                                    </p>
                                <% } %>
                                <a href="/accept-contract/<%= contract.id %>">
                                    <button>View/Accept Contract - <%= groupString %></button>
                                </a>
                                <br>
                            <% }); %>
                        </div>
                    <% } %>
                    <div style="text-align: center;">
                        <br>
                        <a href="/view-materials"><button>View Audition Materials</button></a>
                        <br>
                        <br>
                        <a href="/files"><button>Music &amp; Files</button></a>
                        <br>
                        <br>
                        <a href="/support/issue"><button>Submit Website Issue</button></a>
                        <br>
                        <br>
                        
                        <a href="/update-emergency"><button>Emergency Contacts</button></a>
                        <br>
                        <br>
                        <a href="/update-info"><button>Update Information</button></a>
                        <br>
                        <br>
                        <a href="/member-transactions"><button>View Payment History</button></a>
                        <br>
                        <br>
                        <% if(member.owed>0) { %>
                            <a href="/make-payment"><button>Make Payment</button></a>
                            <br>
                            <br>
                        <% } %>
                        <% if(!allergy) { %>
                            <h3 style="padding: 8px; border: solid 2px red; border-radius: 16px;"><i>You <b>MUST</b> set your allergy information</i></h3>
                            <br>
                        <% } %>
                        <a href="/allergy-info"><button>Allergy Info</button></a>
                    </div>
                    <br>
                    <% if(!member.staff) { %>
                        <% if((leftoverForms > -5)) { %>
                            <div style="text-align: center;">
                                <% if((leftoverForms > 0)) { %>
                                <h3 style="padding: 8px; border: solid 2px red; border-radius: 16px;"><i>You have required forms to upload!!</i></h3>
                                <% } %>
                                <br>
                                <a href="/member-forms"><button>View Forms</button></a>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div style="text-align: center;">
                            <a href="/audition-member"><button>Audition Member</button></a>
                            <br>
                            <br>
                            <a href="/staff/members"><button>Extend Contract</button></a>
                            <br>
                            <br>
                            <a href="/set-materials"><button>Set Audition Material</button></a>
                            <br>
                            <br>
                            <a href="/admin/callbacks"><button>Extend Callback</button></a>
                    <br><br>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>