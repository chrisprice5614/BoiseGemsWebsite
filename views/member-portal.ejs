<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <div style="margin: 12px;">
            <% if(member.staff){ %>
                <div style="padding: 12px; border-radius: 8px; margin-bottom: 12px; box-shadow: 2px 2px 3px rgba(0,0,0,0.1);" class="purple-storm">
                    <h2>Staff Portal</h2>
                </div>
            <% } %>
            <% if((member.section == "staff")&&(member.staff == 1)) {%>
                <br>
                <p style="padding: 8px; border: solid 2px red; border-radius: 16px;"><i>Your profile is set as staff but an admin has not yet cleared you as staff.</i></p>
                <br>
            <% } %>
            <div style="display: grid; grid-template-columns: 1fr 2fr; place-items: center; background: url('/img/ui/gem-back.jpg'); border-radius: 8px; box-shadow: 2px 2px 3px rgba(0,0,0,0.1);">
                <div>   
                    <div class="image-wrapper">
                         <a href="/update-profile-photo">
                        <% const srcImage = member.img == null ? "/img/ui/gem.png" : member.img %>
                            <img src="<%= srcImage %>" alt="Member photo for <%= user.firstname %> <%= user.lastname %>">
                        </a>
                    </div>
                </div>
                <div>
                    <h2 style="text-align: center; text-transform: capitalize;"><b><%= user.firstname %> <%= user.lastname %></b> - <%= member.section %>, <%= member.instrument %></h2>
                    <% if(member.contractedIndependent) {%>
                        <p style="text-align: center;">Contracted for <b>Boise Gems Independent</b></p>
                    <% } %>
                    <% if(member.contractedCorps) {%>
                        <p style="text-align: center;">Contracted for <b>Boise Gems Drum & Bugle Corps</b></p>
                    <% } %>
                </div>
            </div>
            <div class="duple-to-single">
                <div style="margin: 24px 8px; padding: 8px; background-color: #dfdfdf; border-radius: 12px; box-shadow: 2px 2px 6px rgba(0,0,0,0.25);">
                    <p><b>Email:</b> <%= member.email %></p>
                    <br>
                    <p><b>Address:</b> <%= member.address %></p>
                    <br>
                    <p><b>Phone:</b> <%= member.phone %></p>
                    <br>
                    <p><b>Birthday:</b> <%= new Date( member.birthday ).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).replace(/(\d{1,2})(,)/, '$1th$2') %></p>
                    <br>
                    <p><b>Email verified: </b>✅</p>
                    <br>
                    <% if(!member.staff) { %>
                    <p><b>Balance Due: </b><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(member.owed / 100) %></p>
                    <% } %>
                    <br>
                </div>
                <div style="margin: 24px 8px; padding: 8px; background-color: #dfdfdf; border-radius: 12px; box-shadow: 2px 2px 6px rgba(0,0,0,0.25);">
                    <% if(contracts.length) { %>
                        <div style="text-align: center;">
                            <h3>You have a membership contract to view!</h3>
                            <% contracts.forEach(contract => { 
                                let groupString = "Corps"

                                if(contract.season.includes("independent")){
                                    groupString = "Independent"
                                }
                                %>
                                <br>
                                <a href="/accept-contract/<%= contract.id %>"><button>View/Accept Contract - <%= groupString %></button></a>
                                <br>
                            <%})%>
                        </div>
                    <% } %>
                    <div style="text-align: center;">
                        <br>
                        <a href="/update-emergency"><button>Emergency Contacts</button></a>
                        <br>
                        <br>
                        <a href="/update-address"><button>Change Address</button></a>
                        <br>
                        <br>
                        <% if(member.owed>0) { %>
                            <a href="/make-payment"><button>Make Payment</button></a>
                            <br>
                            <br>
                        <% } %>
                        <% if(!allergy) { %>
                            <h3 style="padding: 8px; border: solid 2px red; border-radius: 16px;"><i>You <b>MUST</b> set your allergy information</i></h3>
                            <br>
                        <% } %>
                        <a href="/allergy-info"><button>Allergy Info</button></a>
                    </div>
                    <br>
                    <% if(!member.staff) { %>
                        <% if((leftoverForms > 0)&&((member.contractedCorps)||(member.contractedIndependent))) { %>
                            <div style="text-align: center;">
                                <h3 style="padding: 8px; border: solid 2px red; border-radius: 16px;"><i>You have required forms to upload!!</i></h3>
                                <br>
                                <% if(new Date(member.birthday) <= new Date(new Date().setFullYear(new Date().getFullYear() - 18))){ %>
                                    <a href="/member-forms"><button>View Forms</button></a>
                                <% } else { %>
                                    <button disabled>View Forms</button>
                                    <br>
                                    <br>
                                    <small>You are under 18. Please have your parent log in to their parent account in order to submit your forms.</small>
                                <% } %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div style="text-align: center;">
                            <a href="/audition-member"><button>Audition Member</button></a>
                            <br>
                            <br>
                            <a href="/extend-contract"><button>Extend Contract</button></a>
                            <br>
                            <br>
                            <a href="/set-materials"><button>Set Audition Material</button></a>
                            <br>
                            <br>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>