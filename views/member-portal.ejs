<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
    <style>
  /* Scope: only this link+button */
  a[href="/view-materials"] {
    display: inline-block;
  }
  a[href="/view-materials"] > button {
    position: relative;
    overflow: hidden;                 /* keep sheen inside */
    background: linear-gradient(180deg, #b79a26, #8f761b);
    color: #fff;
    border: 0;
    border-radius: 12px;
    padding: 10px 16px;
    font-weight: 700;
    box-shadow: 0 6px 14px rgba(0,0,0,.15), inset 0 1px 0 rgba(255,255,255,.25);
    transition: transform .12s ease, box-shadow .12s ease, filter .12s ease;
  }
  a[href="/view-materials"] > button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 20px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.3);
    filter: saturate(1.05);
    cursor: pointer;
  }
  a[href="/view-materials"] > button:active {
    transform: translateY(0);
    box-shadow: 0 6px 14px rgba(0,0,0,.15);
  }

  /* Sheen: sits ABOVE the button face */
  a[href="/view-materials"] > button::before {
    content: "";
    position: absolute;
    top: -20%;
    left: -40%;
    width: 40%;
    height: 140%;
    pointer-events: none;
    transform: skewX(-20deg) translateX(-120%);
    background: linear-gradient(
      90deg,
      rgba(255,255,255,0) 0%,
      rgba(255,255,255,.75) 45%,
      rgba(255,255,255,0.9) 50%,
      rgba(255,255,255,.75) 55%,
      rgba(255,255,255,0) 100%
    );
    mix-blend-mode: screen;           /* brightens gold nicely */
    opacity: .0;
    animation: gems-sheen 7s ease-in-out infinite;
  }

  /* Trigger a quick sweep on hover, too */
  a[href="/view-materials"] > button:hover::before {
    animation: gems-sheen-hover 1.2s ease-out 0s 1;
    opacity: 1;
  }

  @keyframes gems-sheen {
    /* long loop with a brief sweep and long idle */
    0%   { transform: skewX(-20deg) translateX(-120%); opacity: 0; }
    6%   { transform: skewX(-20deg) translateX(140%);  opacity: .9; }
    8%   { transform: skewX(-20deg) translateX(240%);  opacity: 0; }
    100% { transform: skewX(-20deg) translateX(240%);  opacity: 0; }
  }

  @keyframes gems-sheen-hover {
    0%   { transform: skewX(-20deg) translateX(-120%); opacity: .2; }
    100% { transform: skewX(-20deg) translateX(240%);  opacity: 0; }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    a[href="/view-materials"] > button::before { animation: none; opacity: 0; }
    a[href="/view-materials"] > button:hover::before { animation: none; opacity: 0; }
  }
</style>

</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <div style="margin: 12px;">
            <% if(member.staff){ %>
                <div style="padding: 12px; border-radius: 8px; margin-bottom: 12px; box-shadow: 2px 2px 3px rgba(0,0,0,0.1);" class="purple-storm">
                    <h2>Staff Portal</h2>
                </div>
            <% } %>
            <% if((member.section == "staff")&&(member.staff == 1)) {%>
                <br>
                <p style="padding: 8px; border: solid 2px red; border-radius: 16px;"><i>Your profile is set as staff but an admin has not yet cleared you as staff.</i></p>
                <br>
            <% } %>
            <div style="display: grid; grid-template-columns: 1fr 2fr; place-items: center; background: url('/img/ui/gem-back.jpg'); border-radius: 8px; box-shadow: 2px 2px 3px rgba(0,0,0,0.1);">
                <div>   
                    <div class="image-wrapper">
                         <a href="/update-profile-photo">
                            <% const srcImage = member.img == null ? "/img/ui/gem.png" : member.img %>
                            <img src="<%= srcImage %>" alt="Member photo for <%= user.firstname %> <%= user.lastname %>">
                        </a>
                        <% if(member.img == null) { %>
                            <span style="color: #fff;">Click image to change profile photo.</span>
                        <% } %>
                    </div>
                </div>
                <div>
                    <h2 style="text-align: center; text-transform: capitalize;"><b><%= user.firstname %> <%= user.lastname %></b> - <%= member.section %>, <%= member.instrument %></h2>
                    <% if(member.contractedIndependent) {%>
                        <p style="text-align: center;">Contracted for <b>Boise Gems Independent</b></p>
                    <% } %>
                    <% if(member.contractedCorps) {%>
                        <p style="text-align: center;">Contracted for <b>Boise Gems Drum & Bugle Corps</b></p>
                    <% } %>
                </div>
            </div>
            <div class="duple-to-single">
                <div style="margin: 24px 8px; padding: 8px; background-color: #dfdfdf; border-radius: 12px; box-shadow: 2px 2px 6px rgba(0,0,0,0.25);">
                    <p><b>Email:</b> <%= member.email %></p>
                    <br>
                    <p><b>Address:</b> <%= member.address %></p>
                    <br>
                    <p><b>Phone:</b> <%= member.phone %></p>
                    <br>
                    <p><b>Birthday:</b> <%= new Date( member.birthday + ((24 * 60 * 60)*1000) ).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).replace(/(\d{1,2})(,)/, '$1th$2') %></p>
                    <br>
                    <p><b>Email verified: </b>✅</p>
                    <br>
                    <% if(!member.staff) { %>
                    <p><b>Balance Due: </b><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(member.owed / 100) %></p>
                    <% } %>
                    <br>
                    <div style="margin: 8px 0; padding: 8px; border-radius: 8px; background:#f5f5f5;">
                        <h3 style="margin-top:0;">Boise Gems Indoor</h3>

                        <% if (member.indoorSection) { %>
                            <p>
                            Section: <strong><%= member.indoorSection %></strong><br/>
                            Instrument:
                            <strong><%= member.indoorInstrument || "Not specified" %></strong>
                            </p>
                        <% } else { %>
                            <p>You’re not currently signed up for Boise Gems Indoor.</p>
                        <% } %>

                        <form action="/member-portal/indoor" method="POST">
                            <label for="indoorSection">Indoor section</label><br/>
                            <select id="indoorSection" name="indoorSection">
                            <option value="">Not this season</option>
                            <option value="Front Ensemble" <%= member.indoorSection === "Front Ensemble" ? "selected" : "" %>>
                                Front Ensemble
                            </option>
                            <option value="Drumline" <%= member.indoorSection === "Drumline" ? "selected" : "" %>>
                                Drumline
                            </option>
                            </select>

                            <br><br>

                            <label for="indoorInstrument">Indoor instrument</label><br/>
                            <input
                            type="text"
                            id="indoorInstrument"
                            name="indoorInstrument"
                            value="<%= member.indoorInstrument || "" %>"
                            placeholder="e.g. Snare, Tenors, Basses, Marimba, Vibes"
                            style="max-width: 280px;"
                            />

                            <br><br>
                            <button type="submit">Save Indoor preference</button>
                        </form>
                        </div>
                </div>
                <div style="margin: 24px 8px; padding: 8px; background-color: #dfdfdf; border-radius: 12px; box-shadow: 2px 2px 6px rgba(0,0,0,0.25);">
                    <% if(contracts.length) { %>
                        <div style="text-align: center;">
                            <h3>You have a membership contract to view!</h3>
                            <% contracts.forEach(contract => { 
                                let groupString = "Corps"

                                if(contract.season.includes("independent")){
                                    groupString = "Independent"
                                }
                                %>
                                <br>
                                <a href="/accept-contract/<%= contract.id %>"><button>View/Accept Contract - <%= groupString %></button></a>
                                <br>
                            <%})%>
                        </div>
                    <% } %>
                    <div style="text-align: center;">
                        <br>
                        <a href="/view-materials"><button>View Audition Materials</button></a>
                        <br>
                        <br>
                        <a href="/files"><button>Music &amp; Files</button></a>
                        <br>
                        <br>
                        <a href="/support/issue"><button>Submit Website Issue</button></a>
                        <br>
                        <br>
                        
                        <a href="/update-emergency"><button>Emergency Contacts</button></a>
                        <br>
                        <br>
                        <a href="/update-address"><button>Change Address</button></a>
                        <br>
                        <br>
                        <% if(member.owed>0) { %>
                            <a href="/make-payment"><button>Make Payment</button></a>
                            <br>
                            <br>
                        <% } %>
                        <% if(!allergy) { %>
                            <h3 style="padding: 8px; border: solid 2px red; border-radius: 16px;"><i>You <b>MUST</b> set your allergy information</i></h3>
                            <br>
                        <% } %>
                        <a href="/allergy-info"><button>Allergy Info</button></a>
                    </div>
                    <br>
                    <% if(!member.staff) { %>
                        <% if((leftoverForms > -5)) { %>
                            <div style="text-align: center;">
                                <% if((leftoverForms > 0)) { %>
                                <h3 style="padding: 8px; border: solid 2px red; border-radius: 16px;"><i>You have required forms to upload!!</i></h3>
                                <% } %>
                                <br>
                                <a href="/member-forms"><button>View Forms</button></a>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div style="text-align: center;">
                            <a href="/audition-member"><button>Audition Member</button></a>
                            <br>
                            <br>
                            <a href="/extend-contract"><button>Extend Contract</button></a>
                            <br>
                            <br>
                            <a href="/set-materials"><button>Set Audition Material</button></a>
                            <br>
                            <br>
                            <a href="/admin/callbacks"><button>Extend Callback</button></a>
                    <br><br>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>