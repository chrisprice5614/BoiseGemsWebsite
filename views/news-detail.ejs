<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= meta?.title || (post.title + " — Boise Gems") %></title>
  <%- include("includes/head") %>

  <% if (meta) { %>
    <meta name="description" content="<%= meta.description %>">
    <link rel="canonical" href="<%= meta.url %>">
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= meta.title %>">
    <meta property="og:description" content="<%= meta.description %>">
    <meta property="og:url" content="<%= meta.url %>">
    <% if (meta.image) { %>
      <meta property="og:image" content="<%= meta.image %>">
      <meta name="twitter:image" content="<%= meta.image %>">
    <% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= meta.title %>">
    <meta name="twitter:description" content="<%= meta.description %>">
  <% } %>

  <!-- styles moved to styles.css -->
</head>
<body>
<header><%- include("includes/header") %></header>

<main>
  <section style="margin:12px">
    <div style="width:100%; aspect-ratio:16/6; background:#eee; background-image:url('/img/publicupload/<%= post.hero %>'); background-size:cover; background-position:center;"></div>

    <% 
      const sharePlainUrl = (meta && meta.url) ? meta.url : ('https://boisegems.org/news/' + post.slug);
      const shareUrl = encodeURIComponent(sharePlainUrl);
      const shareText = encodeURIComponent(post.title);
    %>

    <!-- Share row -->
    <div class="share-row">
      <span class="share-label">Share:</span>

      <!-- Copy link -->
      <a id="share-copy" href="#" class="share-ico" rel="noopener">
        <ion-icon name="link-outline"></ion-icon>
      </a>

      <!-- Facebook -->
      <a class="share-ico" target="_blank" rel="noopener"
         href="https://www.facebook.com/sharer/sharer.php?u=<%= shareUrl %>"
         title="Share on Facebook" aria-label="Share on Facebook">
        <ion-icon name="logo-facebook"></ion-icon>
      </a>

      <!-- X (Twitter) -->
      <a class="share-ico" target="_blank" rel="noopener"
         href="https://twitter.com/intent/tweet?url=<%= shareUrl %>&text=<%= shareText %>"
         title="Share on X" aria-label="Share on X">
        <ion-icon name="logo-twitter"></ion-icon>
      </a>

      <!-- Reddit -->
      <a class="share-ico" target="_blank" rel="noopener"
         href="https://www.reddit.com/submit?url=<%= shareUrl %>&title=<%= shareText %>"
         title="Share on Reddit" aria-label="Share on Reddit">
        <ion-icon name="logo-reddit"></ion-icon>
      </a>

      <!-- Email -->
      <a class="share-ico"
         href="mailto:?subject=<%= shareText %>&body=<%= sharePlainUrl %>"
         title="Share via Email" aria-label="Share via Email">
        <ion-icon name="mail-outline"></ion-icon>
      </a>
    </div>

    <h1 style="margin-top:12px;"><%= post.title %></h1>
    <small><%= new Date(post.created_at).toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) %></small>
    <br><br>
    <div><%- post.html %></div>
    <br>
  </section>
</main>

<footer><%- include("includes/footer") %></footer>

<script>
  // Use existing site toast (showMessage) to confirm copy
  (function(){
    const btn = document.getElementById('share-copy');
    const url = "<%- sharePlainUrl %>";
    if (!btn) return;

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // Fallback copy
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      // Visual tick + toast
      btn.classList.add('copied');
      setTimeout(() => btn.classList.remove('copied'), 1200);
      if (typeof showMessage === 'function') {
        showMessage("Link Copied to Clipboard!");
      }
    });
  })();
</script>
</body>
</html>
