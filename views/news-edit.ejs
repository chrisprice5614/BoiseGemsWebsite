<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit: <%= post.title %> — Boise Gems</title>
  <%- include("includes/head") %>
</head>
<body>
<header><%- include("includes/header") %></header>
<main>
  <section style="margin:12px">
    <h1>Edit Post</h1>
    <form action="/news/<%= post.id %>/edit" method="POST" enctype="multipart/form-data">
      <label>Title</label><br/>
      <input type="text" name="title" required style="width:100%" value="<%= post.title %>"/><br><br>

      <label>Hero Image (leave blank to keep current)</label><br/>
      <input type="file" name="hero" accept="image/*"/><br>
      <% if (post.hero) { %>
        <small>Current: /img/publicupload/<%= post.hero %></small><br>
      <% } %>
      <br>

      <label>Content (HTML)</label><br/>
      <textarea name="html" rows="16" required style="width:100%"><%= post.html %></textarea><br><br>

      <button type="submit">Save</button>
    </form>
  </section>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
