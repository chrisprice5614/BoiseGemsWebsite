<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>News — Boise Gems</title>
  <%- include("includes/head") %>
  <meta name="description" content="Latest news from the Boise Gems Drum & Bugle Corps.">
  <link rel="canonical" href="https://boisegems.org/news">
  <meta property="og:type" content="website">
  <meta property="og:title" content="News — Boise Gems">
  <meta property="og:description" content="Latest news from the Boise Gems Drum & Bugle Corps.">
  <meta property="og:url" content="https://boisegems.org/news">
  <meta name="twitter:card" content="summary_large_image">

  <!-- styles moved to styles.css -->
</head>
<body>
<header><%- include("includes/header") %></header>
<main>
  <section class="news-wrap">
    <h1>News</h1>

    <% if (posts.length === 0) { %>
      <p class="news-empty">No news yet. Check back soon!</p>
    <% } else { %>
      <div class="news-grid">
        <% posts.forEach(p => { 
             const bg = p.hero ? `/img/publicupload/${p.hero}` : '';
        %>
          <article>
            <a class="news-card" href="/news/<%= p.slug %>">
              <div class="news-media" style="background-image:
                <%= bg ? `url('${bg}')` : 
                `linear-gradient(135deg,#f1e7fb,#e9f0ff)` %>;">
              </div>
              <div class="news-body">
                <h3 class="news-title"><%= p.title %></h3>
                <time class="news-date" datetime="<%= new Date(p.created_at).toISOString() %>">
                  <%= new Date(p.created_at).toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) %>
                </time>
              </div>
            </a>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
