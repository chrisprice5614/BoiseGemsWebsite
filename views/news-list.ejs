<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>News — Boise Gems</title>
  <%- include("includes/head") %>
  <meta name="description" content="Latest news from the Boise Gems Drum & Bugle Corps.">
  <link rel="canonical" href="https://boisegems.org/news">
  <meta property="og:type" content="website">
  <meta property="og:title" content="News — Boise Gems">
  <meta property="og:description" content="Latest news from the Boise Gems Drum & Bugle Corps.">
  <meta property="og:url" content="https://boisegems.org/news">
  <meta name="twitter:card" content="summary_large_image">

  <!-- Scoped page styles -->
  <style>
    .news-wrap{margin:12px;max-width:1100px}
    .news-grid{
      display:grid; gap:16px;
      grid-template-columns: repeat(auto-fill,minmax(260px,1fr));
      align-items:start;
    }
    .news-card{
      display:block; border:1px solid #eaeaea; border-radius:12px;
      overflow:hidden; background:#fff; transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease;
    }
    .news-card:hover{ transform:translateY(-2px); box-shadow:0 6px 18px rgba(0,0,0,.08); border-color:#e2e2e2 }
    .news-media{
      width:100%; aspect-ratio:16/9; background:#eee; background-size:cover; background-position:center;
    }
    .news-body{ padding:12px 14px 14px }
    .news-title{ margin:.25rem 0 .35rem; font-size:1.05rem; line-height:1.3 }
    .news-date{ color:#777; font-size:.9rem }
    .news-empty{padding:24px 0;color:#666}
    /* Respect your existing .duple-to-single on small screens */
    @media (max-width:720px){
      .news-grid{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
<header><%- include("includes/header") %></header>
<main>
  <section class="news-wrap">
    <h1>News</h1>

    <% if (posts.length === 0) { %>
      <p class="news-empty">No news yet. Check back soon!</p>
    <% } else { %>
      <div class="news-grid">
        <% posts.forEach(p => { 
             const bg = p.hero ? `/img/publicupload/${p.hero}` : '';
        %>
          <article>
            <a class="news-card" href="/news/<%= p.slug %>">
              <div class="news-media" style="background-image:
                <%= bg ? `url('${bg}')` : 
                `linear-gradient(135deg,#f1e7fb,#e9f0ff)` %>;">
              </div>
              <div class="news-body">
                <h3 class="news-title"><%= p.title %></h3>
                <time class="news-date" datetime="<%= new Date(p.created_at).toISOString() %>">
                  <%= new Date(p.created_at).toLocaleDateString('en-US', {year:'numeric', month:'long', day:'numeric'}) %>
                </time>
              </div>
            </a>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
