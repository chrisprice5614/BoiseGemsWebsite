<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Our History - Boise Gems</title>
  <%- include("includes/head") %>
  <% if (!testSite) { %>
<meta name="description" content="History and leadership for Boise Gems Performing Arts.">
  <link rel="canonical" href="https://boisegems.org/our-history-about">
<% } %>

</head>
<body class="about-page history-page">
<header><%- include("includes/header") %></header>

<section class="about-hero hero-history">
  <div class="about-hero__content">
    <div class="about-hero__card">
      <h1 class="about-hero__title">Our Mission</h1>
      <p class="about-hero__text">
        Our goal is to provide youth with performing arts programs that will enhance their musical appreciation and skills,
        teach self-discipline and self-confidence, and instill dignity and pride in their community, all through music education.
      </p>
    </div>
  </div>
</section>

<section class="history-story" aria-labelledby="history-story-title">
  <div class="history-story__inner">
    <h2 id="history-story-title" class="history-story__title history-reveal">Our History</h2>
    <div class="history-story__prose history-reveal history-reveal--delay"><%- historyHtml %></div>
  </div>
</section>

<section class="about-section about-section--staff">
  <div class="about-wrap">
    <h2>Staff</h2>
    <%- include("includes/staff-gem-wall", { staffSections: staffSections }) %>
  </div>
</section>

<footer><%- include("includes/footer") %></footer>
<script src="/js/our-history-page.js" defer></script>
</body>
</html>
