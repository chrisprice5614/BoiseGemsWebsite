<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems | Transaction History</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <h1 style="text-align: center;">Payment history for</h1>
        <br>
        <div style="padding: 8px;">
            <br>
            <% if(payments.length > 0) { %>
                <% payments.forEach(payment => { %>
                    <div style="margin-bottom: 8px; border: solid #777 1px; background-color: var(--light-half); box-shadow: 0px 1px 4px rgba(0,0,0,0.6); padding: 4px; border-radius: 8px; ">
                        <h3><%= new Date( payment.date ).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }).replace(/(\d{1,2})(,)/, '$1th$2') %> - <%= payment.title %></h3>
                        <hr>
                        <p><%= payment.description %></p>
                        <p><b>Amount: </b><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(payment.amount / 100) %></p>
                        <p><b>Method:</b> <%= payment.method %></p>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>