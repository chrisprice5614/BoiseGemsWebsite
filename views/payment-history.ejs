<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems | Transaction History</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
       <br>
        <h1 style="text-align: center;">Payment history</h1>
        <br>

        <div style="text-align: center; margin-bottom: 16px;">
            <form method="GET" action="/pay-history">
                <label for="search">Search</label>
                <input
                    id="search"
                    type="text"
                    name="search"
                    value="<%= typeof search === 'string' ? search : '' %>">
                <button type="submit">Search</button>
            </form>
        </div>
            <br>
                        <% if (payments.length > 0) { %>
                <% payments.forEach(payment => { %>
                    <div style="margin-bottom: 8px; border: solid 1px var(--dark-quarter); box-shadow: 0px 1px 4px rgba(0,0,0,0.6); padding: 4px; border-radius: 8px;">
                        <h3>
                            <%= new Date(payment.date).toLocaleString("en-US", {
                                month: "long",
                                day: "numeric",
                                year: "numeric",
                                hour: "numeric",
                                minute: "2-digit"
                            }).replace(/(\d{1,2})(,)/, '$1th$2') %>
                            — <%= payment.title %>
                        </h3>
                        <hr>
                        <% if (payment.firstname) { %>
                            <p><b>Paid by:</b>
                                <%= payment.firstname %> <%= payment.lastname %>
                                &lt;<%= payment.email %>&gt;
                            </p>
                        <% } %>
                        <p><%= payment.description %></p>
                        <p><b>Amount: </b>
                            <%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(payment.amount / 100) %>
                        </p>
                        <p><b>Method:</b> <%= payment.method %></p>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No payments to display.</p>
            <% } %>

        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>