<% if(1==1) {
    placeholders = {firstname: "", lastname: "", birthday: "", address: "", phone: "", email: ""}
} %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Boise Gems | Parent Registration</title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="icon" type="image/x-icon" href="/img/ui/favicon.ico" />
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; min-height: 100dvh; }

    .bg {
      min-height: 100dvh;
      background:
        radial-gradient(ellipse at 12% 20%, rgba(157,118,187,.82) 0%, transparent 52%),
        radial-gradient(ellipse at 88%  8%, rgba(72,22,130,.90)   0%, transparent 46%),
        radial-gradient(ellipse at 70% 85%, rgba(67,30,201,.48)   0%, transparent 54%),
        radial-gradient(ellipse at  4% 88%, rgba(140,100,180,.65) 0%, transparent 44%),
        radial-gradient(ellipse at 92% 62%, rgba(96,67,125,.72)   0%, transparent 48%),
        radial-gradient(ellipse at 48% 48%, rgba(255,255,255,.50) 0%, transparent 62%),
        radial-gradient(ellipse at 30% 70%, rgba(180,140,210,.50) 0%, transparent 40%),
        #ddd0f0;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 32px 16px 48px;
    }

    .reg-card {
      background: rgba(255,255,255,.90);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      border: 1px solid rgba(255,255,255,.74);
      border-radius: 22px;
      box-shadow: 0 12px 48px rgba(72,22,130,.22), 0 2px 10px rgba(0,0,0,.09);
      width: 100%;
      max-width: 480px;
      padding: 40px 40px 32px;
    }

    .reg-logo {
      display: block;
      width: 60px;
      height: auto;
      margin: 0 auto 12px;
      filter: drop-shadow(0 2px 10px rgba(96,67,125,.30));
    }

    .reg-title {
      text-align: center;
      font-size: 1.5rem;
      font-weight: 700;
      color: #35166a;
      margin-bottom: 4px;
    }

    .reg-subtitle {
      text-align: center;
      color: #7858a0;
      font-size: .88rem;
      margin-bottom: 24px;
    }

    .error-box {
      background: #fdeaea;
      border: 1.5px solid #f5a0a0;
      border-radius: 10px;
      padding: 10px 14px;
      color: #b02020;
      font-size: .88rem;
      margin-bottom: 10px;
    }

    .field-group { margin-bottom: 16px; }

    .field-group label {
      display: block;
      font-size: .84rem;
      font-weight: 600;
      color: #4a2e7a;
      margin-bottom: 5px;
    }

    .field-group input {
      width: 100%;
      padding: 11px 14px;
      border: 1.5px solid #c8b4e0;
      border-radius: 11px;
      font-size: .95rem;
      background: rgba(255,255,255,.93);
      color: #1a1030;
      outline: none;
      transition: border-color 180ms, box-shadow 180ms;
      font-family: inherit;
    }

    .field-group input:focus {
      border-color: #9d76bb;
      box-shadow: 0 0 0 3.5px rgba(157,118,187,.22);
    }

    .submit-btn {
      width: 100%;
      padding: 13px;
      background: linear-gradient(135deg, #9d76bb 0%, #5c3d80 100%);
      color: #fff;
      border: none;
      border-radius: 11px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: 8px;
      transition: opacity 180ms, transform 100ms;
      box-shadow: 0 4px 16px rgba(80,35,130,.26);
      font-family: inherit;
    }

    .submit-btn:hover  { opacity: .87; }
    .submit-btn:active { transform: scale(.98); }

    .reg-links {
      text-align: center;
      margin-top: 20px;
      font-size: .87rem;
      color: #7858a0;
      border-top: 1px solid rgba(157,118,187,.18);
      padding-top: 16px;
    }

    .reg-links a {
      color: #5c3d80;
      font-weight: 600;
      text-decoration: none;
    }

    .reg-links a:hover { text-decoration: underline; }

    @media (max-width: 520px) {
      .reg-card { padding: 28px 20px 24px; }
    }
  </style>
</head>
<body>
<div class="bg">
  <div class="reg-card">

    <img class="reg-logo" src="/img/ui/gem.png" alt="Boise Gems" />
    <h1 class="reg-title">Parent Registration</h1>
    <p class="reg-subtitle">Boise Gems - Parent / Guardian</p>

    <% if (errors && errors.length) { %>
      <% errors.forEach(function(err) { %>
        <div class="error-box"><%= err %></div>
      <% }) %>
    <% } %>

    <form action="/register-parent" method="POST">

      <div class="field-group">
        <label>First Name</label>
        <input type="text" name="firstname" placeholder="John" value="<%= placeholders.firstname %>" autocomplete="given-name" required />
      </div>

      <div class="field-group">
        <label>Last Name</label>
        <input type="text" name="lastname" placeholder="Doe" value="<%= placeholders.lastname %>" autocomplete="family-name" required />
      </div>

      <div class="field-group">
        <label>Phone Number</label>
        <input type="tel" name="phone" id="phoneNumber" placeholder="(208) 555-5555" value="<%= placeholders.phone %>" autocomplete="tel" required />
      </div>

      <div class="field-group">
        <label>Email</label>
        <input type="email" name="email" placeholder="john@email.com" value="<%= placeholders.email %>" autocomplete="email" required />
      </div>

      <div class="field-group">
        <label>Address</label>
        <input type="text" name="address" placeholder="1234 E Fakestreet, Meridian, Idaho" value="<%= placeholders.address %>" autocomplete="street-address" required />
      </div>

      <div class="field-group">
        <label>Date of Birth</label>
        <input type="date" name="birthday" value="<%= placeholders.birthday ? new Date(placeholders.birthday).toISOString().slice(0,10) : '' %>" required />
      </div>

      <div class="field-group">
        <label>Password <small style="font-weight:400;color:#999;">(min 8 chars)</small></label>
        <input type="password" name="password" autocomplete="new-password" required />
      </div>

      <div class="field-group">
        <label>Confirm Password</label>
        <input type="password" name="passwordRetype" autocomplete="new-password" required />
      </div>

      <div class="field-group">
        <div class="g-recaptcha" data-sitekey="<%= RECAPTCHA_SITE_KEY %>"></div>
      </div>

      <button class="submit-btn" type="submit">Register</button>
    </form>

    <div class="reg-links">
      Already have an account? <a href="/login">Login here</a>
    </div>

  </div>
</div>

<script>
  // Phone formatting - strips US country code (+1) that autofill may prepend
  function normalizePhone(raw) {
    let d = raw.replace(/\D/g, '');
    if (d.length === 11 && d[0] === '1') d = d.slice(1);
    return d.slice(0, 10);
  }

  const phoneInput = document.getElementById('phoneNumber');
  phoneInput.addEventListener('input', e => {
    const v = normalizePhone(e.target.value);
    if      (v.length > 6) e.target.value = `(${v.slice(0,3)}) ${v.slice(3,6)}-${v.slice(6)}`;
    else if (v.length > 3) e.target.value = `(${v.slice(0,3)}) ${v.slice(3)}`;
    else if (v.length > 0) e.target.value = `(${v}`;
    else                   e.target.value = '';
  });
  phoneInput.addEventListener('keypress', e => { if(!/[\d+]/.test(e.key)) e.preventDefault(); });
</script>
</body>
</html>