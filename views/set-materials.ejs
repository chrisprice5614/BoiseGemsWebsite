<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Audition Materials - Boise Gems</title>
    <%- include("includes/head") %>
    <style>
        .mat-upload-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 6px;
        }
        .mat-upload-row input[type="file"] {
            flex: 1;
            min-width: 0;
        }
        .btn-view-mat {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 6px;
            background: #e8f0fe;
            border: 1px solid #4285f4;
            color: #1a73e8;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
        }
        .btn-view-mat:hover {
            background: #d2e3fc;
        }
        .btn-remove-mat {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 6px;
            background: #fdeaea;
            border: 1px solid #e57373;
            color: #b02020;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            white-space: nowrap;
        }
        .btn-remove-mat:hover { background: #f8cfcf; }
        .current-badge {
            font-size: 0.78rem;
            color: #388e3c;
            font-weight: 600;
        }
        .no-badge {
            font-size: 0.78rem;
            color: #999;
        }
    </style>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <div style="padding: 8px; max-width: 700px; margin: 0 auto;">
            <br>
            <h1 style="text-align: center;">Update Audition Materials</h1>
            <p style="text-align:center; color:#555;">Upload new PDFs to replace existing audition materials for each section. Only fields with a selected file will be updated.</p>
            <br>
            <%
              const matSections = [
                { field: "brass", key: "brass", label: "Brass Audition Materials", id: "upload-brass" },
                { field: "drumline", key: "drumline", label: "Drumline Audition Materials", id: "upload-drumline" },
                { field: "guard", key: "guard", label: "Guard Audition Materials", id: "upload-guard" },
                { field: "front", key: "front ensemble", label: "Front Ensemble Audition Materials", id: "upload-front" },
                { field: "drum_major", key: "drum major", label: "Drum Major Audition", id: "upload-drum-major" },
                { field: "drumline_independent", key: "drumline (independent)", label: "Drumline (Independent) Audition", id: "upload-drumline-ind" },
                { field: "front_independent", key: "front ensemble (independent)", label: "Front Ensemble (Independent) Audition", id: "upload-front-ind" }
              ];
            %>
            <form action="/set-materials" method="POST" enctype="multipart/form-data">
                <% matSections.forEach(function (sec) {
                     const link = materials && materials[sec.key];
                %>
                <label for="<%= sec.id %>"><strong><%= sec.label %></strong></label>
                <div style="margin: 4px 0 2px;">
                    <% if (link) { %>
                        <span class="current-badge">✓ Current file on record</span>
                    <% } else { %>
                        <span class="no-badge">No file uploaded yet</span>
                    <% } %>
                </div>
                <div class="mat-upload-row">
                    <input type="file" name="<%= sec.field %>" id="<%= sec.id %>" accept="application/pdf"/>
                    <% if (link) { %>
                        <a class="btn-view-mat" href="<%= link %>" target="_blank" rel="noopener">View Current</a>
                    <% } %>
                </div>
                <br>
                <% }) %>

                <small>Only PDFs you select will be updated. Uploading a PDF will <i>overwrite</i> the previous PDF for that section.</small>
                <br>
                <div style="text-align: center; margin-top: 16px;">
                    <button>Save Materials</button>
                </div>
            </form>

            <% if (admin) { %>
              <div style="margin-top: 28px;">
                <h2 style="font-size:1.1rem; margin:0 0 10px;">Remove materials</h2>
                <p style="color:#666; font-size:0.9rem; margin:0 0 12px;">Clear a section so it shows as Coming soon on the public page.</p>
                <% matSections.forEach(function (sec) {
                     const link = materials && materials[sec.key];
                     if (!link) return;
                %>
                  <form action="/set-materials/remove" method="POST" style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:8px;flex-wrap:wrap;"
                        onsubmit="return confirm('Remove the PDF for <%= sec.label %>?');">
                    <span><%= sec.label %></span>
                    <input type="hidden" name="return_to" value="/set-materials">
                    <input type="hidden" name="section" value="<%= sec.field %>">
                    <button type="submit" class="btn-remove-mat">Remove PDF</button>
                  </form>
                <% }) %>
              </div>
            <% } %>
            <br>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>
