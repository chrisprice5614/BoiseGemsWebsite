<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <div style="padding: 12px;">
            <div class="form-panel">
<form action="/set-tuition" method="POST">
                <br>
                  <label for="corps">Set Corps Fees in Dollars</label>
                <input
                  type="number"
                  name="corps"
                  step="0.01"
                  autocomplete="off"
                  value="<%= corpsFees.amount/100 %>"
                  required
                />
                <br><br>

                <label for="corps_deposit">Corps Deposit (Down Payment) in Dollars</label>
                <input
                  type="number"
                  name="corps_deposit"
                  step="0.01"
                  autocomplete="off"
                  value="<%= (corpsFees.deposit_amount || 5000)/100 %>"
                  required
                />
                <br><br>

                <label for="independent">Set Independent Fees in Dollars</label>
                <input
                  type="number"
                  name="independent"
                  step="0.01"
                  autocomplete="off"
                  value="<%= independentFees.amount/100 %>"
                  required
                />
                <br><br>

                <label for="independent_deposit">Independent Deposit (Down Payment) in Dollars</label>
                <input
                  type="number"
                  name="independent_deposit"
                  step="0.01"
                  autocomplete="off"
                  value="<%= (independentFees.deposit_amount || 5000)/100 %>"
                  required
                />
                <br><br>

                <label for="affiliate">Set Affiliate Fees in Dollars</label>
                <input
                  type="number"
                  name="affiliate"
                  step="0.01"
                  autocomplete="off"
                  value="<%= affiliateFees.amount/100 %>"
                  required
                />
                <br><br>

                <label for="affiliate_deposit">Affiliate Deposit (Down Payment) in Dollars</label>
                <input
                  type="number"
                  name="affiliate_deposit"
                  step="0.01"
                  autocomplete="off"
                  value="<%= (affiliateFees.deposit_amount || 5000)/100 %>"
                  required
                />
                <br><br>

                <div style="text-align: center;">
                    <button>Set Fees</button>
                </div>
            </form>
</div>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>