                <div class="esto-pic">
                    <img src="/img/shows/2026/bgi-2026-10.jpg" alt="Boise Gems 2026 Color of Chaos">
                </div>
            </div>

            <br>
            <br>
            <h1 style="font-size: clamp(2rem, 5vw, 4rem); text-align: center; font-weight: 700; text-transform: uppercase;">Performances</h1>
            <br>
            <div id="map"></div>

            <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
            <script>
                const events = <%- JSON.stringify(events) %>;

                const map = L.map('map').setView([<%- center[0] %>, <%- center[1] %>], 5);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                const latlngs = [];

                events.forEach(event => {
                    const marker = L.marker(event.coords).addTo(map);
                    marker.bindPopup(`<b>${event.location}</b><br>${event.date}`);
                    latlngs.push(event.coords);
                });

                L.polyline(latlngs, {
                    color: '#cc0000',
                    weight: 4,
                    opacity: 0.8
                }).addTo(map);
            </script>

