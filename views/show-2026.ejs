        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
<script>
    const back2El = document.getElementById('chaos-back2');
    const logoContent = document.querySelector('.chaos-hero__content');

    // --- Continuously rotating gradient at 0.5Hz (one full rotation every 2s) ---
    const DEG_PER_MS = 360 / 4000;
    let angle = 0;
    let lastTime = null;

    function setMaskAngle(a) {
        const mask = `linear-gradient(${a}deg, transparent 0%, black 100%)`;
        back2El.style.webkitMaskImage = mask;
        back2El.style.maskImage = mask;
    }

    function tick(timestamp) {
        if (lastTime !== null) {
            angle = (angle + DEG_PER_MS * (timestamp - lastTime)) % 360;
        }
        lastTime = timestamp;
        setMaskAngle(angle);
        requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);

    // --- Logo parallax ---
    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
    const MAX_SHIFT = 24; // px

    if (!isMobile) {
        document.addEventListener('mousemove', (e) => {
            const hero = document.getElementById('chaos-hero');
            const rect = hero.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const tx = ((e.clientX - cx) / (rect.width  / 2)) * MAX_SHIFT;
            const ty = ((e.clientY - cy) / (rect.height / 2)) * MAX_SHIFT;
            logoContent.style.transform = `translate(${tx}px, ${ty}px)`;
        });
    } else {
        function listenOrientation() {
            window.addEventListener('deviceorientation', (e) => {
                const tx = Math.max(-MAX_SHIFT, Math.min(MAX_SHIFT, ((e.gamma || 0) / 45) * MAX_SHIFT));
                const ty = Math.max(-MAX_SHIFT, Math.min(MAX_SHIFT, ((e.beta  || 0) / 45) * MAX_SHIFT));
                logoContent.style.transform = `translate(${tx}px, ${ty}px)`;
            });
        }

        if (typeof DeviceOrientationEvent !== 'undefined' &&
            typeof DeviceOrientationEvent.requestPermission === 'function') {
            document.addEventListener('touchstart', async () => {
                try {
                    const perm = await DeviceOrientationEvent.requestPermission();
                    if (perm === 'granted') listenOrientation();
                } catch(e) {}
            }, { once: true });
        } else {
            listenOrientation();
        }
    }
</script>
</body>
</html>
