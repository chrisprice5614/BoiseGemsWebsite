<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
                <div style="padding: 12;">
            <form action="/sign-contract/<%= contractExtension.id %>" method="POST" enctype="multipart/form-data">

                <div style="align-items: center; display: flex; gap: 8px;">
                    <label for="read">I have read and agree to the contract.</label>
                    <input type="checkbox" id="read" name="read" required/>
                </div>
                <br>
                <br>

                <label for="signature">Electronic Signature</label>
                <input type="text" id="signature" name="signature" value="" required/>
                <br>
                <br>

                <label for="date">Today's Date</label>
                <input type="date" id="date" name="date" required/>
                <br>
                <br>

                <label for="signed_contract">
                  Upload your <strong>signed contract (PDF)</strong>
                </label>
                <input
                  type="file"
                  id="signed_contract"
                  name="signed_contract"
                  accept="application/pdf"
                  required
                />
                <br>
                <br>
                <div style="align-items: center; display: flex; gap: 8px;">
                    <label for="pay_with_cash">Pay down payment with cash/check (no online payment)</label>
                    <input type="checkbox" id="pay_with_cash" name="pay_with_cash" />
                </div>
                <div style="color:#555; font-size:0.9em; margin-top:6px;">
                  If selected, your contract will be signed now and you can pay the down payment in cash/check later. You won't be sent to Stripe.
                </div>
                <br>
                <br>

                <div style="text-align: center;">
                    <button id="signSubmitBtn">Sign &amp; Continue to Payment</button>
                </div>
            </form>
        </div>

    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>

<script>
    (function(){
        const cashCb = document.getElementById('pay_with_cash');
        const btn = document.getElementById('signSubmitBtn');
        if (cashCb && btn) {
            const updateText = () => {
                btn.textContent = cashCb.checked ? 'Sign Contract (Pay Cash/Check Later)' : 'Sign & Continue to Payment';
            };
            cashCb.addEventListener('change', updateText);
            updateText();
        }
    })();
</script>