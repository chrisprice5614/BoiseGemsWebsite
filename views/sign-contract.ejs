<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
                <div style="padding: 12;">
            <form action="/sign-contract/<%= contractExtension.id %>" method="POST" enctype="multipart/form-data">

                <div style="align-items: center; display: flex; gap: 8px;">
                    <label for="read">I have read and agree to the contract.</label>
                    <input type="checkbox" id="read" name="read" required/>
                </div>
                <br>
                <br>

                <label for="signature">Electronic Signature</label>
                <input type="text" id="signature" name="signature" value="" required/>
                <br>
                <br>

                <label for="date">Today's Date</label>
                <input type="date" id="date" name="date" required/>
                <br>
                <br>

                <label for="signed_contract">
                  Upload your <strong>signed contract (PDF)</strong>
                </label>
                <input
                  type="file"
                  id="signed_contract"
                  name="signed_contract"
                  accept="application/pdf"
                  required
                />
                <br>
                <br>
                <div style="align-items: center; display: flex; gap: 8px;">
                    <label for="read">I will be paying with a check/cash for the down payment.</label>
                    <input type="checkbox" id="check" name="check" required/>
                </div>
                <br>
                <br>

                <div style="text-align: center;">
                    <button>Sign &amp; Continue to Payment</button>
                </div>
            </form>
        </div>

    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>