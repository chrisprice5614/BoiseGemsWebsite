<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Staff Admin - Boise Gems</title>
  <%- include("includes/head") %>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
  <style>
    .staff-admin-lead-hint { margin: 6px 0 0; font-size: 0.9rem; color: #6b5585; }
    .staff-admin-row {
      cursor: grab;
      touch-action: none;
      user-select: none;
    }
    .staff-admin-row:active { cursor: grabbing; }
    .staff-admin-row.sortable-ghost { opacity: 0.45; }
    .staff-admin-row.sortable-chosen { box-shadow: 0 6px 18px rgba(0,0,0,0.12); }
    .staff-admin-grip {
      flex: 0 0 auto;
      width: 22px;
      color: #9a86b0;
      font-size: 1.1rem;
      line-height: 1;
      letter-spacing: -1px;
      cursor: grab;
      text-align: center;
    }
    .staff-admin-row-actions { cursor: default; user-select: auto; }
  </style>
</head>
<body class="staff-admin-page">
<header><%- include("includes/header") %></header>

<main class="staff-admin-main">
  <div class="staff-admin-head">
    <div>
      <h1>Staff Admin</h1>
      <p class="staff-admin-lead">Manage public staff profiles. Each person can hold multiple categories with their own position title.</p>
      <p class="staff-admin-lead-hint">Drag rows by the ⋮⋮ handle to reorder within a category. Order saves automatically.</p>
    </div>
    <a href="/staff/new"><button type="button">+ Add Staff Member</button></a>
  </div>

  <% if (Object.keys(grouped).length === 0) { %>
    <div class="form-panel"><p>No staff yet. Add someone to get started.</p></div>
  <% } else { %>
    <% Object.keys(grouped).forEach(function(catName) {
      var block = grouped[catName];
      var cat = block.category;
    %>
    <section class="staff-admin-category form-panel">
      <h2 class="staff-admin-category-title"><%= catName %></h2>
      <p class="staff-admin-category-meta">Shown as "<%= cat.section_title %>"<% if (cat.pages && cat.pages.length) { %> · <%= cat.pages.join(', ') %><% } %></p>
      <div class="staff-admin-rows" data-category-id="<%= cat.id %>">
        <% block.rows.forEach(function(row) { %>
        <div class="staff-admin-row card" data-placement-id="<%= row.placement_id %>">
          <span class="staff-admin-grip" aria-hidden="true" title="Drag to reorder">⋮⋮</span>
          <img src="<%= row.image ? ('/img/publicupload/' + row.image) : '/img/ui/gem.png' %>" alt="" class="staff-admin-row-photo">
          <div class="staff-admin-row-body">
            <div class="staff-admin-row-name"><%= row.first %> <%= row.last %></div>
            <div class="staff-admin-row-role"><%= row.position_title %></div>
          </div>
          <div class="staff-admin-row-actions">
            <a href="/staff/<%= row.id %>/edit"><button type="button">Edit</button></a>
            <form method="POST" action="/staff/<%= row.id %>/delete" onsubmit="return confirm('Delete <%= row.first %> <%= row.last %> entirely?');">
              <button type="submit" class="staff-admin-delete-btn">Delete</button>
            </form>
          </div>
        </div>
        <% }); %>
      </div>
    </section>
    <% }); %>
  <% } %>
</main>
<footer><%- include("includes/footer") %></footer>
<script>
(function () {
  if (typeof Sortable === 'undefined') {
    console.error('SortableJS failed to load');
    return;
  }
  document.querySelectorAll('.staff-admin-rows[data-category-id]').forEach(function (list) {
    new Sortable(list, {
      animation: 150,
      draggable: '.staff-admin-row',
      filter: '.staff-admin-row-actions, .staff-admin-row-actions *',
      preventOnFilter: true,
      onEnd: function () {
        var categoryId = Number(list.dataset.categoryId);
        var placementIds = Array.from(list.querySelectorAll('.staff-admin-row[data-placement-id]')).map(function (el) {
          return Number(el.dataset.placementId);
        });
        fetch('/staff/reorder-placements', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ categoryId: categoryId, placementIds: placementIds })
        }).then(function (r) {
          if (!r.ok) throw new Error('save failed');
          return r.json();
        }).catch(function () {
          if (window.bgAlert) bgAlert('Could not save the new order. Refresh and try again.');
          else alert('Could not save the new order. Refresh and try again.');
        });
      }
    });
  });
})();
</script>
</body>
</html>
