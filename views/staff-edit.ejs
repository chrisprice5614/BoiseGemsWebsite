<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Staff — Boise Gems</title>
  <%- include("includes/head") %>
</head>
<body>
<header><%- include("includes/header") %></header>
<main>
<div style="margin:12px; max-width:780px;">
  <h1>Edit Staff Member</h1>

  <div style="display:flex; gap:12px; align-items:center; margin-bottom:12px;">
    <img src="<%= staffer.image ? ('/img/publicupload/' + staffer.image) : '/img/ui/gem.png' %>"
         alt=""
         style="width:72px; height:72px; object-fit:cover; border-radius:8px;">
    <div class="muted"><%= staffer.first %> <%= staffer.last %></div>
  </div>

  <form action="/staff/<%= staffer.id %>/edit" method="POST" enctype="multipart/form-data">
    <div class="duple-to-single">
      <div>
        <label>First Name</label>
        <input type="text" name="first" value="<%= staffer.first %>" required>
      </div>
      <div>
        <label>Last Name</label>
        <input type="text" name="last" value="<%= staffer.last %>" required>
      </div>
    </div>

    <div>
      <label>Position/Title</label>
      <input type="text" name="position" value="<%= staffer.position %>" required>
    </div>

    <div class="duple-to-single">
      <div>
        <label>Category</label>
        <select name="category">
          <% categories.forEach(c => { %>
            <option value="<%= c %>" <%= c===staffer.category ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label>Replace Image (optional)</label>
        <input type="file" name="image" accept="image/*">
        <small class="muted">Leave blank to keep current. Default used if empty: /img/ui/gem.png</small>
      </div>
    </div>

    <div>
      <label>Short Bio</label>
      <textarea name="bio" rows="6"><%= staffer.bio %></textarea>
    </div>

    <div style="margin-top:12px;">
      <button type="submit">Save</button>
      <a href="/staff-admin"><button type="button">Cancel</button></a>
    </div>
  </form>
</div>
</main>
<footer><%- include("includes/footer") %></footer>
</body>
</html>
