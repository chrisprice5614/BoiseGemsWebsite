<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Staff - Boise Gems</title>
  <%- include("includes/head") %>
</head>
<body class="staff-admin-page">
<header><%- include("includes/header") %></header>
<main class="staff-admin-main">
  <div class="staff-admin-head">
    <div>
      <a href="/staff-admin" class="staff-admin-back">← Staff Admin</a>
      <h1>Edit Staff Member</h1>
      <p class="staff-admin-lead"><%= staffer.first %> <%= staffer.last %></p>
    </div>
  </div>

  <div class="form-panel staff-admin-form-panel">
    <form action="/staff/<%= staffer.id %>/edit" method="POST" enctype="multipart/form-data" id="staffForm">
      <div class="staff-form-grid">
        <div class="staff-form-photo">
          <label class="staff-form-photo-label" for="staffPhotoInput">
            <img id="staffPhotoPreview" src="<%= staffer.image ? ('/img/publicupload/' + staffer.image) : '/img/ui/gem.png' %>" alt="">
            <span class="staff-form-photo-hint">Click to replace photo</span>
          </label>
          <input type="file" id="staffPhotoInput" name="image" accept="image/*" hidden>
        </div>

        <div class="staff-form-fields">
          <div class="staff-form-row">
            <label class="staff-field">
              <span class="staff-field-label">First name</span>
              <input type="text" name="first" value="<%= staffer.first %>" required autocomplete="given-name">
            </label>
            <label class="staff-field">
              <span class="staff-field-label">Last name</span>
              <input type="text" name="last" value="<%= staffer.last %>" required autocomplete="family-name">
            </label>
          </div>

          <label class="staff-field">
            <span class="staff-field-label">Bio</span>
            <textarea name="bio" rows="5"><%= staffer.bio || '' %></textarea>
          </label>

          <div class="staff-form-row">
            <label class="staff-field">
              <span class="staff-field-label">Email <span class="staff-field-optional">(optional)</span></span>
              <input type="email" name="email" value="<%= staffer.email || '' %>" autocomplete="email" placeholder="contact@example.com">
            </label>
            <label class="staff-field">
              <span class="staff-field-label">Phone <span class="staff-field-optional">(optional)</span></span>
              <input type="tel" id="staffPhoneInput" name="phone" value="<%= staffer.phone || '' %>" autocomplete="tel" placeholder="(208) 555 - 0100" inputmode="tel">
            </label>
          </div>
        </div>
      </div>

      <div class="staff-placements-block">
        <div class="staff-placements-head">
          <h2 class="staff-placements-title">Categories &amp; position titles</h2>
          <p class="staff-placements-hint">Each category controls where this person appears. Type their title for that role.</p>
        </div>
        <div id="staffPlacementsList" class="staff-placements-list"></div>
        <button type="button" class="staff-add-placement-btn" id="staffAddPlacement">+ Add category</button>
      </div>

      <div class="staff-form-actions">
        <button type="submit">Save changes</button>
        <a href="/staff-admin"><button type="button" class="staff-cancel-btn">Cancel</button></a>
      </div>
    </form>
  </div>
</main>
<footer><%- include("includes/footer") %></footer>
<script>
  window.STAFF_CATEGORIES = <%- JSON.stringify(categories.map(function(c) {
    return { id: c.id, name: c.name, pages: c.pages };
  })) %>;
  window.STAFF_INITIAL_PLACEMENTS = <%- JSON.stringify((placements || []).map(function(p) {
    return { category_id: p.category_id, position_title: p.position_title };
  })) %>;
</script>
<script src="/js/staff-phone.js"></script>
<script src="/js/staff-form.js"></script>
</body>
</html>
