<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <style>
        #map { height: 50vh; width: 100%; }
        body, html { margin: 0; padding: 0; }
    </style>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <div id="map"></div>

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script>
        const events = <%- JSON.stringify(events) %>;

        const map = L.map('map').setView([39.5, -98.35], 4); // Centered on USA

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        const latlngs = [];

        events.forEach(event => {
        const marker = L.marker(event.coords).addTo(map);
        marker.bindPopup(`<b>${event.location}</b><br>${event.date}`);
        latlngs.push(event.coords);
        });

        // Draw polyline connecting all events
        L.polyline(latlngs, {
        color: 'purple',
        weight: 4,
        opacity: 0.7
        }).addTo(map);
    </script>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>