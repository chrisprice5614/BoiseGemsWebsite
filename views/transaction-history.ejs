<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems | Transaction History</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <h1 style="text-align: center;">Payment history for <%= thisUser.firstname %> <%= thisUser.lastname %></h1>
        <br>
        <div style="text-align: center;">
            <a href="/add-transaction/<%= thisUser.id %>"><button>Add Transaction</button></a>
        </div>
        <br>
        <% if (typeof flashMessage !== "undefined" && flashMessage) { %>
          <p style="text-align:center;padding:8px 12px;border-radius:8px;background:#e6f4ea;border:1px solid #34a853;max-width:640px;margin:0 auto 12px;">
            <%= flashMessage %>
          </p>
        <% } %>
        <div style="padding: 8px;">
            <div class="duple-to-single" style="text-align: center;">
                <div>
                    <h3>Amount Currently Owed</h3>
                    <p><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(thisUser.owed / 100) %></p>
                </div>
                <div>
                    <h3>Total Amount Paid</h3>
                    <p><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(thisUser.paid / 100) %></p>
                </div>
            </div>
            <br>
            <% const chrisView = typeof isChrisViewer !== "undefined" && isChrisViewer; %>
            <% if(payments.length > 0) { %>
                <% payments.forEach(payment => {
                  const isCharge = String(payment.method || "") === "Charge";
                  const towardsBalance = !isCharge && Number(payment.towards_balance) === 1;
                  const cardStyle = towardsBalance && chrisView
                    ? "margin-bottom: 8px; border: solid #34a853 2px; background-color: #e6f4ea; box-shadow: 0px 1px 4px rgba(0,0,0,0.6); padding: 4px; border-radius: 8px;"
                    : "margin-bottom: 8px; border: solid #777 1px; background-color: var(--light-half); box-shadow: 0px 1px 4px rgba(0,0,0,0.6); padding: 4px; border-radius: 8px;";
                %>
                    <div style="<%= cardStyle %>">
                        <h3><% if(isCharge) {%><b style="color: rgb(17, 35, 79)">CHARGE</b> <% } else {%><span style="color: rgb(120, 79, 196)">Payment</span> <% } %><%= new Date( payment.date ).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true }).replace(/(\d{1,2})(,)/, '$1th$2') %> - <%= payment.title %></h3>
                        <hr>
                        <p><%= payment.description %></p>
                        <p><b>Amount: </b><% if(isCharge) {%>+<% } %><%= new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(payment.amount / 100) %></p>
                        <p><b>Method:</b> <%= payment.method %></p>
                        <% if (chrisView && towardsBalance) { %>
                          <p style="color:#1e6e2e;font-weight:600;margin:6px 0;">Towards balance</p>
                        <% } %>
                        <% if (chrisView && !isCharge && !towardsBalance) { %>
                          <form method="POST" action="/transaction-edit/<%= thisUser.id %>/towards-balance/<%= payment.id %>" style="margin-top:8px;"
                                onsubmit="return confirm('Apply this payment towards <%= thisUser.firstname %>\'s balance (update owed/paid)?');">
                            <button type="submit" style="background:#e6f4ea;border:1px solid #34a853;color:#1e6e2e;padding:6px 12px;border-radius:6px;cursor:pointer;font-weight:600;">
                              Towards balance
                            </button>
                          </form>
                        <% } %>
                        <% if (chrisView) {
                          const fmt = (c) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format((Number(c) || 0) / 100);
                          const defs = payment.deleteDefaults || { owedRestoreCents: 0, paidReduceCents: 0 };
                          const chrisMatch = payment.chrisMatch;
                          const dupIds = payment.duplicateIds || [];
                        %>
                          <p style="font-size:0.8rem;color:#666;margin:6px 0;word-break:break-all;">
                            #<%= payment.id %>
                            <% if (payment.stripe_payment_intent_id) { %> &middot; <%= payment.stripe_payment_intent_id %><% } %>
                            <% if (payment.stripe_session_id) { %> &middot; <%= payment.stripe_session_id %><% } %>
                            <% if (!payment.stripe_payment_intent_id && !payment.stripe_session_id && String(payment.method || '').toLowerCase() === 'stripe') { %> &middot; no Stripe id<% } %>
                          </p>
                          <% if (dupIds.length) { %>
                            <p style="color:#b3261e;font-weight:700;margin:6px 0;">
                              Possible duplicate of <%= dupIds.map(function (id) { return '#' + id; }).join(', ') %>
                            </p>
                          <% } %>
                          <details style="margin-top:8px;">
                            <summary style="cursor:pointer;color:#b3261e;font-weight:600;">Delete payment</summary>
                            <form method="POST" action="/transaction-edit/<%= thisUser.id %>/delete/<%= payment.id %>"
                                  style="margin-top:8px;padding:10px;border:1px solid #f1b8b4;border-radius:8px;background:#fdf1f0;"
                                  onsubmit="return confirm('Delete payment #<%= payment.id %> (<%= fmt(payment.amount) %>)? This cannot be undone and Stripe reconcile will not re-add it.');">
                              <label style="display:block;margin-bottom:6px;">
                                Add back to amount owed ($)
                                <input type="number" step="0.01" name="owed_restore" value="<%= (defs.owedRestoreCents / 100).toFixed(2) %>" style="width:120px;margin-left:6px;">
                              </label>
                              <label style="display:block;margin-bottom:6px;">
                                Subtract from total paid ($)
                                <input type="number" step="0.01" name="paid_reduce" value="<%= (defs.paidReduceCents / 100).toFixed(2) %>" style="width:120px;margin-left:6px;">
                              </label>
                              <% if (chrisMatch) { %>
                                <input type="hidden" name="chris_row_id" value="<%= chrisMatch.id %>">
                                <label style="display:block;margin-bottom:6px;">
                                  <input type="checkbox" name="delete_chris" value="1" checked>
                                  Also delete Chris share <%= fmt(chrisMatch.amount) %>
                                  (<%= new Date(chrisMatch.created_at).toLocaleString('en-US') %>)
                                </label>
                              <% } else { %>
                                <p style="margin:6px 0;color:#666;">No matching Chris share found for this payment.</p>
                              <% } %>
                              <button type="submit" style="background:#b3261e;border:1px solid #8c1d18;color:#fff;padding:6px 12px;border-radius:6px;cursor:pointer;font-weight:600;">
                                Delete payment #<%= payment.id %>
                              </button>
                            </form>
                          </details>
                        <% } %>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>
