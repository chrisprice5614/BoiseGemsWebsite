<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>

    <!-- styles moved to styles.css -->

</head>
<body>
<header>
    <%- include("includes/header") %>
</header>
<main>
    <form action="/update-emergency" method="POST" id="emergencyContactForm">
    <div class="contacts-grid">
        <% emergencyContacts.forEach((contact, i) => { %>
        <div class="contact-block" data-index="<%= i + 1 %>">
            <input type="hidden" name="contacts[<%= contact.id %>][id]" value="<%= contact.id %>" />

            <div class="contact-header">
            <div class="contact-title">Emergency Contact <%= i + 1 %></div>
            <span class="contact-chip">Existing</span>
            </div>

            <div class="field">
            <label>Name</label>
            <input type="text" name="contacts[<%= contact.id %>][name]" autocomplete="off" placeholder="Jane Doe" value="<%= contact.name %>" required/>
            </div>

            <div class="field">
            <label>Email</label>
            <input type="email" name="contacts[<%= contact.id %>][email]" autocomplete="off" placeholder="jane@example.com" value="<%= contact.email %>" required/>
            </div>

            <div class="field">
            <label>Phone</label>
            <input type="text" class="phone-input" name="contacts[<%= contact.id %>][phone]" autocomplete="off" placeholder="(208) 555-5555" value="<%= contact.phone %>" required/>
            </div>
        </div>
        <% }) %>

        <!-- Container for new contact blocks -->
        <div id="newContactsContainer"></div>
    </div>

    <div class="actions">
        <button type="button" class="btn btn-primary" onclick="addNewContact()">+ Add Emergency Contact</button>
        <button type="submit" class="btn btn-primary">Update Emergency Contacts</button>
    </div>
    </form>


    <script>
  let newContactCount = 0;

  function nextContactNumber(){
    // count existing + new to produce sequential titles
    const existing = document.querySelectorAll('.contact-block').length;
    return existing + 1;
  }

  function addNewContact() {
    const container = document.getElementById('newContactsContainer');
    const num = nextContactNumber();

    const newContactHTML = `
      <div class="contact-block" data-index="${num}">
        <input type="hidden" name="contacts[-${newContactCount}][id]" value="-1" />

        <div class="contact-header">
          <div class="contact-title">Emergency Contact ${num}</div>
          <span class="contact-chip">New</span>
        </div>

        <div class="field">
          <label>Name</label>
          <input type="text" name="contacts[-${newContactCount}][name]" autocomplete="off" placeholder="New Name" required/>
        </div>

        <div class="field">
          <label>Email</label>
          <input type="email" name="contacts[-${newContactCount}][email]" autocomplete="off" placeholder="new@email.com" required/>
        </div>

        <div class="field">
          <label>Phone</label>
          <input type="text" class="phone-input" name="contacts[-${newContactCount}][phone]" autocomplete="off" placeholder="(555) 555-5555" required/>
        </div>
      </div>
    `;

    container.insertAdjacentHTML('beforeend', newContactHTML);
    newContactCount++;
    attachPhoneFormatters(); // reattach formatting for new inputs
  }

  function formatPhoneNumber(value) {
    let numbers = value.replace(/\D/g, "");
    if (numbers.length === 11 && numbers.startsWith("1")) {
      numbers = numbers.substring(1);
    }
    numbers = numbers.substring(0, 10);

    let formatted = numbers;
    if (numbers.length > 6) {
      formatted = `(${numbers.substring(0,3)}) ${numbers.substring(3,6)}-${numbers.substring(6,10)}`;
    } else if (numbers.length > 3) {
      formatted = `(${numbers.substring(0,3)}) ${numbers.substring(3)}`;
    } else if (numbers.length > 0) {
      formatted = `(${numbers}`;
    }
    return formatted;
  }

  function attachPhoneFormatters() {
    document.querySelectorAll(".phone-input").forEach(input => {
      if (input.dataset.formatted) return;
      input.dataset.formatted = "true";

      input.addEventListener("input", () => {
        const raw = input.value;
        const formatted = formatPhoneNumber(raw);
        input.value = formatted;
        input.setSelectionRange(input.value.length, input.value.length);
      });

      input.addEventListener("paste", (e) => {
        e.preventDefault();
        const text = (e.clipboardData || window.clipboardData).getData("text");
        input.value = formatPhoneNumber(text);
        input.setSelectionRange(input.value.length, input.value.length);
      });
    });
  }

  // Initialize formatters on page load
  attachPhoneFormatters();
</script>


</main>
<footer>
    <%- include("includes/footer") %>
</footer>
</body>
</html>
