<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boise Gems</title>
  <%- include("includes/head") %>
</head>
<body>
  <header>
    <%- include("includes/header") %>
  </header>
  <main>
    <div style="padding: 8px">
      <br>
      <h1 style="text-align: center;">Update Profile Photo</h1>
      <br>
      <form id="photoForm" method="POST" action="/update-profile-photo" enctype="multipart/form-data">
        <input type="file" name="photo" accept="image/*" required />
        <br><br>
        <button type="submit">Save Profile Photo</button>
      </form>
      <br>
    </div>
  </main>
  <footer>
    <%- include("includes/footer") %>
  </footer>
</body>
</html>
