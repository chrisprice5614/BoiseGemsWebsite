<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= thisForm.title %> | Boise Gems</title>
  <%- include("includes/head") %>
  <link rel="stylesheet" href="/css/form-wizard.css">
</head>
<body>
<header><%- include("includes/header") %></header>
<main class="form-fill"
      id="formFillRoot"
      data-pdf="<%= thisForm.document_path || '' %>"
      data-fields='<%- JSON.stringify(typeof formFields !== "undefined" ? formFields : []).replace(/'/g, "&#39;") %>'
      data-prefill='<%- JSON.stringify(typeof existingFieldValues !== "undefined" ? existingFieldValues : {}).replace(/'/g, "&#39;") %>'>

  <div class="form-fill__intro">
    <h1><%= thisForm.title %></h1>
    <p style="margin:0;font-size:1.05rem;line-height:1.45;"><%= thisForm.description %></p>
    <p style="margin:14px 0 0;color:#6b5585;">
      You can submit with some boxes blank and come back later.
      Prior signatures stay locked so parent and child can both sign the same form legally.
      <% if (typeof existingUpload !== "undefined" && existingUpload) { %>
        <br><strong>This form already has saved fields</strong> — blank boxes are waiting for another signer.
      <% } %>
    </p>
  </div>

  <% if (thisForm.document_path) { %>
  <div class="fw-pdf-shell">
    <div class="fw-pdf-pages" id="formFillPages"></div>
  </div>
  <% } else { %>
  <p>There is no PDF attached to this form. You can still sign below.</p>
  <% } %>

  <div class="ff-panel">
    <form
      id="formFillForm"
      <% if (typeof parent !== "undefined" && parent) { %>
        action="/upload-form-parent/<%= thisForm.id %>/<%= parent %>"
      <% } else { %>
        action="/upload-form/<%= thisForm.id %>"
      <% } %>
      method="POST"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="field_values" id="fieldValues" value="{}">

      <h2 style="margin-top:0;text-align:center;">Save &amp; sign</h2>
      <p style="text-align:center;color:#6b5585;">Confirm who you are. Empty PDF boxes are OK.</p>

      <div style="display:flex;align-items:center;gap:0.6rem;margin:12px 0 18px;">
        <input type="checkbox" name="read" id="read" required style="width:20px;height:20px;">
        <label for="read" style="margin:0;font-size:1.05rem;">I have read this form and agree</label>
      </div>

      <label for="name"><strong>Your full name</strong></label>
      <input type="text" name="name" id="name" required style="width:100%;padding:12px;font-size:1.1rem;margin:6px 0 14px;border:2px solid #d8c8ec;">

      <label for="email"><strong>Your email</strong></label>
      <input type="email" name="email" id="email" required style="width:100%;padding:12px;font-size:1.1rem;margin:6px 0 14px;border:2px solid #d8c8ec;">

      <label for="signature"><strong>Type your signature</strong></label>
      <input type="text" name="signature" id="signature" required placeholder="Type your full name as your signature" style="width:100%;padding:12px;font-size:1.2rem;margin:6px 0 14px;border:2px solid #d8c8ec;font-family:'Segoe Script','Comic Sans MS',cursive;">

      <label for="date"><strong>Today's date</strong></label>
      <input type="date" name="date" id="date" required style="width:100%;padding:12px;font-size:1.1rem;margin:6px 0 18px;border:2px solid #d8c8ec;">

      <div style="text-align:center;">
        <button type="submit" class="button" style="font-size:1.1rem;padding:14px 28px;">Save form</button>
      </div>
    </form>
  </div>
</main>
<footer><%- include("includes/footer") %></footer>
<script>
  (function () {
    var d = document.getElementById("date");
    if (d && !d.value) d.value = new Date().toISOString().slice(0, 10);
  })();
</script>
<script type="module" src="/js/form-wizard.js"></script>
</body>
</html>
