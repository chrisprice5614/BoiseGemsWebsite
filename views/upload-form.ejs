<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
  <div style="padding: 12px;">
    <h1 style="text-align: center;"><%= thisForm.title %></h1>
    <br>
    <p><%= thisForm.description %></p>

    <% if (thisForm.document_path) { %>
      <hr>
      <h2>Form PDF</h2>
      <p>
        Please review the PDF below.
        <% if (typeof hasFillablePdf !== "undefined" && hasFillablePdf) { %>
          This PDF has fillable fields – you can type directly into it using your browser’s PDF viewer.
        <% } %>
      </p>

      <div style="margin: 16px 0;">
        <iframe
          src="<%= thisForm.document_path %>"
          style="width:100%; max-width:900px; height:600px; border:1px solid #ccc; border-radius:6px;"
        ></iframe>
      </div>

      <p style="font-size: 0.9rem; color:#555;">
        <% if (typeof hasFillablePdf !== "undefined" && hasFillablePdf) { %>
          After you fill in all fields, use the PDF viewer’s <strong>Download/Save</strong> button to save a copy to your device,
          then upload that filled-out PDF below.
        <% } else { %>
          Print or download the PDF, fill it out, then upload a scanned or saved copy below.
        <% } %>
      </p>
    <% } %>

    <br>
    <form
      <% if (typeof parent !== "undefined" && parent) { %>
        action="/upload-form-parent/<%= thisForm.id %>/<%= parent %>"
      <% } else { %>
        action="/upload-form/<%= thisForm.id %>"
      <% } %>
      enctype="multipart/form-data"
      method="POST"
    >
      <h2 style="text-align: center;">
        Sign <% if (thisForm.upload) { %>and Upload <% } %>Form
      </h2>

      <br>
      <div style="display: flex; align-items: center; gap: 0.5rem; margin-left: 5%;">
        <input type="checkbox" name="read" id="read" required style="margin: 0;" />
        <label for="read" style="margin: 0;">I Have Read And Agree To The Form</label>
      </div>

      <br>
      <label for="name">Your Name</label>
      <input type="text" name="name" required />

      <br>
      <label for="email">Your Email</label>
      <input type="email" name="email" required />

      <br>
      <label for="signature">Signature</label>
      <input type="text" name="signature" required />

      <br>
      <label for="date">Today's Date</label>
      <input type="date" name="date" required />

      <% if (thisForm.upload) { %>
        <br>
        <label for="document_path">
          Upload Completed PDF (required)
        </label>
        <input type="file" name="document_path" accept="application/pdf" required />
      <% } %>

      <br><br>
      <div style="text-align: center;">
        <button>Sign</button>
      </div>
    </form>
  </div>
</main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>