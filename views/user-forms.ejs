<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boise Gems</title>
    <%- include("includes/head") %>
</head>
<body>
    <header>
        <%- include("includes/header") %>
    </header>
    <main>
        <br>
        <div style="padding: 12px;">
            <h1 style="text-align: center;"><%= thisUser.firstname %> <%= thisUser.lastname %>'s forms</h1>
            <br>
            <% forms.forEach(form => { %>
                <div class="card">
                    <div style="display: grid; grid-template-columns: 1fr 1fr;">
                        <h2><%= form.title %></h2>
                        <div>
                        <span>Submitted: </span>
                        <% const found = userForms.find(item => item.document_id === form.id); %>

                        <% if (found) { %>
                            <!-- When it was signed -->
                            <div style="margin-top: 4px;">
                            ✅ Upload Date:
                            <%= new Date(found.signed_date).toLocaleDateString("en-US", {
                                month: "long",
                                day: "numeric",
                                year: "numeric"
                            }) %>
                            </div>

                            <!-- All submitted metadata -->
                            <div style="margin-top: 8px; font-size: 0.9rem;">
                            <p><b>Signer Name:</b> <%= found.signer_name %></p>
                            <p><b>Signer Email:</b> <%= found.signer_email %></p>
                            <p><b>Electronic Signature:</b> <%= found.signature %></p>
                            <p><b>Consent Checkbox:</b> <%= found.consent ? "✅ Yes" : "❌ No" %></p>
                            <p><b>Device (User Agent):</b> <%= found.user_agent %></p>
                            </div>

                            <!-- PDF link + inline preview -->
                            <% if (found.upload_path) { %>
                            <div style="margin-top: 8px;">
                                <a href="<%= found.upload_path %>" target="_blank">
                                <button>View Uploaded PDF</button>
                                </a>
                            </div>

                            <!-- Inline PDF viewer for the admin -->
                            <div style="margin-top: 8px;">
                                <iframe
                                src="<%= found.upload_path %>"
                                style="width: 100%; max-width: 600px; height: 400px; border: 1px solid #ccc; border-radius: 6px;"
                                ></iframe>
                            </div>
                            <% } %>
                        <% } else { %>
                            ❌
                        <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
    <footer>
        <%- include("includes/footer") %>
    </footer>
</body>
</html>